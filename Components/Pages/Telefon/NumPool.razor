@using Clayzor.Lib.Web.Controls.Components.Presence
@page "/Telefon/NumPool"
@page "/Telefon/NumPool.aspx"
@layout Kesco.App.Web.Inventory.Components.Layout.EntityFormLayout
@using Clayzor.Lib.Entities.Inventory
@using Kesco.App.Web.Inventory.Components.Pages.TerritorialEntity
@inherits TerritorialEntityCardBase<NumPool.FormState>

<PageTitle>@CardTitle</PageTitle>
<NavigationLock ConfirmExternalNavigation="@(Dirty || Busy || ConfirmedCleanupPending)" OnBeforeInternalNavigation="BeforeNavigationAsync" />

<ClayEntityForm Options="FormOptions">
    <Toolbar>
        <ClayToolbar>
            <ClayToolbarButton Options="OkButton" Disabled="@(!CanSave)" OnClick="@(() => SaveAsync(true))" />
            <ClayToolbarButton Options="SaveButton" Disabled="@(!CanSave)" OnClick="@(() => SaveAsync(false))" />
            <ClayToolbarButton Options="ReloadButton" Disabled="@(!CanRefresh)" OnClick="RefreshNumPoolAsync" />
            <ClayToolbarButton Options="CancelButton" Disabled="@Busy" OnClick="CancelAsync" />
            @if (CanDelete)
            {
                <ClayToolbarButton Options="DeleteButton" Disabled="@(!CanCommit || ServerWriteBlocked)" OnClick="DeleteAsync" />
            }
        </ClayToolbar>
    </Toolbar>
    <ChildContent>
        <MudText Typo="Typo.h6" HtmlTag="h1" Class="mb-2">@CardTitle</MudText>
        @if (Loading) { <MudProgressLinear Indeterminate="true" /> }
        @if (Message is not null) { <MudAlert Severity="Severity.Warning" Class="mb-2">@Message</MudAlert> }
        @if (!Loading && _serverWriteNotice is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-2">@_serverWriteNotice</MudAlert>
        }
        @if (Validation.Count > 0)
        {
            <MudAlert Severity="Severity.Error" Class="mb-2"><ul>@foreach (var error in Validation) { <li>@error</li> }</ul></MudAlert>
        }
        @if (Draft is { } draft)
        {
            var header = draft.Data.Header;
            var accepted = Editable ? AcceptedDraftBaseline?.Data : null;
            var baseline = accepted?.Header;
            <div data-draft-scope="main" inert="@DraftInputSuppressed" class="d-flex flex-column gap-3">
                <ClayEditorFocusScope @key="RouteKey" Label="Поля номера ТфОП" Ready="@(Editable && CanCommit && !ServerWriteBlocked)" AdvanceOnEnter="true">
                    <div class="numpool-header d-flex flex-column gap-2">
                        <ClayFieldChange Changed="@(baseline is not null && header.Number != baseline.Number)" RawBaseline="@baseline?.Number">
                            <ClayTextBox Options="_number" Value="@header.Number" ValueChanged="@(value => ChangeHeaderAsync(Draft!.Data.Header with { Number = value ?? "" }))" />
                        </ClayFieldChange>
                        <ClayFieldChange Changed="@(baseline is not null && header.CapacityId != baseline.CapacityId)" WatchLookupRaw="@(baseline is not null)">
                        <ClaySelect TItem="NumPoolOption" TValue="int?" DataSource="_capacities" Options="_capacity"
                                    ValueSelector="@(item => item.Id)" TextSelector="@(item => item.Name)" Value="header.CapacityId"
                                    ValueChanged="@(value => ChangeHeaderAsync(Draft!.Data.Header with { CapacityId = value }))" />
                        </ClayFieldChange>
                        <ClayFieldChange Changed="@(baseline is not null && header.IncomingFor != baseline.IncomingFor)"
                                         RawBaseline="@(baseline is null ? null : baseline.IncomingFor ?? string.Empty)">
                            <ClayTextBox Options="_incomingFor" Value="@header.IncomingFor" ValueChanged="@(value => ChangeHeaderAsync(Draft!.Data.Header with { IncomingFor = value }))" />
                        </ClayFieldChange>
                        <ClayFieldChange Changed="@(baseline is not null && header.IncomingTo != baseline.IncomingTo)"
                                         RawBaseline="@(baseline is null ? null : baseline.IncomingTo ?? string.Empty)">
                            <ClayTextBox Options="_incomingTo" Value="@header.IncomingTo" ValueChanged="@(value => ChangeHeaderAsync(Draft!.Data.Header with { IncomingTo = value }))" />
                        </ClayFieldChange>
                        <ClayFieldChange Changed="@(baseline is not null && header.Control != baseline.Control)">
                            <ClayNumber Options="_control" Value="header.Control" ValueChanged="@(value => ChangeHeaderAsync(Draft!.Data.Header with { Control = value }))" />
                        </ClayFieldChange>
                        <ClayFieldChange Changed="@(baseline is not null && header.Notes != baseline.Notes)"
                                         RawBaseline="@(baseline is null ? null : baseline.Notes ?? string.Empty)">
                            <ClayTextArea Options="_notes" Value="@header.Notes" ValueChanged="@(value => ChangeHeaderAsync(Draft!.Data.Header with { Notes = value }))" />
                        </ClayFieldChange>
                    </div>
                </ClayEditorFocusScope>
                <NumPoolUseSection Kind="NumPoolKind.Connection" Label="Подключения телефонии" Links="draft.Data.Connections" BaselineLinks="accepted?.Connections" Editable="Editable"
                                   Add="@(option => AddLinkAsync(NumPoolKind.Connection, option))" Remove="@(id => RemoveLinkAsync(NumPoolKind.Connection, id))" />
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="4">
                        <NumPoolUseSection Kind="NumPoolKind.Customer" Label="Лица заказчики" Links="draft.Data.Customers" BaselineLinks="accepted?.Customers" Editable="Editable"
                                           Add="@(option => AddLinkAsync(NumPoolKind.Customer, option))" Remove="@(id => RemoveLinkAsync(NumPoolKind.Customer, id))"
                                           GetLink="CustomerUrl" OpenLink="OpenLinkAsync" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <NumPoolUseSection Kind="NumPoolKind.Employee" Label="Сотрудники" Links="draft.Data.Employees" BaselineLinks="accepted?.Employees" Editable="Editable"
                                           Private="draft.EmployeePrivate" PrivateChanged="ChangePrivateAsync"
                                           Add="@(option => AddLinkAsync(NumPoolKind.Employee, option))" Remove="@(id => RemoveLinkAsync(NumPoolKind.Employee, id))"
                                           GetLink="EmployeeUrl" OpenLink="OpenLinkAsync" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <NumPoolUseSection Kind="NumPoolKind.Phone" Label="Телефонные номера" Links="draft.Data.Phones" BaselineLinks="accepted?.Phones" Editable="Editable"
                                           Add="@(option => AddLinkAsync(NumPoolKind.Phone, option))" Remove="@(id => RemoveLinkAsync(NumPoolKind.Phone, id))"
                                           GetLink="PhoneUrl" OpenLink="OpenLinkAsync" />
                    </MudItem>
                </MudGrid>
            </div>
        }
    </ChildContent>
    <Footer>
        @if (GetPresenceTarget() is { } presenceTarget)
        {
            <ClayPresencePanel Target="presenceTarget" />
        }
        @if (_saved?.Header is { } header)
        {
            <ClayChanged ChangedById="header.ChangedBy" ChangedByName="@header.ChangedByName" ChangedAt="header.ChangedAt"
                         ChangedByUrl="@EmployeeUrl(header.ChangedBy)" />
        }
    </Footer>
</ClayEntityForm>
