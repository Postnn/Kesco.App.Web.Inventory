@using Clayzor.Lib.Entities.Inventory
@using Clayzor.Lib.Web.Controls.Components.Form
@using Clayzor.Lib.Web.Controls.Components.Presence
@using Kesco.App.Web.Inventory.Services
@using Kesco.App.Web.Inventory.Components.Layout

<MudDialog>
    <TitleContent>@(IsEdit ? "Параллельный вызов" : "Новый параллельный вызов")</TitleContent>
    <DialogContent>
        @if (PresenceTarget is { } target)
        {
            <ClayPresencePanel Target="target" />
        }
        @{ var baseline = Baseline; }
        <div @key="TelDraft?.InputVersion" class="equipment-ins-fields @TelDraft?.RootClass" data-draft-scope="@TelDraft?.Scope" inert="@(TelDraft?.Busy == true)">
            <div class="equipment-ins-row">
                <span class="equipment-ins-label">Номер:</span>
                <ClayFieldChange Changed="@(baseline is not null && Value.CallNumber != baseline.CallNumber)" RawBaseline="@(baseline is not null ? baseline.CallNumber ?? string.Empty : null)">
                    <ClayTextBox @bind-Value="Value.CallNumber" Options="_numberOptions" />
                </ClayFieldChange>
            </div>
            <div class="equipment-ins-row">
                <span class="equipment-ins-label">Задержка перед вызовом:</span>
                <ClayFieldChange Changed="@(baseline is not null && Value.DelayBeforeCall != baseline.DelayBeforeCall)" RawBaseline="@(baseline is not null ? baseline.DelayBeforeCall.ToString(System.Globalization.CultureInfo.CurrentCulture) : null)">
                    <ClayNumber Value="@((decimal?)Value.DelayBeforeCall)" ValueChanged="OnDelayBeforeChanged" Options="_delayBeforeOptions" />
                </ClayFieldChange>
            </div>
            <div class="equipment-ins-row">
                <span class="equipment-ins-label">Задержка быстрого ответа:</span>
                <ClayFieldChange Changed="@(baseline is not null && Value.DelayTooQuickResponse != baseline.DelayTooQuickResponse)" RawBaseline="@(baseline is not null ? baseline.DelayTooQuickResponse.ToString(System.Globalization.CultureInfo.CurrentCulture) : null)">
                    <ClayNumber Value="@((decimal?)Value.DelayTooQuickResponse)" ValueChanged="OnDelayQuickChanged" Options="_delayQuickOptions" />
                </ClayFieldChange>
            </div>
            <ClayFieldChange Changed="@(baseline is not null && Value.NotUsed != baseline.NotUsed)">
                <ClayCheckbox State="Value.NotUsed" StateChanged="OnNotUsedChanged" Label="Не использовать" />
            </ClayFieldChange>
        </div>
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_errorMessage</MudAlert>
        }
        @if (TelDraft?.Error is { } message)
        {
            <MudAlert Severity="Severity.Error">@message</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <ClayToolbarButton Options="_cancelButton" OnClick="Cancel" Disabled="@(TelDraft?.Busy == true)" />
        <ClayToolbarButton Options="_okButton" OnClick="Apply" Disabled="@(TelDraft?.CanApply == false)" />
        <ClayFormActions Form="InventoryFormHelp.Tel" />
    </DialogActions>
</MudDialog>

@code {
    private readonly ClayTextBoxOptions _numberOptions = new() { DraftKey = "parallel.number", Required = true, RequiredError = "Укажите номер", MaxLength = 50 };
    private readonly ClayNumberOptions _delayBeforeOptions = new() { DraftKey = "parallel.delay-before", Min = 0, Max = 255, Precision = 0, HideSpinButtons = true };
    private readonly ClayNumberOptions _delayQuickOptions = new() { DraftKey = "parallel.delay-quick", Min = 0, Max = 255, Precision = 0, HideSpinButtons = true };
    private readonly ClayToolbarButtonOptions _cancelButton = new() { Text = "Отмена" };
    private readonly ClayToolbarButtonOptions _okButton = new() { Text = "OK", Color = Color.Primary, Variant = Variant.Filled };
    private string? _errorMessage;
    private PhoneParallelCall? Baseline => TelDraft?.Original;

    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;

    /// <summary>Независимый черновик записи.</summary>
    [Parameter] public PhoneParallelCall Value { get; set; } = new();

    /// <summary>Признак редактирования существующей записи.</summary>
    [Parameter] public bool IsEdit { get; set; }

    /// <summary>Номер текущей телефонной записи.</summary>
    [Parameter] public string CurrentNumber { get; set; } = string.Empty;

    /// <summary>Номера других параллельных вызовов.</summary>
    [Parameter] public IReadOnlyCollection<string> OtherNumbers { get; set; } = [];

    /// <summary>Область черновика текущего редактора Tel.</summary>
    [Parameter] public TelRelationDraftSession<PhoneParallelCall>? TelDraft { get; set; }

    /// <summary>Подтверждённая цель присутствия родительского телефонного номера.</summary>
    [Parameter] public ClayPresenceTarget? PresenceTarget { get; set; }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (TelDraft is null)
            return;
        _numberOptions.DraftKey = TelDraft.Scope + ".number";
        _delayBeforeOptions.DraftKey = TelDraft.Scope + ".delay-before";
        _delayQuickOptions.DraftKey = TelDraft.Scope + ".delay-quick";
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (TelDraft is null)
            return;
        var changed = await TelDraft.RenderedAsync(Value.Clone());
        if (firstRender && TelDraft.NeedsRawRestore)
        {
            await TelDraft.RestoreAsync(pendingOnly: true);
            changed = true;
        }
        if (changed)
            StateHasChanged();
    }

    private async Task Cancel()
    {
        if (TelDraft is null || await TelDraft.CancelAsync(Value.Clone, value =>
            {
                Value = value.Clone();
                _errorMessage = null;
            }, StateHasChanged))
            Dialog.Cancel();
    }

    private async Task Apply()
    {
        var errors = PhoneFormValidator.ValidateParallelCall(Value, CurrentNumber, OtherNumbers);
        _errorMessage = string.Join(" ", errors);
        var value = Value.Clone();
        if (errors.Count == 0 && (TelDraft is null || await TelDraft.ApplyAsync(value)))
            Dialog.Close(DialogResult.Ok(value));
    }

    private void OnDelayBeforeChanged(decimal? value) => Value.DelayBeforeCall = (int)Math.Round(value ?? 0, 0, MidpointRounding.ToEven);
    private void OnDelayQuickChanged(decimal? value) => Value.DelayTooQuickResponse = (int)Math.Round(value ?? 0, 0, MidpointRounding.ToEven);
    private void OnNotUsedChanged(bool? value) => Value.NotUsed = value == true;
}
