@using Clayzor.Lib.Web.Controls.Components.Presence
@using System.Globalization
@page "/Telefon/BeelineParams"
@page "/Telefon/BeelineParams.aspx"
@layout Kesco.App.Web.Inventory.Components.Layout.EntityFormLayout
@using Clayzor.Lib.Entities.Inventory
@using Kesco.App.Web.Inventory.Components.Pages.TerritorialEntity
@inherits TerritorialEntityCardBase<BeelineDraft>

<PageTitle>Параметры договора Билайн</PageTitle>
<NavigationLock ConfirmExternalNavigation="@(Dirty || Busy || ConfirmedCleanupPending)" OnBeforeInternalNavigation="BeforeNavigationAsync" />
<ClayEntityForm Options="FormOptions">
    <Toolbar>
        <ClayToolbar>
            <ClayToolbarButton Options="Ok" Disabled="@(Busy || Loading || _openingSim || ConfirmedCleanupPending || _contract is null || Draft is null || Dirty && !CanSave)"
                               OnClick="@(() => SaveAsync(true))" />
            <ClayToolbarButton Options="SaveButton" Disabled="@(!CanSave)" OnClick="@(() => SaveAsync(false))" />
            <ClayToolbarButton Options="ReloadButton" Disabled="@(!(CanRefresh || CanRetryRecovery) || _openingSim || _retryingRecovery || _checkingServerJournal)" OnClick="RefreshBeelineAsync" />
            <ClayToolbarButton Options="CancelButton" Disabled="@(Busy || Loading || _openingSim || _retryingRecovery)" OnClick="CancelBeelineAsync" />
        </ClayToolbar>
    </Toolbar>
    <ChildContent>
        <MudText Typo="Typo.h6" HtmlTag="h1" Class="mb-2">Параметры договора Билайн</MudText>
        @if (Loading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        @if (Message is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-2">@Message</MudAlert>
        }
        @if (!Loading && ServerJournalMessage is { } journalMessage)
        {
            <MudAlert Severity="@(ServerJournalBlocked ? Severity.Warning : Severity.Info)" Class="mb-2">@journalMessage</MudAlert>
        }
        @if (Validation.Count != 0)
        {
            <MudAlert Severity="Severity.Error" Class="mb-2">
                <ul>@foreach (var error in Validation) { <li>@error</li> }</ul>
            </MudAlert>
        }
        @if (GetPresenceTarget() is { } presenceTarget)
        {
            <ClayPresencePanel Target="presenceTarget" />
        }
        @if (_contract is { } contract && Draft is { } draft && !ShowRecovery)
        {
            @if (_zones.Length == 0)
            {
                <MudAlert Severity="Severity.Error" Class="mb-2">Список Time Zone не настроен. Сохранение недоступно.</MudAlert>
            }
            else if (!string.IsNullOrEmpty(draft.TimeZone) && !_zones.Contains(draft.TimeZone, StringComparer.Ordinal))
            {
                <MudAlert Severity="Severity.Warning" Class="mb-2">Сохранённый Time Zone отсутствует в списке. Для записи выберите настроенный вариант.</MudAlert>
            }

            var baseline = AcceptedDraftBaseline;
            <ClayEditorFocusScope @key="RouteKey" Label="Параметры договора Билайн" Ready="@(Editable && CanCommit && !ServerJournalBlocked && !_openingSim)" AdvanceOnEnter="true">
                <div class="d-flex flex-column gap-2" data-draft-scope="main" inert="@(DraftInputSuppressed || _openingSim)">
                    <ClayTextBox Options="BaseNumberOptions" Value="@contract.BaseNumber" />
                    @if (contract.MobileBudget)
                    {
                        <ClayTextBox Options="BudgetNumberOptions" Value="@contract.BudgetNumber" />
                        <div class="d-flex align-items-center flex-wrap gap-2">
                            <MudLink OnClick="OpenSimAsync">Номер телефона МБ:</MudLink>
                            <ClayTextBox Options="BudgetPhoneOptions" Value="@contract.BudgetPhone" />
                        </div>
                        <MudText Typo="Typo.body2">Мобильный бюджет</MudText>
                    }
                    <ClayTextBox Options="CustomerOptions" Value="@contract.Customer" />
                    @if (contract.MobileBudget)
                    {
                        <ClayTextBox Options="UserOptions" Value="@contract.UserName" />
                    }
                    <div class="d-flex align-items-center flex-wrap gap-2">
                        <ClayDatePicker Options="ActualDateOptions" Value="@contract.Actual.Date" />
                        <ClayTextBox Options="ActualTimeOptions" Value="@contract.Actual.ToString("HH:mm:ss", CultureInfo.InvariantCulture)" />
                    </div>
                    <ClayFieldChange Changed="@(Editable && !_zoneOptions.ReadOnly && !_zoneOptions.Disabled && baseline is not null && draft.TimeZone != baseline.TimeZone)">
                        <ClayDropDownList TItem="string" TValue="string" Options="_zoneOptions" Items="@ZoneChoices"
                                          Value="@draft.TimeZone" ValueChanged="ChangeZoneAsync"
                                          ValueSelector="@Identity" TextSelector="@Identity" />
                    </ClayFieldChange>
                    <ClayFieldChange Changed="@(Editable && !_emailOptions.ReadOnly && !_emailOptions.Disabled && baseline is not null && draft.EmailManager != baseline.EmailManager)"
                                     RawBaseline="@(Editable && baseline is not null ? baseline.EmailManager ?? string.Empty : null)">
                        <ClayTextBox Options="_emailOptions" Value="@draft.EmailManager" ValueChanged="ChangeEmailAsync" />
                    </ClayFieldChange>
                </div>
            </ClayEditorFocusScope>
        }
        else if (ShowRecovery)
        {
            <section aria-label="Восстановление параметров договора" class="d-flex flex-column gap-2" data-draft-scope="main">
                @if (_freshReadFailure is { } reason && reason != Message)
                {
                    <MudText Typo="Typo.body2">@reason</MudText>
                }
                <div>Номер договора: @Id</div>
                @if (Draft is { } recovered)
                {
                    <div>Time zone из черновика: @recovered.TimeZone</div>
                    <div>Email менеджера из черновика: @recovered.EmailManager</div>
                }
                <ClayTextBox Options="RecoveryZoneOptions" Value="@Draft?.TimeZone" />
                <ClayTextBox Options="RecoveryEmailOptions" Value="@Draft?.EmailManager" />
                <div>
                </div>
                @if (HasUnknownSubmittedSnapshot)
                {
                    <ClayToolbarButton Options="SubmittedSnapshotButton" Disabled="@Busy" OnClick="ShowSubmittedRecoveryAsync" />
                    @if (_submittedRecovery is { } submitted && _submittedIdentity == SubmittedSnapshotIdentity)
                    {
                        <section aria-label="Снимок незавершённой попытки" data-testid="submitted-attempt">
                            <div>Time zone: @submitted.TimeZone</div><div>Email менеджера: @submitted.EmailManager</div>
                            <MudText>Журнал не подтверждает отправку или выполнение операции.</MudText>
                        </section>
                    }
                    else if (_submittedUnavailable)
                    {
                        <MudText>Не удалось подтвердить доступ к снимку этой попытки.</MudText>
                    }
                }
                @if (_freshRecovery is { } fresh)
                {
                    <div>Актуальные параметры для сверки:</div>
                    <div>Time zone из базы: @fresh.TimeZone</div>
                    <div>Email менеджера из базы: @fresh.EmailManager</div>
                }
            </section>
        }
    </ChildContent>
    <Footer>
        @if (_contract is { } changed)
        {
            <ClayChanged ChangedById="@changed.ChangedBy" ChangedByName="@changed.ChangedByName"
                         ChangedAt="@changed.ChangedAt" ChangedByUrl="@AuthorUrl(changed.ChangedBy)" />
        }
    </Footer>
</ClayEntityForm>
