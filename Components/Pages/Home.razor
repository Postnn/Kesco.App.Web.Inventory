@page "/"
@using Clayzor.Lib.Web.Settings
@using Clayzor.Lib.Web.Controls.Themes
@inject ClayAppSettings AppSettings

<PageTitle>@_pageTitle</PageTitle>

<div class="inventory-home">
    @if (!HideNavigationMenu)
    {
        <header class="inventory-home__navigation">
            <InventoryMainMenu CurrentQueryId="CurrentQueryId">
                <Actions>
                    @if (ThemeState is not null)
                    {
                        <div class="inventory-theme-toggle"><ClayThemeSelector /></div>
                    }
                </Actions>
            </InventoryMainMenu>
        </header>
    }

    @if (CurrentQueryId is not null)
    {
        <section class="inventory-home__grid" aria-label="Рабочая область грида">
            <ClayGrid TEntity="IClayGridRow" Options="_gridOptions" TitleChanged="OnGridTitleChanged" />
        </section>
    }
    else if (HasInvalidQueryId)
    {
        <MudAlert Severity="Severity.Warning">Некорректный код запроса. Выберите пункт меню.</MudAlert>
    }
    else
    {
        <MudPaper Elevation="1" Class="pa-6 inventory-home__empty">
            <MudText Typo="Typo.h5" Class="mb-2">Инвентаризация</MudText>
            <MudText Typo="Typo.body1">Выберите запрос в меню, чтобы открыть список.</MudText>
        </MudPaper>
    }
</div>
