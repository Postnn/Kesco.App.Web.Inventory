@page "/"
@using Clayzor.Lib.Web.Settings
@inject ClayAppSettings AppSettings

<PageTitle>@AppSettings.ApplicationName</PageTitle>

<ClayGrid TEntity="IClayGridRow" Options="_gridOptions" />

@code {
    private readonly ClayGridOptions _gridOptions = new()
    {
        Dynamic        = true,
        Id             = "clay-grid-root",
        ShowPagination = true,
        ColumnMenuMode = ColumnMenuMode.Always,
        SelectVisible  = true,
        ShowPrint      = true,
        ShowExcel      = true,
    };
}
