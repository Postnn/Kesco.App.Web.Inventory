@page "/select-test"
@using Clayzor.Lib.Entities.Inventory
@using Clayzor.Lib.Web.Controls.Components.Select
@using Clayzor.Lib.Web.DBSelect.Equipment
@using Clayzor.Lib.Web.DBSelect.Employees
@using Kesco.App.Web.Inventory.Components.Dialogs

@inject EquipmentTypeSelectDataSource EquipmentTypeSource
@inject EquipmentModelSelectDataSource EquipmentModelSource
@inject EmployeeSelectDataSource EmployeeSource
@inject IDialogService DialogService

<PageTitle>Тест ClaySelect</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Тест ClaySelect</MudText>

<MudForm @ref="_form">
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-3">Статический список</MudText>
                <ClaySelect TItem="StatusItem"
                            TValue="int?"
                            Items="_statuses"
                            ValueSelector="@(item => (int?)item.Id)"
                            TextSelector="@(item => item.Name)"
                            @bind-Value="_statusId"
                            Options="_statusOptions" />
                <MudText Class="mt-3">Выбранный ID: @FormatId(_statusId)</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-3">Тип → модель оборудования</MudText>
                <ClaySelect TItem="EquipmentType"
                            TValue="int?"
                            DataSource="EquipmentTypeSource"
                            ValueSelector="@(item => (int?)item.Id)"
                            TextSelector="@(item => item.Name)"
                            @bind-Value="_equipmentTypeId"
                            SelectedItemChanged="OnEquipmentTypeChanged"
                            Options="_equipmentTypeOptions" />
                <ClaySelect TItem="EquipmentModel"
                            TValue="int?"
                            DataSource="EquipmentModelSource"
                            ValueSelector="@(item => (int?)item.Id)"
                            TextSelector="@(item => item.Name)"
                            @bind-Value="_equipmentModelId"
                            @bind-SelectedItem="_equipmentModel"
                            Options="_equipmentModelOptions" />
                <MudText Class="mt-3">Тип: @FormatId(_equipmentTypeId), модель: @FormatId(_equipmentModelId)</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-3">Сотрудник и расширенный поиск</MudText>
                <ClaySelect TItem="Employee"
                            TValue="int?"
                            DataSource="EmployeeSource"
                            ValueSelector="@(item => (int?)item.Id)"
                            TextSelector="@(item => item.Name)"
                            AdvancedSearch="OpenEmployeeSearchAsync"
                            @bind-Value="_employeeId"
                            @bind-SelectedItem="_employee"
                            Options="_employeeOptions" />
                <MudText Class="mt-3">Сотрудник: @(_employee?.Name ?? "не выбран") (@FormatId(_employeeId))</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudButton Class="mt-4" Variant="Variant.Outlined" Color="Color.Primary" OnClick="ValidateAsync">
        Проверить обязательные поля
    </MudButton>
</MudForm>

@code {
    private MudForm? _form;
    private int? _statusId;
    private int? _equipmentTypeId;
    private int? _equipmentModelId;
    private EquipmentModel? _equipmentModel;
    private int? _employeeId;
    private Employee? _employee;

    private readonly List<StatusItem> _statuses =
    [
        new() { Id = 1, Name = "Активно" },
        new() { Id = 2, Name = "В ремонте" },
        new() { Id = 3, Name = "Списано" },
    ];

    private readonly ClaySelectOptions _statusOptions = new()
    {
        Label = "Состояние",
        Placeholder = "Начните вводить состояние",
    };

    private readonly ClaySelectOptions _equipmentTypeOptions = new()
    {
        Label = "Тип оборудования",
        Placeholder = "Введите название типа",
        Required = true,
        AutoSelectSingle = true,
    };

    private readonly ClaySelectOptions _equipmentModelOptions = new()
    {
        Label = "Модель оборудования",
        Placeholder = "Сначала выберите тип",
        Required = true,
        AutoSelectSingle = true,
    };

    private readonly ClaySelectOptions _employeeOptions = new()
    {
        Label = "Сотрудник",
        Placeholder = "Введите имя сотрудника",
        AlwaysShowAdvancedSearch = true,
    };

    private Task OnEquipmentTypeChanged(EquipmentType? type)
    {
        _equipmentModelId = null;
        _equipmentModel = null;
        EquipmentModelSource.Filter.EquipmentTypeId = type?.Id;
        _equipmentModelOptions.Placeholder = type is null ? "Сначала выберите тип" : "Введите модель";
        return Task.CompletedTask;
    }

    private async Task<ClaySelectExternalResult<Employee, int?>?> OpenEmployeeSearchAsync(
        ClaySelectAdvancedSearchContext context)
    {
        var parameters = new DialogParameters<EmployeeSearchDialog>
        {
            { dialog => dialog.InitialSearch, context.SearchText },
        };
        var options = new DialogOptionsEx
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            DragMode = MudDialogDragMode.Simple,
        };
        var dialog = await DialogService.ShowExAsync<EmployeeSearchDialog>(
            "Поиск сотрудника", parameters, options);
        var result = await dialog.Result;
        return result is null || result.Canceled || result.Data is not Employee employee
            ? null
            : ClaySelectExternalResult<Employee, int?>.FromItem(employee);
    }

    private async Task ValidateAsync()
    {
        if (_form is not null)
            await _form.ValidateAsync();
    }

    private static string FormatId(int? id) => id?.ToString() ?? "—";

    private sealed class StatusItem
    {
        public int Id { get; init; }
        public string Name { get; init; } = string.Empty;
    }
}
