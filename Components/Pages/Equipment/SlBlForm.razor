@using Clayzor.Lib.Entities.Inventory
@using Clayzor.Lib.Web.DBSelect.Equipment

<PageTitle>Список безопасных и заблокированных адресов</PageTitle>
<NavigationLock ConfirmExternalNavigation="@NeedsLeaveConfirmation" OnBeforeInternalNavigation="BeforeNavigationAsync" />

<ClayEntityForm Options="_formOptions">
    <Toolbar>
        <ClayToolbar>
            <ClayToolbarButton Options="SaveButton" Disabled="@(!CanSave)" OnClick="SaveAsync" />
            <ClayToolbarButton Options="RefreshButton" OnClick="RefreshAsync" Disabled="@(_busy || _applyingRaw)" />
            <ClayToolbarButton Options="CloseButton" OnClick="CloseAsync" Disabled="@(_busy || _applyingRaw)" />
        </ClayToolbar>
    </Toolbar>
    <ChildContent>
        <MudText Typo="Typo.h6" HtmlTag="h1" Class="mb-2">Список безопасных и заблокированных адресов</MudText>
        @if (_busy) { <MudProgressLinear Indeterminate="true" /> }
        @if (_error is not null) { <MudAlert Class="mb-2" Severity="Severity.Warning">@_error</MudAlert> }
        @if (_rawPending)
        {
            <MudAlert Class="mb-2" Severity="Severity.Warning" data-testid="slbl-input-readiness">
                @(_rawFailed ? "Не удалось восстановить ввод." : "Часть ввода ожидает восстановления.")
            </MudAlert>
            @if (!_uncertain && !CompletionPending)
            {
                <MudButton OnClick="RetryRawAsync" Disabled="@(!CanRetryRaw)">Повторить восстановление</MudButton>
            }
        }
        @if (_comparison is { } comparison)
        {
            <section aria-label="Сравнение списков" class="d-flex flex-column gap-2 mb-2">
                <MudText Typo="Typo.subtitle2">Исходный список</MudText>
                <pre style="white-space: pre-wrap; overflow-wrap: anywhere">@comparison.Original</pre>
                <MudText Typo="Typo.subtitle2">Мой список</MudText>
                <pre style="white-space: pre-wrap; overflow-wrap: anywhere">@comparison.Local</pre>
                <MudText Typo="Typo.subtitle2">Актуальный список в базе</MudText>
                <pre style="white-space: pre-wrap; overflow-wrap: anywhere">@comparison.Fresh</pre>
                <div class="d-flex flex-wrap gap-2">
                    <MudButton OnClick="@(() => ApplyComparisonAsync(true))" Disabled="@(_busy || _rawPending)">Оставить мой список</MudButton>
                    <MudButton OnClick="@(() => ApplyComparisonAsync(false))" Disabled="@(_busy || _rawPending)">Принять список из базы</MudButton>
                </div>
            </section>
        }
        @if (CurrentUser is not null && _source is not null)
        {
            @if (_kind.HasValue && !_available) { <MudAlert Class="mb-2" Severity="Severity.Info">Для выбранного списка доступна подготовка черновика. Право синхронизации не подтверждено.</MudAlert> }
            <div class="d-flex flex-column gap-2" inert="@(_busy || _uncertain || CompletionPending)" data-draft-scope="main" @ref="_editorScope">
                <ClaySelect TItem="SlBlAddress" TValue="string" DataSource="_source" Options="AddressOptions"
                            ValueSelector="@(x => x.Address)" TextSelector="@(x => x.Address)"
                            Value="@_address" ValueChanged="ChangeAddressAsync" />
                <ClayRadioGroup TValue="SlBlKind?" Items="Kinds" Value="_kind" ValueChanged="ChangeKindAsync" />
                @if (_kind is not null && _address is not null)
                {
                    <MudText Typo="Typo.body2">Могут быть использованы следующие форматы: user@@domain.com, server.domain.com, domain.com</MudText>
                    <ClayTextArea Options="TextOptions" Value="@_text" ValueChanged="ChangeTextAsync" />
                    @if (Dirty && SlBlData.Validate(_text) is { } validation)
                    {
                        <MudAlert Severity="Severity.Error">@validation</MudAlert>
                    }
                    @if (_differences is { } differences)
                    {
                        <MudAlert Severity="Severity.Info">
                            @if (differences.NotDeleted.Length > 0)
                            {
                                <div>Сохраненные записи, которых нет в черновике: @differences.NotDeleted</div>
                            }
                            @if (differences.NotSaved.Length > 0)
                            {
                                <div>Новые записи, которых нет в сохранённом списке: @differences.NotSaved</div>
                            }
                        </MudAlert>
                    }
                }
            </div>
        }
    </ChildContent>
</ClayEntityForm>
