@page "/TypeEquipment/TypeEquipmentMenu"
@page "/TypeEquipment/TypeEquipmentMenu.aspx"
@using Clayzor.Lib.Entities.Inventory

<PageTitle>Типы оборудования</PageTitle>

<InventoryMainMenu CurrentQueryId="@((int)Запросы.Модели_оборудования)" />
<div class="inventory-list-page type-equipment-page">
<MudText Typo="Typo.h5" Class="clay-page-title mt-2 mb-3">Типы оборудования</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
    <MudButton OnClick="LoadTypesAsync" Color="Color.Primary">Повторить загрузку</MudButton>
}
else
{
    <MudGrid Spacing="2" Class="type-equipment-layout">
        <MudItem xs="12" md="6" lg="4" xl="3" Class="type-equipment-types-column" Style="min-width:0">
            <section class="type-equipment-types" aria-label="Типы оборудования">
                <ClayGrid TEntity="EquipmentType" Options="_typesOptions" Items="_types" TotalCount="_types.Length"
                          RowClass="GetTypeRowClass" OnRowActivate="SelectType" OnQueryChanged="OnTypesQueryChangedAsync"
                          DistinctValuesLoader="LoadTypeNamesAsync">
                    <ColumnDefs>
                        <ClayColumnDef ColumnId="1" SqlName="@EquipmentType.IdColumnName" DisplayName="Код" Filterable="true" />
                        <ClayColumnDef ColumnId="2" SqlName="@EquipmentType.MenuNameColumnName" DisplayName="Тип оборудования" Filterable="true" AllowValueFilter="true" />
                    </ColumnDefs>
                    <Columns>
                        <ClayColumn TEntity="EquipmentType" ColumnId="1">
                            <CellTemplate>@context.Item.Id</CellTemplate>
                        </ClayColumn>
                        <ClayColumn TEntity="EquipmentType" ColumnId="2">
                            <CellTemplate>
                                <div @onclick:stopPropagation="true">
                                    <MudButton Variant="Variant.Text" Size="Size.Small" Class="px-1 justify-start"
                                               aria-pressed="@(IsSelected(context.Item) ? "true" : "false")" OnClick="@(() => SelectType(context.Item))">
                                        @context.Item.MenuName
                                    </MudButton>
                                </div>
                            </CellTemplate>
                        </ClayColumn>
                    </Columns>
                </ClayGrid>
            </section>
        </MudItem>
        <MudItem xs="12" md="6" lg="8" xl="9" Class="type-equipment-models-column" Style="min-width:0">
            @if (_selected is { } selected && _modelsOptions is not null)
            {
                <section class="type-equipment-models" aria-labelledby="type-equipment-models-heading">
                    <MudText Typo="Typo.h5" HtmlTag="h2" id="type-equipment-models-heading" Class="clay-page-title mt-2 mb-3">
                        @selected.MenuName
                    </MudText>
                    <ClayGrid @key="selected.Id" TEntity="IClayGridRow" Options="_modelsOptions" />
                </section>
            }
        </MudItem>
    </MudGrid>
}
</div>
