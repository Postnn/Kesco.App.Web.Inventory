@using Clayzor.Lib.Web.Controls.Components.Presence
@page "/Equipment/SIM_FMTN"
@page "/Equipment/SIM_FMTN.aspx"
@layout Kesco.App.Web.Inventory.Components.Layout.EntityFormLayout
@using Clayzor.Lib.Entities.Inventory
@using Kesco.App.Web.Inventory.Components.Pages.TerritorialEntity
@inherits TerritorialEntityCardBase<SimFmtnFields>

<PageTitle>Информация о FMTN</PageTitle>
<NavigationLock ConfirmExternalNavigation="@(Dirty || Busy || ConfirmedCleanupPending)" OnBeforeInternalNavigation="BeforeNavigationAsync" />

<ClayEntityForm Options="@(new ClayEntityFormOptions { Class = DraftRootClass })">
    <Toolbar>
        <ClayToolbar>
            <ClayToolbarButton Options="OkButton" Disabled="@(ChangingIdentity || StorageBlocked || Busy || Loading || Draft is null || (Dirty && !CanCommit))" OnClick="SaveAsync" />
            <ClayToolbarButton Options="ReloadButton" Disabled="@(!CanRefresh)" OnClick="RefreshAsync" />
            <ClayToolbarButton Options="CancelButton" Disabled="@Busy" OnClick="CancelAsync" />
            @if (CanDelete)
            {
                <ClayToolbarButton Options="DeleteButton" Disabled="@(ChangingIdentity || !CanCommit)" OnClick="DeleteAsync" />
            }
        </ClayToolbar>
    </Toolbar>
    <ChildContent>
        <MudText Typo="Typo.h6" HtmlTag="h1" Class="mb-2">Информация о FMTN</MudText>
        @if (Loading) { <MudProgressLinear Indeterminate="true" /> }
        @if (Message is not null) { <MudAlert Severity="Severity.Warning" Class="mb-2">@Message</MudAlert> }
        @if (Validation.Count > 0)
        {
            <MudAlert Severity="Severity.Error" Class="mb-2">
                <ul>@foreach (var error in Validation) { <li>@error</li> }</ul>
            </MudAlert>
        }
        @if (Draft is { } draft)
        {
            var baseline = AcceptedDraftBaseline;
            <ClayEditorFocusScope @key="RouteKey" Label="Поля FMTN" Ready="@(Editable && CanCommit && !ChangingIdentity)" AdvanceOnEnter="true">
                <div class="d-flex flex-column gap-2" data-draft-scope="main" inert="@(DraftInputSuppressed || ChangingIdentity || StorageBlocked)">
                    <ClayFieldChange Changed="@(Editable && !_prefix.ReadOnly && !_prefix.Disabled && baseline is not null && draft.Prefix != baseline.Prefix)"
                                     RawBaseline="@(Editable && baseline is not null ? baseline.Prefix ?? string.Empty : null)">
                        <ClayTextBox Options="_prefix" Value="@draft.Prefix" ValueChanged="@(value => UpdateDraftAsync(Draft! with { Prefix = value ?? "" }))" />
                    </ClayFieldChange>
                    <ClayFieldChange Changed="@(Editable && !_shortNumber.ReadOnly && !_shortNumber.Disabled && baseline is not null && draft.ShortNumber != baseline.ShortNumber)"
                                     RawBaseline="@(Editable && baseline is not null ? baseline.ShortNumber ?? string.Empty : null)">
                        <ClayTextBox Options="_shortNumber" Value="@draft.ShortNumber" ValueChanged="@(value => UpdateDraftAsync(Draft! with { ShortNumber = value ?? "" }))" />
                    </ClayFieldChange>
                    <ClayFieldChange Changed="@(Editable && !_description.ReadOnly && !_description.Disabled && baseline is not null && draft.Description != baseline.Description)"
                                     RawBaseline="@(Editable && baseline is not null ? baseline.Description ?? string.Empty : null)">
                        <ClayTextBox Options="_description" Value="@draft.Description" ValueChanged="@(value => UpdateDraftAsync(Draft! with { Description = value ?? "" }))" />
                    </ClayFieldChange>
                </div>
            </ClayEditorFocusScope>
        }
    </ChildContent>
    <Footer>
        @if (GetPresenceTarget() is { } presenceTarget)
        {
            <ClayPresencePanel Target="presenceTarget" />
        }
        @if (_original is { } original)
        {
            <ClayChanged ChangedById="@original.ChangedBy" ChangedByName="@original.ChangedByName" ChangedAt="@original.ChangedAt" />
        }
    </Footer>
</ClayEntityForm>
