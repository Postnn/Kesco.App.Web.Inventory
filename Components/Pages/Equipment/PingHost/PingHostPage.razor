@page "/Equipment/PingHost"
@page "/Equipment/PingHost.aspx"
@layout Kesco.App.Web.Inventory.Components.Layout.EntityFormLayout

<PageTitle>Проверка доступности устройства в сети</PageTitle>

<ClayEntityForm Options="_formOptions">
    <Toolbar>
        <ClayToolbar>
            <ClayToolbarButton Options="StartButton" Disabled="@(!CanStart)" OnClick="StartAsync" />
            <ClayToolbarButton Options="StopButton" Disabled="@(_run is null || _stopping)" OnClick="StopAsync" />
            <ClayToolbarButton Options="CloseButton" Disabled="@(_closing || _initializing)" OnClick="CloseAsync" />
        </ClayToolbar>
    </Toolbar>
    <ChildContent>
        <MudText Typo="Typo.h6" HtmlTag="h1" Class="mb-2">@_heading</MudText>
        @if (_status is not null)
        {
            <MudText Typo="Typo.body2" Color="@(_hasError ? Color.Error : Color.Default)">@_status</MudText>
        }
        @if (_journalSaveFailed)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-2">
                Не удалось сохранить журнал. Текущие результаты видны в этом окне.
            </MudAlert>
        }
        <div @ref="_journal" role="log" aria-label="Результаты проверки" aria-live="polite" tabindex="0" class="overflow-auto">
            @foreach (var line in _lines)
            {
                <MudText Typo="Typo.body2" Color="@(line.Success ? Color.Default : Color.Error)">@line.Text</MudText>
            }
        </div>
    </ChildContent>
</ClayEntityForm>

