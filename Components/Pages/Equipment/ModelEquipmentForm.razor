@page "/Equipment/ModelEquipmentForm"
@layout Kesco.App.Web.Inventory.Components.Layout.EntityFormLayout
@using Clayzor.Lib.Entities.Inventory
@using Clayzor.Lib.Web.Controls.Components.Select
@using Clayzor.Lib.Web.DBSelect.Equipment
@using Clayzor.Lib.Web.Controls.Services
@implements IDisposable
@inject Clayzor.Lib.DALC.DbManager Db
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider Authentication
@inject EquipmentTypeSelectDataSource EquipmentTypeSource
@inject ResourceSelectDataSource ResourceSource
@inject MemoryTypeSelectDataSource MemoryTypeSource
@inject ClaySelectAdvancedSearchService AdvancedSearchService
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject IJSRuntime JS

<PageTitle>@Title</PageTitle>
<NavigationLock ConfirmExternalNavigation="@ConfirmModelExternalExit" OnBeforeInternalNavigation="BeforeInternalNavigationAsync" />

<ClayEntityForm Options="_entityFormOptions">
    <Toolbar>
        <ClayToolbar>
            <ClayToolbarButton Options="_okOptions" Disabled="@(_loading || _saving || !_loaded || !_canEdit || WriteBlocked)" OnClick="@(() => SaveAsync(true))" />
            <ClayToolbarButton Options="_applyOptions" Disabled="@(!CanSave)" OnClick="@(() => SaveAsync(false))" />
            <ClayToolbarButton Options="_refreshOptions" Disabled="@(_loading || _saving)" OnClick="RefreshAsync" />
            <ClayToolbarButton Options="_cancelOptions" Disabled="@(_saving || _loading || _journalBusy)" OnClick="CancelAsync" />
        </ClayToolbar>
    </Toolbar>
    <ChildContent>

    @if (!string.IsNullOrWhiteSpace(_validationMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">@_validationMessage</MudAlert>
    }
    @if (_journalNotice is not null)
    {
        <section aria-label="Журнал сохранения модели" data-testid="model-save-journal">
            <MudAlert Severity="Severity.Warning">@_journalNotice</MudAlert>
        </section>
    }
    @if (_inputNotice is not null)
    {
        <section aria-label="Состояние ввода модели" data-testid="model-editor-draft">
            <MudAlert Severity="Severity.Warning">@_inputNotice</MudAlert>
        </section>
    }
    <div @key="_loadVersion" class="@ReadOnlyRecoveryClass(_loadVersion)">
    @if (_localRecovery is { } localRecovery && IsReadOnlyRecoveryCurrent(localRecovery))
    {
        <section data-draft-scope="@EditorScope"
                 aria-label="Локальный черновик модели" data-testid="model-readonly-recovery">
            <MudAlert Severity="Severity.Warning">
                Локальный черновик модели. Поля можно скопировать. Запись недоступна.
                @if (localRecovery.HasOperation)
                {
                    <p>В журнале есть незавершённая попытка сохранения. Её состояние сохранено.</p>
                }
                @if (localRecovery.RawPending)
                {
                    <p>Часть исходного ввода осталась в защищённом черновике.</p>
                }
            </MudAlert>
            @if (localRecovery.Fields is { } typed)
            {
                <p>Мультимедиа: @(typed.IsMultimedia ? "да" : "нет")</p>
            }
            @foreach (var field in ReadOnlyRecoveryFields(localRecovery.Fields))
            {
                <label class="d-block">
                    <span>@field.Label</span>
                    <textarea class="d-block" readonly rows="@field.Rows" data-draft-key="@field.Key">@field.Value</textarea>
                </label>
            }
        </section>
    }
    </div>
    @if (_notFound)
    {
        <MudAlert Severity="Severity.Warning">Модель оборудования с указанным идентификатором не найдена.</MudAlert>
    }
    else if (_model is not null)
    {
        if (!_canEdit)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3">
                Для изменения модели требуется роль «Специалист по инвентаризации оборудования» (43).
            </MudAlert>
        }

        <MudForm @key="_editorRenderVersion" @ref="_form">
            <div class="model-equipment-fields" data-draft-scope="@EditorScope" inert="@(_loading || _journalBusy || _restoringRaw)">
                <ClayEditorFocusScope Label="Поля модели оборудования" Ready="@ModelFocusReady" AdvanceOnEnter="true">
                <div class="model-equipment-fields">
                <div class="model-equipment-row">
                    <span class="model-equipment-label">Тип оборудования:</span>
                    <div>
                        <ClaySelect TItem="EquipmentType" TValue="int?"
                                    DataSource="EquipmentTypeSource"
                                    ValueSelector="@(item => (int?)item.Id)"
                                    TextSelector="@(item => item.Name)"
                                    Value="_equipmentTypeId"
                                    ValueChanged="OnEquipmentTypeIdChanged"
                                    SelectedItem="_selectedType"
                                    SelectedItemChanged="OnEquipmentTypeChanged"
                                    Options="_typeOptions" />
                        <ClayCheckbox State="_sortTypesByName" StateChanged="OnTypeSortChanged"
                                      Label="сортировать типы в списке по алфавиту" />
                    </div>
                </div>

                <div class="model-equipment-row">
                    <span class="model-equipment-label">Модель:</span>
                    <ClayTextBox @bind-Value="_model.Name" Options="_modelNameOptions" />
                </div>

                <div class="model-equipment-row">
                    <span class="model-equipment-label">Ресурс:</span>
                    <ClaySelect TItem="ResourceLookup" TValue="int?"
                                DataSource="ResourceSource"
                                ValueSelector="@(item => (int?)item.Id)"
                                TextSelector="@(item => item.Name)"
                                @bind-Value="_model.ResourceId"
                                AdvancedSearch="ResourceAdvancedSearch"
                                CreateItem="ResourceCreateItem"
                                ViewItem="ResourceViewItem"
                                Options="_resourceOptions" />
                </div>

                <div class="model-equipment-row">
                    <span class="model-equipment-label">PN:</span>
                    <ClayTextBox @bind-Value="_model.PartNumber" Options="_partNumberOptions" />
                </div>

                @if (ShowMonitor)
                {
                    <div class="model-equipment-row">
                        <span class="model-equipment-label">Размер монитора:</span>
                        <ClayNumber Value="MonitorSize" ValueChanged="OnMonitorSizeChanged" Options="_monitorSizeOptions" />
                    </div>
                }

                @if (ShowMultimedia)
                {
                    <div class="model-equipment-row">
                        <span class="model-equipment-label">Мультимедиа:</span>
                        <ClayCheckbox State="_model.IsMultimedia" StateChanged="OnMultimediaChanged" ReadOnly="@(!_canEdit)" />
                    </div>
                }

                @if (ShowComputer)
                {
                    <div class="model-equipment-row">
                        <span class="model-equipment-label">CPU:</span>
                        <ClayTextBox @bind-Value="_model.Cpu" Options="_cpuOptions" />
                    </div>
                }

                @if (ShowNetwork)
                {
                    <div class="model-equipment-row">
                        <span class="model-equipment-label">Net:</span>
                        <div class="model-equipment-inline">
                            <ClayDropDownList TItem="NetworkOption" TValue="int"
                                              Items="_networkOptions"
                                              ValueSelector="@(item => item.Id)"
                                              TextSelector="@(item => item.Name)"
                                              Value="_model.NetworkInterfaces"
                                              ValueChanged="OnNetworkInterfacesChanged"
                                              Options="_networkSelectOptions" />
                            <ClayTextBox Value="@_model.NetworkName" ValueChanged="OnNetworkNameChanged" Options="_networkNameOptions" />
                        </div>
                    </div>
                }

                @if (ShowComputer)
                {
                    <div class="model-equipment-row">
                        <span class="model-equipment-label">Тип памяти:</span>
                        <div class="model-equipment-inline">
                            <ClayDropDownList TItem="MemoryType" TValue="int"
                                              Items="_memoryTypes"
                                              ValueSelector="@(item => item.Id)"
                                              TextSelector="@(item => item.Name)"
                                              @bind-Value="_model.MemoryTypeId"
                                              Options="_memoryTypeOptions" />
                            <span class="model-equipment-inline-label">Банки памяти:</span>
                            <ClayNumber Value="@((decimal?)_model.MemoryBanks)" ValueChanged="OnMemoryBanksChanged" Options="_memoryBanksOptions" />
                        </div>
                    </div>
                }

                <div class="model-equipment-row model-equipment-row-top">
                    <span class="model-equipment-label">Драйвер:</span>
                    <ClayTextArea @bind-Value="_model.Driver" Options="_driverOptions" />
                </div>

                <div class="model-equipment-row">
                    <span class="model-equipment-label">Срок службы:</span>
                    <ClayTextBox @bind-Value="_model.LifeTime" Options="_lifeTimeOptions" />
                </div>

                <div class="model-equipment-row model-equipment-row-top">
                    <span class="model-equipment-label">Примечания:</span>
                    <ClayTextArea @bind-Value="_model.Description" Options="_descriptionOptions" />
                </div>
                </div>
                </ClayEditorFocusScope>

                @if (ShowPhoneTemplate)
                {
                    <div class="model-equipment-row">
                        <span class="model-equipment-label">Шаблон телефона:</span>
                        <ClayToolbarButton Options="_phoneTemplateOptions" OnClick="OpenPhoneTemplateAsync" />
                    </div>
                }

                @if (_model.Id > 0 && _usage.Total > 0)
                {
                    <MudText Typo="Typo.body2" Class="mt-3">
                        В базе данных сохранено
                        <MudLink Href="@EquipmentUsageUrl(_model.Id)" Target="_blank" rel="noopener"
                                 aria-label="Открыть список оборудования данной модели">@_usage.Total</MudLink>
                        единиц оборудования данной модели@(UsageSuffix)
                    </MudText>
                }
            </div>
        </MudForm>
    }

    </ChildContent>
    <Footer>
        <ClayChanged ChangedById="_model?.ChangedById"
                     ChangedByName="@_model?.ChangedByName"
                     ChangedAt="_model?.ChangedAt"
                     ChangedByUrl="@ChangedByUrl" />
    </Footer>
</ClayEntityForm>

<MudOverlay Visible="@(_loading || _saving)" DarkBackground="true">
    <div class="clay-busy">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        <span>@(_saving ? "Сохранение модели…" : "Загрузка модели…")</span>
    </div>
</MudOverlay>
