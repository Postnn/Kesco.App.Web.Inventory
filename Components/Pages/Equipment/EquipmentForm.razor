@page "/Equipment/EquipmentForm"
@layout Kesco.App.Web.Inventory.Components.Layout.EntityFormLayout
@using Clayzor.Lib.Entities.Inventory
@using Clayzor.Lib.Web.Controls.Components.Select
@using Clayzor.Lib.Web.Controls.Components.Detail
@using Clayzor.Lib.Web.DBSelect.Documents
@using Clayzor.Lib.Web.DBSelect.Equipment
@using Clayzor.Lib.Web.DBSelect.Persons
@using Kesco.App.Web.Inventory.Components.Pages.Equipment.Details
@using Kesco.App.Web.Inventory.Services
@implements IDisposable
@inject EquipmentFormService Service
@inject EquipmentTypeSelectDataSource EquipmentTypeSource
@inject EquipmentModelSelectDataSource ModelSource
@inject PhonePoolSelectDataSource PhonePoolSource
@inject PhoneNumberSelectDataSource PhoneNumberSource
@inject PersonSelectDataSource PersonSource
@inject IServiceProvider Services
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject IJSRuntime JS

<PageTitle>@Title</PageTitle>
<NavigationLock ConfirmExternalNavigation="@IsModified" OnBeforeInternalNavigation="BeforeInternalNavigationAsync" />

<ClayEntityForm Options="_entityFormOptions">
    <Toolbar>
        <ClayToolbar>
            <ClayToolbarButton Options="_okOptions" Disabled="@(_loading || _saving || !_loaded || !_canEdit)" OnClick="@(() => SaveAsync(true))" />
            <ClayToolbarButton Options="_applyOptions" Disabled="@(!CanSave)" OnClick="@(() => SaveAsync(false))" />
            <ClayToolbarButton Options="_copyOptions" Disabled="@(_loading || _saving || !_loaded)" OnClick="CopyAsync" />
            <ClayToolbarButton Options="_refreshOptions" Disabled="@(_loading || _saving || !_loaded)" OnClick="RefreshAsync" />
            <ClayToolbarButton Options="_cancelOptions" Disabled="@_saving" OnClick="CancelAsync" />
            @if (_networkAttachmentCount == 0)
            {
                <ClayToolbarButton Options="_attachOptions" Disabled="@(_loading || _saving || !_loaded || !_canEdit)" OnClick="@(() => SetNetworkAttachmentAsync(true))" />
            }
            else
            {
                <ClayToolbarButton Options="_detachOptions" Disabled="@(_loading || _saving || !_loaded || !_canEdit)" OnClick="@(() => SetNetworkAttachmentAsync(false))" />
            }
            @if (ShowPhoneConfig)
            {
                <ClayToolbarButton Options="_phoneConfigOptions" Disabled="@(_loading || _saving || !_loaded || !_canViewPhoneConfig)" OnClick="OpenPhoneConfigAsync" />
            }
            @if (ShowNetworkName)
            {
                <ClayToolbarButton Options="_networkHistoryOptions" Disabled="@(_loading || _saving || !_loaded)" OnClick="OpenNetworkNameHistoryAsync" />
            }
        </ClayToolbar>
    </Toolbar>
    <ChildContent>
        @if (_notFound)
        {
            <MudAlert Severity="Severity.Warning">Оборудование с указанным идентификатором не найдено.</MudAlert>
        }
        else if (_model is not null)
        {
            if (!_canEdit)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-3">
                    Для изменения оборудования требуется роль «Специалист по инвентаризации оборудования» (43).
                </MudAlert>
            }
            if (!string.IsNullOrWhiteSpace(_validationMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">@_validationMessage</MudAlert>
            }

            <MudForm @ref="_form">
                <div class="equipment-form-fields">
                    <div class="equipment-form-pair equipment-form-writeoff-row">
                        <span class="equipment-form-label">SN:</span>
                        <ClayTextBox @bind-Value="_model.SerialNumber" Options="_snOptions" />
                        <span class="equipment-form-label">Списано:</span>
                        <div class="equipment-form-writeoff">
                            <div class="equipment-form-writeoff-date">
                                <ClayDatePicker @bind-Value="_writeOffDate" Options="_writeOffDateOptions" />
                            </div>
                            <ClayTime @bind-Value="_writeOffTime" Options="_writeOffTimeOptions" />
                            <span class="equipment-form-label">№</span>
                            <div class="equipment-form-writeoff-document">
                                <ClaySelect TItem="DocumentLookup" TValue="int?"
                                            DataSource="WriteOffDocumentSource"
                                            ValueSelector="@(item => (int?)item.Id)"
                                            TextSelector="@(item => item.DisplayName)"
                                            @bind-Value="_model.DocumentWriteOffId"
                                            Options="_writeOffDocumentOptions" />
                            </div>
                        </div>
                    </div>
                    <div class="equipment-form-pair">
                        <span class="equipment-form-label">Тип:</span>
                        <div>
                            <ClaySelect TItem="EquipmentType" TValue="int?"
                                        DataSource="EquipmentTypeSource"
                                        ValueSelector="@(item => (int?)item.Id)"
                                        TextSelector="@(item => item.Name)"
                                        Value="_model.EquipmentTypeId"
                                        ValueChanged="OnTypeIdChanged"
                                        SelectedItem="_selectedType"
                                        SelectedItemChanged="OnTypeChanged"
                                        Options="_typeOptions" />
                            <ClayCheckbox State="_sortTypesByName" StateChanged="OnTypeSortChanged"
                                          Label="сортировать типы в списке по алфавиту" />
                        </div>
                        <span class="equipment-form-label">Модель:</span>
                        <div>
                            <ClaySelect TItem="EquipmentModel" TValue="int?"
                                        DataSource="ModelSource"
                                        ValueSelector="@(item => (int?)item.Id)"
                                        TextSelector="@(item => item.Name)"
                                        Value="_model.ModelId"
                                        ValueChanged="OnModelIdChanged"
                                        SelectedItem="_selectedModel"
                                        SelectedItemChanged="OnModelChangedAsync"
                                        ViewItem="ModelViewItem"
                                        Options="_modelOptions" />
                            @if (_selectedModel is not null && _model.ModelId is not null)
                            {
                                if (!string.IsNullOrWhiteSpace(_selectedModel.PartNumber))
                                {
                                    <div class="equipment-form-model-meta">PN: @_selectedModel.PartNumber</div>
                                }
                                if (_selectedModel.IsMultimedia)
                                {
                                    <div class="equipment-form-model-meta">Мультимедиа</div>
                                }
                                if (_selectedModel.MonitorSize > 0)
                                {
                                    <div class="equipment-form-model-meta">Диагональ: @_selectedModel.MonitorSize.ToString("0.0")</div>
                                }
                                if (!string.IsNullOrWhiteSpace(_selectedModel.Cpu))
                                {
                                    <div class="equipment-form-model-meta">CPU: @_selectedModel.Cpu</div>
                                }
                                if (_selectedModel.NetworkInterfaces > 0)
                                {
                                    <div class="equipment-form-model-meta">Net: @_selectedModel.NetworkInterfaces @_selectedModel.NetworkName</div>
                                }
                                if (_selectedModel.MemoryTypeId > 0 && !string.IsNullOrWhiteSpace(_selectedModel.MemoryTypeName))
                                {
                                    <div class="equipment-form-model-meta">
                                        Тип памяти: @_selectedModel.MemoryTypeName
                                        @if (_selectedModel.MemoryBanks > 0)
                                        {
                                            <text>; кол-во банков: @_selectedModel.MemoryBanks</text>
                                        }
                                    </div>
                                }
                                if (!string.IsNullOrWhiteSpace(_selectedModel.Driver))
                                {
                                    <div class="equipment-form-model-meta">Драйвер: @_selectedModel.Driver</div>
                                }
                                if (!string.IsNullOrWhiteSpace(_selectedModel.LifeTime))
                                {
                                    <div class="equipment-form-model-meta">Ресурс: @_selectedModel.LifeTime</div>
                                }
                                if (!string.IsNullOrWhiteSpace(_selectedModel.Description))
                                {
                                    <div class="equipment-form-model-meta">@_selectedModel.Description</div>
                                }
                            }
                        </div>
                    </div>
                    @if (ShowNetworkName || MacCount > 0)
                    {
                        <div class="equipment-form-pair">
                            <span class="equipment-form-label">@(ShowNetworkName ? "Сетевое имя:" : string.Empty)</span>
                            <div>
                                @if (ShowNetworkName)
                                {
                                    <ClayTextBox @bind-Value="_model.NetworkName" Options="_networkNameOptions" />
                                }
                            </div>
                            <span class="equipment-form-label">@(MacCount > 0 ? "MAC:" : string.Empty)</span>
                            <div class="equipment-form-mac">
                                @if (MacCount > 0)
                                {
                                    <ClayTextBox Value="@_model.MacAddress" ValueChanged="@(value => OnMacChanged(value, 1))" Options="_macOptions" />
                                    @if (MacCount > 1)
                                    {
                                        <span class="equipment-form-label">MAC 2:</span>
                                        <ClayTextBox Value="@_model.MacAddress2" ValueChanged="@(value => OnMacChanged(value, 2))" Options="_macOptions" />
                                    }
                                    @if (MacCount > 2)
                                    {
                                        <span class="equipment-form-label">MAC ILO:</span>
                                        <ClayTextBox Value="@_model.MacAddressIlo" ValueChanged="@(value => OnMacChanged(value, 3))" Options="_macOptions" />
                                    }
                                }
                            </div>
                        </div>
                    }
                    <div class="equipment-form-single equipment-form-top">
                        <span class="equipment-form-label">Примечания:</span>
                        <ClayTextArea @bind-Value="_model.Description" Options="_descriptionOptions" />
                    </div>
                    @if (ShowPhonePool)
                    {
                        <div class="equipment-form-single">
                            <span class="equipment-form-label">Пул телефона:</span>
                            <ClaySelect TItem="PhonePoolLookup" TValue="int?"
                                        DataSource="PhonePoolSource"
                                        ValueSelector="@(item => (int?)item.Id)"
                                        TextSelector="@(item => item.Name)"
                                        @bind-Value="_model.PhonePoolId"
                                        Options="_phonePoolOptions" />
                        </div>
                    }
                    @if (ShowCamera)
                    {
                        <div class="equipment-form-single">
                            <span class="equipment-form-label">Камера:</span>
                            <ClayCheckbox State="@(_model.CameraIsConnected != 0)" StateChanged="OnCameraChanged"
                                          ReadOnly="@(!_canEdit)" Label="подключена камера" />
                        </div>
                    }
                    <div class="equipment-form-pair">
                        <span class="equipment-form-label">Владелец:</span>
                        <ClaySelect TItem="PersonLookup" TValue="int?"
                                    DataSource="PersonSource"
                                    ValueSelector="@(item => (int?)item.Id)"
                                    TextSelector="@(item => item.Name)"
                                    Value="_model.OwnerId"
                                    ValueChanged="OnOwnerChangedAsync"
                                    Options="_ownerOptions" />
                        <span class="equipment-form-label">Арендатор:</span>
                        <ClaySelect TItem="PersonLookup" TValue="int?"
                                    DataSource="PersonSource"
                                    ValueSelector="@(item => (int?)item.Id)"
                                    TextSelector="@(item => item.Name)"
                                    @bind-Value="_model.TenantId"
                                    Options="_tenantOptions" />
                    </div>
                    <div class="equipment-form-pair">
                        <span class="equipment-form-label">Документ поступления:</span>
                        <ClaySelect TItem="DocumentLookup" TValue="int?"
                                    DataSource="ReceiptDocumentSource"
                                    ValueSelector="@(item => (int?)item.Id)"
                                    TextSelector="@(item => item.DisplayName)"
                                    Value="_model.DocumentReceiptOuId"
                                    ValueChanged="OnReceiptDocumentChangedAsync"
                                    Options="_receiptDocumentOptions" />
                        <span class="equipment-form-label">Поставщик:</span>
                        <ClaySelect TItem="PersonLookup" TValue="int?"
                                    DataSource="PersonSource"
                                    ValueSelector="@(item => (int?)item.Id)"
                                    TextSelector="@(item => item.Name)"
                                    Value="_model.ShipperId"
                                    ValueChanged="OnShipperChanged"
                                    Options="_shipperOptions" />
                    </div>
                </div>
            </MudForm>
            @if (!string.IsNullOrWhiteSpace(_warningMessage))
            {
                <MudAlert Severity="Severity.Warning" Class="mt-3">@_warningMessage</MudAlert>
            }
            @if (ShowPhones)
            {
                <div class="equipment-ins-row">
                    <span class="equipment-ins-label">Новый номер:</span>
                    <ClaySelect TItem="PhoneNumberLookup" TValue="int?"
                                DataSource="PhoneNumberSource"
                                ValueSelector="@(item => (int?)item.Id)"
                                TextSelector="@(item => item.Name)"
                                @bind-Value="_phoneToAdd"
                                Options="_phoneOptions" />
                </div>
                <ClayDetailGrid TItem="EquipmentPhoneLink"
                                Title="Телефонные номера"
                                Items="_phones"
                                Columns="_phoneColumns"
                                Options="_phoneGridOptions"
                                OnAdd="AddPhoneAsync"
                                AddDisabled="@(_phoneToAdd is null || _saving)"
                                ReadOnly="@(!_canEdit)">
                    <Actions Context="item">
                        <ClayButton Icon="@Icons.Material.Filled.Schedule" Text="Изменить срок возврата"
                                    Disabled="@(!_canEdit || _saving)" OnClick="@(() => EditPhoneReturnAsync(item))" />
                        <ClayButton Icon="@Icons.Material.Filled.Delete" Text="Удалить связь с номером"
                                    Disabled="@(!_canEdit || _saving)" OnClick="@(() => RemovePhoneAsync(item))" />
                    </Actions>
                </ClayDetailGrid>
            }
            <ClayDetailGrid TItem="EquipmentLocationPeriod"
                            Title="Расположения"
                            Items="_locations"
                            Columns="_locationColumns"
                            Options="_locationGridOptions"
                            OnAdd="@(() => OpenLocationDialogAsync(null))"
                            AddDisabled="@(!_canEdit || _saving)"
                            ReadOnly="@(!_canEdit)">
                <Actions Context="item">
                    <ClayButton Icon="@Icons.Material.Filled.Edit" Text="Изменить срок возврата и примечания"
                                Disabled="@(!_canEdit || _saving)" OnClick="@(() => OpenLocationDialogAsync(item))" />
                </Actions>
            </ClayDetailGrid>
            <ClayDetailGrid TItem="EquipmentResponsiblePeriod"
                            Title="Ответственные"
                            Items="_responsibles"
                            Columns="_responsibleColumns"
                            Options="_responsibleGridOptions"
                            OnAdd="@(() => OpenResponsibleDialogAsync(EquipmentResponsibleDialogMode.Issue, null))"
                            AddDisabled="@(!_canEdit || _saving)"
                            ReadOnly="@(!_canEdit)">
                <Actions Context="item">
                    <ClayButton Icon="@Icons.Material.Filled.Edit" Text="Изменить срок возврата и примечания"
                                Disabled="@(!_canEdit || _saving)" OnClick="@(() => OpenResponsibleDialogAsync(EquipmentResponsibleDialogMode.Edit, item))" />
                    @if (item.ToUtc is null)
                    {
                        <ClayButton Icon="@Icons.Material.Filled.PersonRemove" Text="Изыять оборудование"
                                    Disabled="@(!_canEdit || _saving)" OnClick="@(() => OpenResponsibleDialogAsync(EquipmentResponsibleDialogMode.Withdraw, item))" />
                    }
                </Actions>
            </ClayDetailGrid>
            <ClayDetailGrid TItem="EquipmentAccount"
                            Title="Учётные записи"
                            Items="_accounts"
                            Columns="_accountColumns"
                            Options="_accountGridOptions"
                            OnAdd="@(() => OpenAccountDialogAsync(null))"
                            AddDisabled="@(!_canEdit || _saving)"
                            ReadOnly="@(!_canEdit)">
                <Actions Context="item">
                    <ClayButton Icon="@Icons.Material.Filled.Edit" Text="Изменить учётную запись"
                                Disabled="@(!_canEdit || _saving)" OnClick="@(() => OpenAccountDialogAsync(item))" />
                    <ClayButton Icon="@Icons.Material.Filled.Delete" Text="Удалить учётную запись"
                                Disabled="@(!_canEdit || _saving)" OnClick="@(() => DeleteAccountAsync(item))" />
                </Actions>
            </ClayDetailGrid>
            @if (ShowComputer)
            {
                <ClayDetailGrid TItem="EquipmentComputerSnapshot"
                                Title="Компьютер"
                                Items="_computerHistory"
                                Columns="_computerColumns"
                                Options="_computerGridOptions"
                                OnAdd="OpenComputerDialogAsync"
                                AddDisabled="@(!_canEdit || _saving)"
                                ReadOnly="@(!_canEdit)" />
            }
            @if (ShowSim)
            {
                <ClayDetailGrid TItem="EquipmentSimCard"
                                Title="SIM-карта"
                                Items="_simCards"
                                Columns="_simColumns"
                                Options="_simGridOptions"
                                OnAdd="OpenSimDialogAsync"
                                AddDisabled="@(!_canEditSim || _saving)"
                                ReadOnly="@(!_canEditSim)">
                    <Actions Context="item">
                        <ClayButton Icon="@Icons.Material.Filled.Edit" Text="Изменить сведения SIM"
                                    Disabled="@(!_canEditSim || _saving)" OnClick="OpenSimDialogAsync" />
                        <ClayButton Icon="@Icons.Material.Filled.Delete" Text="Удалить сведения SIM"
                                    Disabled="@(!_canEditSim || _saving)" OnClick="DeleteSimAsync" />
                    </Actions>
                </ClayDetailGrid>
                <div class="d-flex gap-4">
                    <ClayCheckbox State="_showServiceHistory" StateChanged="value => _showServiceHistory = value == true" Label="Показать историю" OnToggle="OnSimServiceFiltersChangedAsync" />
                    <ClayCheckbox State="_showCompanyRequiredServices" StateChanged="value => _showCompanyRequiredServices = value == true" Label="Показать обязательные услуги" OnToggle="OnSimServiceFiltersChangedAsync" />
                </div>
                <ClayDetailGrid TItem="EquipmentSimService"
                                Title="Дополнительные услуги SIM"
                                Items="_simServices"
                                Columns="_simServiceColumns"
                                Options="_simServiceGridOptions"
                                OnAdd="@(() => OpenSimServiceDialogAsync(null))"
                                AddDisabled="@(!_canEditSim || _simCards.Count == 0 || _saving)"
                                ReadOnly="@(!_canEditSim)">
                    <Actions Context="item">
                        <ClayButton Icon="@Icons.Material.Filled.Edit" Text="Изменить дополнительную услугу"
                                    Disabled="@(!_canEditSim || _saving)" OnClick="@(() => OpenSimServiceDialogAsync(item))" />
                    </Actions>
                </ClayDetailGrid>
            }
            @if (ShowLicense)
            {
                <ClayDetailGrid TItem="EquipmentLicense"
                                Title="Лицензия"
                                Items="_licenses"
                                Columns="_licenseColumns"
                                Options="_licenseGridOptions"
                                OnAdd="OpenLicenseDialogAsync"
                                AddDisabled="@(!_canEditLicense || _saving)"
                                ReadOnly="@(!_canEditLicense)">
                    <Actions Context="item">
                        <ClayButton Icon="@Icons.Material.Filled.Edit" Text="Изменить лицензию"
                                    Disabled="@(!_canEditLicense || _saving)" OnClick="OpenLicenseDialogAsync" />
                    </Actions>
                </ClayDetailGrid>
                <ClayDetailGrid TItem="EquipmentSoftwareInstallation"
                                Title="Установленное ПО"
                                Items="_softwareInstallations"
                                Columns="_softwareColumns"
                                Options="_softwareGridOptions"
                                OnAdd="@(() => OpenSoftwareDialogAsync(null))"
                                AddDisabled="@(!_canEdit || _saving)"
                                ReadOnly="@(!_canEdit)">
                    <Actions Context="item">
                        <ClayButton Icon="@Icons.Material.Filled.Edit" Text="Изменить установленное ПО"
                                    Disabled="@(!_canEdit || _saving)" OnClick="@(() => OpenSoftwareDialogAsync(item))" />
                    </Actions>
                </ClayDetailGrid>
            }
            @if (_canUseAccounting)
            {
                <ClayDetailGrid TItem="EquipmentAccounting"
                                Title="Бухгалтерский учёт"
                                Items="_accounting"
                                Columns="_accountingColumns"
                                Options="_accountingGridOptions"
                                OnAdd="@(() => OpenAccountingDialogAsync(null))"
                                AddDisabled="_saving"
                                ReadOnly="false">
                    <Actions Context="item">
                        <ClayButton Icon="@Icons.Material.Filled.Edit" Text="Изменить запись бухгалтерского учёта"
                                    Disabled="_saving" OnClick="@(() => OpenAccountingDialogAsync(item))" />
                        @if (_accounting.LastOrDefault()?.Id == item.Id)
                        {
                            <ClayButton Icon="@Icons.Material.Filled.Delete" Text="Удалить последнюю запись бухгалтерского учёта"
                                        Disabled="_saving" OnClick="@(() => DeleteAccountingAsync(item))" />
                        }
                    </Actions>
                </ClayDetailGrid>
            }
            @if (ShowRouter)
            {
                @if (!string.IsNullOrWhiteSpace(_routerInfo?.Description))
                {
                    <div class="equipment-router-description">@_routerInfo.Description</div>
                }
                <ClayDetailGrid TItem="EquipmentRouterInventoryItem"
                                Title="Маршрутизатор"
                                Items="_routerInventory"
                                Columns="_routerColumns"
                                Options="_routerGridOptions"
                                ReadOnly="true" />
            }
            <div class="equipment-ins-row">
                <span class="equipment-ins-label">Подключить UPS:</span>
                <ClaySelect TItem="UpsEquipmentLookup" TValue="int?"
                            DataSource="UpsSource"
                            ValueSelector="@(item => (int?)item.Id)"
                            TextSelector="@(item => item.Name)"
                            @bind-Value="_upsToAdd"
                            Options="_upsSelectOptions" />
                <ClayToolbarButton Options="_upsAddButtonOptions" OnClick="AddUpsLinkAsync" Disabled="@(!_canEdit || _upsToAdd is null || _saving)" />
            </div>
            <ClayDetailGrid TItem="UpsServerLink"
                            Title="Подключённые UPS"
                            Items="_upsLinks"
                            Columns="_upsColumns"
                            Options="_upsGridOptions"
                            ReadOnly="@(!_canEdit)">
                <Actions Context="item">
                    <ClayButton Icon="@Icons.Material.Filled.Edit" Text="Серверы и тесты UPS"
                                Disabled="@(!_canEdit || _saving)" OnClick="@(() => OpenUpsDialogAsync(item))" />
                    <ClayButton Icon="@Icons.Material.Filled.Delete" Text="Удалить связь UPS"
                                Disabled="@(!_canEdit || _saving)" OnClick="@(() => DeleteUpsLinkAsync(item))" />
                </Actions>
            </ClayDetailGrid>
            @if (_lastInventory is not null)
            {
                <section class="equipment-last-inventory">
                    <h3>Последняя инвентаризация</h3>
                    <div>@FormatDisplayDate(_lastInventory.CheckedAt, true) — @_lastInventory.ChangedByName</div>
                    @if (_lastInventory.IsBeyondRepair > 0)
                    {
                        <div>Оборудование сломано и ремонту не подлежит.</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_lastInventory.Notes))
                    {
                        <div>@_lastInventory.Notes</div>
                    }
                    @if (_lastInventory.LocationId != _model.LocationId)
                    {
                        <MudAlert Severity="Severity.Warning">Фактическое расположение не совпадает с учётным (ID @_lastInventory.LocationId).</MudAlert>
                    }
                </section>
            }
        }
    </ChildContent>
    <Footer>
        <ClayChanged ChangedById="_model?.ChangedById"
                     ChangedByName="@_model?.ChangedByName"
                     ChangedAt="_model?.ChangedAtUtc"
                     ChangedByUrl="@ChangedByUrl" />
    </Footer>
</ClayEntityForm>

<MudOverlay Visible="@(_loading || _saving)" DarkBackground="true">
    <div class="clay-busy">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        <span>@(_saving ? "Сохранение оборудования…" : "Загрузка формы…")</span>
    </div>
</MudOverlay>
