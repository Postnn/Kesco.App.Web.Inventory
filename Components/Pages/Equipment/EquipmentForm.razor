@page "/Equipment/EquipmentForm"
@layout Kesco.App.Web.Inventory.Components.Layout.EntityFormLayout
@using Clayzor.Lib.Entities.Inventory
@using Clayzor.Lib.Web.Controls.Components.Select
@using Clayzor.Lib.Web.Controls.Components.Grid
@using Clayzor.Lib.Web.DBSelect.Documents
@using Clayzor.Lib.Web.DBSelect.Equipment
@using Clayzor.Lib.Web.DBSelect.Persons
@using Kesco.App.Web.Inventory.Components.Pages.Equipment.Details
@using Kesco.App.Web.Inventory.Services
@implements IDisposable
@inject EquipmentFormService Service
@inject EquipmentTypeSelectDataSource EquipmentTypeSource
@inject EquipmentModelSelectDataSource ModelSource
@inject PhonePoolSelectDataSource PhonePoolSource
@inject PhoneNumberSelectDataSource PhoneNumberSource
@inject PersonSelectDataSource PersonSource
@inject IServiceProvider Services
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject IJSRuntime JS

<PageTitle>@Title</PageTitle>
<NavigationLock ConfirmExternalNavigation="@IsModified" OnBeforeInternalNavigation="BeforeInternalNavigationAsync" />

<ClayEntityForm Options="_entityFormOptions">
    <Toolbar>
        <ClayToolbar>
            @if (ShowOperations)
            {
                <ClayMenu Icon="@Icons.Material.Filled.ArrowDropDown" ButtonOptions="_operationsOptions"
                          AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft"
                          Disabled="@(_loading || _saving || !_loaded)">
                    @if (_canManageUps)
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.Power" OnClick="OpenUpsLinkDialogAsync">
                            Подключить к UPS
                        </MudMenuItem>
                    }
                    @if (_canChangeNetwork)
                    {
                        <MudMenuItem Icon="@(_networkAttachmentCount == 0 ? Icons.Material.Filled.Link : Icons.Material.Filled.LinkOff)"
                                     OnClick="@(() => SetNetworkAttachmentAsync(_networkAttachmentCount == 0))">
                            @(_networkAttachmentCount == 0 ? "Подключить к локальной сети" : "Отключить от локальной сети")
                        </MudMenuItem>
                    }
                </ClayMenu>
            }
            <ClayToolbarButton Options="_okOptions" Disabled="@(_loading || _saving || !_loaded || !_canEdit)" OnClick="@(() => SaveAsync(true))" />
            <ClayToolbarButton Options="_applyOptions" Disabled="@(!CanSave)" OnClick="@(() => SaveAsync(false))" />
            @if (ShowSimDetail)
            {
                <ClayToolbarButton Options="_simDetailOptions" Disabled="@(_loading || _saving || !_loaded)" OnClick="OpenSimDetailAsync" />
            }
            <ClayToolbarButton Options="_copyOptions" Disabled="@(_loading || _saving || !_loaded)" OnClick="CopyAsync" />
            <ClayToolbarButton Options="_refreshOptions" Disabled="@(_loading || _saving || !_loaded)" OnClick="RefreshAsync" />
            <ClayToolbarButton Options="_cancelOptions" Disabled="@_saving" OnClick="CancelAsync" />
            @if (ShowPhoneConfig)
            {
                <ClayToolbarButton Options="_phoneConfigOptions" Disabled="@(_loading || _saving || !_loaded || !_canViewPhoneConfig)" OnClick="OpenPhoneConfigAsync" />
            }
            @if (ShowNetworkName)
            {
                <ClayToolbarButton Options="_networkHistoryOptions" Disabled="@(_loading || _saving || !_loaded)" OnClick="OpenNetworkNameHistoryAsync" />
            }
        </ClayToolbar>
    </Toolbar>
    <ChildContent>
        @if (_notFound)
        {
            <MudAlert Severity="Severity.Warning">Оборудование с указанным идентификатором не найдено.</MudAlert>
        }
        else if (_loadError is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">
                <div class="d-flex flex-wrap gap-2 align-center">
                    <span>@_loadError</span>
                    <ClayToolbarButton Options="_refreshOptions" OnClick="RetryLoadAsync" />
                </div>
            </MudAlert>
        }
        else if (_model is not null)
        {
            if (!_canEdit)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-3">
                    Для изменения оборудования требуется роль «Специалист по инвентаризации оборудования» (43).
                </MudAlert>
            }
            if (!string.IsNullOrWhiteSpace(_validationMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">@_validationMessage</MudAlert>
            }

            @if (_upsLinks.Count > 0 && !HideNetworkAndUps)
            {
                <div class="equipment-ups-summary">
                    Подключено к:
                    @for (var index = 0; index < _upsLinks.Count; index++)
                    {
                        var ups = _upsLinks[index];
                        if (index > 0)
                        {
                            <text>; </text>
                        }
                        if (_canManageUps)
                        {
                            <a href="#ups-@ups.UpsEquipmentId"
                               title="Нажмите, чтобы посмотреть другие подключения к этому UPS"
                               @onclick="@(() => OpenUpsDialogAsync(ups))" @onclick:preventDefault="true">@ups.EquipmentName</a>
                        }
                        else if (EquipmentUrl(ups.UpsEquipmentId) is string upsUrl)
                        {
                            <a href="@upsUrl" target="_blank" rel="noopener">@ups.EquipmentName</a>
                        }
                        else
                        {
                            @ups.EquipmentName
                        }
                    }
                </div>
            }

            <MudForm @ref="_form">
                <div class="equipment-form-fields">
                    <div class="equipment-form-pair equipment-form-writeoff-row">
                        <span class="equipment-form-label">SN:</span>
                        <ClayTextBox @bind-Value="_model.SerialNumber" Options="_snOptions" />
                        <span class="equipment-form-label">Списано:</span>
                        <div class="equipment-form-writeoff">
                            <div class="equipment-form-writeoff-date">
                                <ClayDatePicker @bind-Value="_writeOffDate" Options="_writeOffDateOptions" />
                            </div>
                            <ClayTime @bind-Value="_writeOffTime" Options="_writeOffTimeOptions" />
                            <span class="equipment-form-label">№</span>
                            <div class="equipment-form-writeoff-document">
                                <ClaySelect TItem="DocumentLookup" TValue="int?"
                                            DataSource="WriteOffDocumentSource"
                                            ValueSelector="@(item => (int?)item.Id)"
                                            TextSelector="@(item => item.DisplayName)"
                                            @bind-Value="_model.DocumentWriteOffId"
                                            Options="_writeOffDocumentOptions" />
                            </div>
                        </div>
                        @if (_model.DocumentWriteOffId is null && _writeOffActs.Count > 0)
                        {
                            <div class="equipment-writeoff-acts">
                                Оборудование добавлено в: @string.Join(", ", _writeOffActs.Select(item => item.DisplayName))
                            </div>
                        }
                    </div>
                    <div class="equipment-form-pair">
                        <span class="equipment-form-label">Тип:</span>
                        <div>
                            <ClaySelect TItem="EquipmentType" TValue="int?"
                                        DataSource="EquipmentTypeSource"
                                        ValueSelector="@(item => (int?)item.Id)"
                                        TextSelector="@(item => item.Name)"
                                        Value="_model.EquipmentTypeId"
                                        ValueChanged="OnTypeIdChanged"
                                        SelectedItem="_selectedType"
                                        SelectedItemChanged="OnTypeChanged"
                                        Cleared="OnTypeClearConfirmed"
                                        Options="_typeOptions" />
                            <ClayCheckbox State="_sortTypesByName" StateChanged="OnTypeSortChanged"
                                          Label="сортировать типы в списке по алфавиту" />
                        </div>
                        <span class="equipment-form-label">Модель:</span>
                        <div>
                            <ClaySelect TItem="EquipmentModel" TValue="int?"
                                        DataSource="ModelSource"
                                        ValueSelector="@(item => (int?)item.Id)"
                                        TextSelector="@(item => item.Name)"
                                        Value="_model.ModelId"
                                        ValueChanged="OnModelIdChanged"
                                        SelectedItem="_selectedModel"
                                        SelectedItemChanged="OnModelChangedAsync"
                                        ViewItem="ModelViewItem"
                                        Options="_modelOptions" />
                            @if (_selectedModel is not null && _model.ModelId is not null)
                            {
                                if (!string.IsNullOrWhiteSpace(_selectedModel.PartNumber))
                                {
                                    <div class="equipment-form-model-meta">PN: @_selectedModel.PartNumber</div>
                                }
                                if (_selectedModel.IsMultimedia)
                                {
                                    <div class="equipment-form-model-meta">Мультимедиа</div>
                                }
                                if (_selectedModel.MonitorSize > 0)
                                {
                                    <div class="equipment-form-model-meta">Диагональ: @_selectedModel.MonitorSize.ToString("0.0")</div>
                                }
                                if (!string.IsNullOrWhiteSpace(_selectedModel.Cpu))
                                {
                                    <div class="equipment-form-model-meta">CPU: @_selectedModel.Cpu</div>
                                }
                                if (_selectedModel.NetworkInterfaces > 0)
                                {
                                    <div class="equipment-form-model-meta">Net: @_selectedModel.NetworkInterfaces @_selectedModel.NetworkName</div>
                                }
                                if (_selectedModel.MemoryTypeId > 0 && !string.IsNullOrWhiteSpace(_selectedModel.MemoryTypeName))
                                {
                                    <div class="equipment-form-model-meta">
                                        Тип памяти: @_selectedModel.MemoryTypeName
                                        @if (_selectedModel.MemoryBanks > 0)
                                        {
                                            <text>; кол-во банков: @_selectedModel.MemoryBanks</text>
                                        }
                                    </div>
                                }
                                if (!string.IsNullOrWhiteSpace(_selectedModel.Driver))
                                {
                                    <div class="equipment-form-model-meta">Драйвер: @_selectedModel.Driver</div>
                                }
                                if (!string.IsNullOrWhiteSpace(_selectedModel.LifeTime))
                                {
                                    <div class="equipment-form-model-meta">Ресурс: @_selectedModel.LifeTime</div>
                                }
                                if (!string.IsNullOrWhiteSpace(_selectedModel.Description))
                                {
                                    <div class="equipment-form-model-meta">@_selectedModel.Description</div>
                                }
                            }
                        </div>
                    </div>
                    @if (ShowPhones)
                    {
                        <div class="equipment-form-single">
                            <span class="equipment-form-label">Телефонный номер:</span>
                            <div class="equipment-phone-editor">
                                @if (_phones.Count > 0)
                                {
                                    <ClayGrid TEntity="EquipmentPhoneLink" @key="PhoneGridKey"
                                              Items="_phones" Options="_phoneGridOptions"
                                              RowClass="@(item => item.ReturnDate?.Date < DateTime.UtcNow.Date ? "equipment-overdue" : null)">
                                        <ColumnDefs>
                                            <ClayColumnDef ColumnId="1" SqlName="Description" DisplayName="Название" />
                                            @if (_phones.Any(item => item.ConnectionEquipmentId is > 0))
                                            {
                                                <ClayColumnDef ColumnId="2" SqlName="ConnectionEquipment" DisplayName="Код оборудования подключения" />
                                            }
                                            @if (_canEdit || _phones.Any(item => item.ReturnDate is not null))
                                            {
                                                <ClayColumnDef ColumnId="3" SqlName="ReturnDate" DisplayName="Срок возврата" />
                                            }
                                        </ColumnDefs>
                                        <Columns>
                                            <ClayColumn TEntity="EquipmentPhoneLink" ColumnId="1">
                                                <CellTemplate>
                                                    @RenderLink(PhoneUrl(context.Item.PhoneId),
                                                        context.Item.Description + (context.Item.IsDefault ? " (основной на аппарате)" : string.Empty),
                                                        PhoneChangedTooltip(context.Item))
                                                </CellTemplate>
                                            </ClayColumn>
                                            @if (_phones.Any(item => item.ConnectionEquipmentId is > 0))
                                            {
                                                <ClayColumn TEntity="EquipmentPhoneLink" ColumnId="2">
                                                    <CellTemplate>
                                                        @if (context.Item.ConnectionEquipmentId is > 0)
                                                        {
                                                            @RenderLink(EquipmentUrl(context.Item.ConnectionEquipmentId), $"#{context.Item.ConnectionEquipmentId}",
                                                                "Оборудование подключения. Нажмите, чтобы открыть.")
                                                        }
                                                    </CellTemplate>
                                                </ClayColumn>
                                            }
                                            @if (_canEdit || _phones.Any(item => item.ReturnDate is not null))
                                            {
                                                <ClayColumn TEntity="EquipmentPhoneLink" ColumnId="3">
                                                    <CellTemplate>
                                                        @if (context.Item.ReturnDate is not null)
                                                        {
                                                            @($"срок возврата {context.Item.ReturnDate:dd.MM.yyyy}")@(string.IsNullOrWhiteSpace(context.Item.Notes) ? string.Empty : $" ({context.Item.Notes})")
                                                        }
                                                    </CellTemplate>
                                                </ClayColumn>
                                            }
                                        </Columns>
                                        <RowActions Context="item">
                                            <ClayButton Icon="@Icons.Material.Filled.Schedule" Text="Изменить срок возврата"
                                                        Disabled="@(!CanEditPhones || _saving)" OnClick="@(() => EditPhoneReturnAsync(item))" />
                                            <ClayButton Icon="@Icons.Material.Filled.Delete" Text="Удалить связь с номером"
                                                        Disabled="@(!CanEditPhones || _saving)" OnClick="@(() => RemovePhoneAsync(item))" />
                                        </RowActions>
                                    </ClayGrid>
                                }
                                <ClaySelect TItem="PhoneNumberLookup" TValue="int?"
                                            DataSource="PhoneNumberSource"
                                            ValueSelector="@(item => (int?)item.Id)"
                                            TextSelector="@(item => item.Name)"
                                            Value="_phoneToAdd"
                                            ValueChanged="OnPhoneToAddChangedAsync"
                                            Options="_phoneOptions" />
                                @if (ShowHotelPhoneWarning)
                                {
                                    <MudAlert Severity="Severity.Warning" Class="mt-2">
                                        На телефонном аппарате, расположенном в номере гостиницы, может быть только один телефонный номер.
                                    </MudAlert>
                                }
                            </div>
                        </div>
                        @if (ShowCamera)
                        {
                            <div class="equipment-form-single">
                                <span class="equipment-form-label">Камера:</span>
                                <ClayCheckbox State="@(_model.CameraIsConnected != 0)" StateChanged="OnCameraChanged"
                                              ReadOnly="@(!_canEdit)" Label="подключена камера" />
                            </div>
                        }
                    }
                    @if (ShowNetworkName || MacCount > 0)
                    {
                        <div class="equipment-form-pair">
                            <span class="equipment-form-label">@(ShowNetworkName ? "Сетевое имя:" : string.Empty)</span>
                            <div>
                                @if (ShowNetworkName)
                                {
                                    <ClayTextBox @bind-Value="_model.NetworkName" Options="_networkNameOptions" />
                                    @if (!HideNetworkAndUps && _networkPorts.Any(item => !item.NetworkName.StartsWith("*")))
                                    {
                                        <div data-testid="equipment-network-ports">
                                            @foreach (var port in _networkPorts.Where(item => !item.NetworkName.StartsWith("*")))
                                            {
                                                <div class="equipment-form-model-meta">
                                                    <a href="@NetUrl(port.Id)" class="@(NetworkPortsHaveWarning ? "mud-error-text" : null)"
                                                       @onclick="() => OpenNetAsync(port.Id)" @onclick:preventDefault>@port.DisplayName</a>
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                            <span class="equipment-form-label">@(MacCount > 0 ? "MAC:" : string.Empty)</span>
                            <div class="equipment-form-mac">
                                @if (MacCount > 0)
                                {
                                    <ClayTextBox Value="@_model.MacAddress" ValueChanged="@(value => OnMacChanged(value, 1))" Options="_macOptions" />
                                    @if (MacCount > 1)
                                    {
                                        <span class="equipment-form-label">MAC 2:</span>
                                        <ClayTextBox Value="@_model.MacAddress2" ValueChanged="@(value => OnMacChanged(value, 2))" Options="_macOptions" />
                                    }
                                    @if (MacCount > 2)
                                    {
                                        <span class="equipment-form-label">MAC ILO:</span>
                                        <ClayTextBox Value="@_model.MacAddressIlo" ValueChanged="@(value => OnMacChanged(value, 3))" Options="_macOptions" />
                                    }
                                }
                            </div>
                        </div>
                    }
                    <div class="equipment-form-single equipment-form-top">
                        <span class="equipment-form-label">Примечания:</span>
                        <ClayTextArea @bind-Value="_model.Description" Options="_descriptionOptions" />
                    </div>
                    @if (ShowPhonePool)
                    {
                        <div class="equipment-form-single">
                            <span class="equipment-form-label">Пул телефона:</span>
                            <ClaySelect TItem="PhonePoolLookup" TValue="int?"
                                        DataSource="PhonePoolSource"
                                        ValueSelector="@(item => (int?)item.Id)"
                                        TextSelector="@(item => item.Name)"
                                        @bind-Value="_model.PhonePoolId"
                                        Options="_phonePoolOptions" />
                        </div>
                    }
                </div>
            @if (!string.IsNullOrWhiteSpace(_warningMessage))
            {
                <MudAlert Severity="Severity.Warning" Class="mt-3">@_warningMessage</MudAlert>
            }
            @if (ShowAccounts)
            {
                if (!_accountsVisible)
                {
                    <a href="#equipment-accounts" class="equipment-accounts-toggle"
                       title="Показать учетные записи оборудования"
                       @onclick="ShowAccountGrid" @onclick:preventDefault="true">
                        <MudIcon Icon="@Icons.Material.Filled.Group" Size="Size.Small" />
                        <span>Учетные записи оборудования</span>
                    </a>
                }
                else
                {
                    <ClayGrid TEntity="EquipmentAccount" Items="_accounts" Options="_accountGridOptions"
                              OnAdd="@(() => OpenAccountDialogAsync(null))" AddDisabled="@(!CanEditAccounts || _saving)">
                        <ColumnDefs>
                            <ClayColumnDef ColumnId="1" SqlName="Login" DisplayName="Логин" />
                            <ClayColumnDef ColumnId="2" SqlName="Password" DisplayName="Пароль" />
                            <ClayColumnDef ColumnId="3" SqlName="LimitedRights" DisplayName="Ограниченные права" />
                            <ClayColumnDef ColumnId="4" SqlName="Notes" DisplayName="Примечание" />
                        </ColumnDefs>
                        <Columns>
                            <ClayColumn TEntity="EquipmentAccount" ColumnId="1" TextSelector="@(item => item.Login)" />
                            <ClayColumn TEntity="EquipmentAccount" ColumnId="2" TextSelector="@(_ => "*****")" />
                            <ClayColumn TEntity="EquipmentAccount" ColumnId="3" TextSelector="@(item => item.LimitedRights > 0 ? "Да" : "Нет")" />
                            <ClayColumn TEntity="EquipmentAccount" ColumnId="4" TextSelector="@(item => item.Notes)" />
                        </Columns>
                        <RowActions Context="item">
                            <ClayButton Icon="@Icons.Material.Filled.Edit" Text="Изменить учётную запись"
                                        Disabled="@(!CanEditAccounts || _saving)" OnClick="@(() => OpenAccountDialogAsync(item))" />
                            <ClayButton Icon="@Icons.Material.Filled.Delete" Text="Удалить учётную запись"
                                        Disabled="@(!CanEditAccounts || _saving)" OnClick="@(() => DeleteAccountAsync(item))" />
                        </RowActions>
                    </ClayGrid>
                }
            }
            @if (ShowRouter)
            {
                @if (!string.IsNullOrWhiteSpace(_routerInfo?.Description))
                {
                    <div class="equipment-router-description">@_routerInfo.Description</div>
                }
                <ClayGrid TEntity="EquipmentRouterInventoryItem" Items="_routerInventory" Options="_routerGridOptions">
                    <ColumnDefs>
                        <ClayColumnDef ColumnId="1" SqlName="Module" DisplayName="Модуль" />
                        <ClayColumnDef ColumnId="2" SqlName="Characteristic" DisplayName="Характеристика" />
                    </ColumnDefs>
                    <Columns>
                        <ClayColumn TEntity="EquipmentRouterInventoryItem" ColumnId="1" TextSelector="@(item => item.Module)" />
                        <ClayColumn TEntity="EquipmentRouterInventoryItem" ColumnId="2" TextSelector="@(item => item.Characteristic)" />
                    </Columns>
                </ClayGrid>
            }
            @if (ShowSim)
            {
                <ClayGrid TEntity="EquipmentSimCard" Items="_simCards" Options="_simGridOptions"
                          OnAdd="OpenSimDialogAsync" AddDisabled="@(!CanEditSim || _simCards.Count > 0 || _saving)">
                    <ColumnDefs>
                        <ClayColumnDef ColumnId="1" SqlName="PhoneNumber" DisplayName="НомерТелефона" />
                        <ClayColumnDef ColumnId="2" SqlName="ActivatedAt" DisplayName="Активация" />
                        <ClayColumnDef ColumnId="3" SqlName="Contract" DisplayName="Договор" />
                        <ClayColumnDef ColumnId="4" SqlName="PersonalDataPerson" DisplayName="Лицо ПДн" />
                        <ClayColumnDef ColumnId="5" SqlName="ChangedBy" DisplayName="Изменил" />
                        <ClayColumnDef ColumnId="6" SqlName="ChangedAt" DisplayName="Изменено" />
                    </ColumnDefs>
                    <Columns>
                        <ClayColumn TEntity="EquipmentSimCard" ColumnId="1" TextSelector="@(item => item.PhoneNumber)" />
                        <ClayColumn TEntity="EquipmentSimCard" ColumnId="2" TextSelector="@(item => FormatDisplayDate(item.ActivatedAtUtc, true))" />
                        <ClayColumn TEntity="EquipmentSimCard" ColumnId="3" TextSelector="@(item => item.ContractName)" />
                        <ClayColumn TEntity="EquipmentSimCard" ColumnId="4" TextSelector="@(item => item.PersonalDataPersonName)" />
                        <ClayColumn TEntity="EquipmentSimCard" ColumnId="5" TextSelector="@(item => item.ChangedByName)" />
                        <ClayColumn TEntity="EquipmentSimCard" ColumnId="6" TextSelector="@(item => FormatDisplayDate(item.ChangedAt, true))" />
                    </Columns>
                    <RowActions Context="item">
                        <ClayButton Icon="@Icons.Material.Filled.Edit" Text="Изменить сведения SIM"
                                    Disabled="@(!CanEditSim || _saving)" OnClick="OpenSimDialogAsync" />
                        <ClayButton Icon="@Icons.Material.Filled.Delete" Text="Удалить сведения SIM"
                                    Disabled="@(!CanEditSim || _saving)" OnClick="DeleteSimAsync" />
                    </RowActions>
                </ClayGrid>
            }
            @if (ShowLicense)
            {
                <ClayGrid TEntity="EquipmentLicense" Items="_licenses" Options="_licenseGridOptions"
                          OnAdd="OpenLicenseDialogAsync" AddDisabled="@(!CanEditLicense || _licenses.Count > 0 || _saving)">
                    <ColumnDefs>
                        <ClayColumnDef ColumnId="1" SqlName="LicenseType" DisplayName="Тип лицензирования" />
                        <ClayColumnDef ColumnId="2" SqlName="LicenseeNumber" DisplayName="Номер лицензиата" />
                        <ClayColumnDef ColumnId="3" SqlName="VerificationUrl" DisplayName="URL проверки лицензии" />
                        <ClayColumnDef ColumnId="4" SqlName="ServerCount" DisplayName="Количество серверов" />
                        <ClayColumnDef ColumnId="5" SqlName="ClientCount" DisplayName="Количество клиентов" />
                        <ClayColumnDef ColumnId="6" SqlName="Period" DisplayName="Период действия" />
                        <ClayColumnDef ColumnId="7" SqlName="Distribution" DisplayName="Дистрибутив" />
                        <ClayColumnDef ColumnId="8" SqlName="ChangedBy" DisplayName="Изменил" />
                        <ClayColumnDef ColumnId="9" SqlName="ChangedAt" DisplayName="Изменено" />
                    </ColumnDefs>
                    <Columns>
                        <ClayColumn TEntity="EquipmentLicense" ColumnId="1" TextSelector="@(item => item.LicenseTypeName)" />
                        <ClayColumn TEntity="EquipmentLicense" ColumnId="2" TextSelector="@(item => item.LicenseeNumber)" />
                        <ClayColumn TEntity="EquipmentLicense" ColumnId="3">
                            <CellTemplate>@RenderLink(SafeExternalUrl(context.Item.VerificationUrl), context.Item.VerificationUrl)</CellTemplate>
                        </ClayColumn>
                        <ClayColumn TEntity="EquipmentLicense" ColumnId="4" TextSelector="@(item => item.ServerCount?.ToString() ?? string.Empty)" />
                        <ClayColumn TEntity="EquipmentLicense" ColumnId="5" TextSelector="@(item => item.ClientCount?.ToString() ?? string.Empty)" />
                        <ClayColumn TEntity="EquipmentLicense" ColumnId="6" TextSelector="@(item => FormatPeriod(item.DateFrom, item.DateTo))" />
                        <ClayColumn TEntity="EquipmentLicense" ColumnId="7" TextSelector="@(item => item.Distribution)" />
                        <ClayColumn TEntity="EquipmentLicense" ColumnId="8" TextSelector="@(item => item.ChangedByName)" />
                        <ClayColumn TEntity="EquipmentLicense" ColumnId="9" TextSelector="@(item => FormatDisplayDate(item.ChangedAt, true))" />
                    </Columns>
                    <RowActions Context="item">
                        <ClayButton Icon="@Icons.Material.Filled.Edit" Text="Изменить лицензию"
                                    Disabled="@(!CanEditLicense || _saving)" OnClick="OpenLicenseDialogAsync" />
                    </RowActions>
                </ClayGrid>
            }
            @if (ShowComputer)
            {
                <ClayGrid TEntity="EquipmentComputerSnapshot" @key="_computerHistory"
                          Items="_computerHistory" Options="_computerGridOptions"
                          OnAdd="OpenComputerDialogAsync" AddDisabled="@(!_canEdit || _saving)">
                    <ColumnDefs>
                        <ClayColumnDef ColumnId="1" SqlName="Date" DisplayName="С" />
                        @if (_computerHistory.Any(item => item.RamMb != 0))
                        {
                            <ClayColumnDef ColumnId="2" SqlName="Ram" DisplayName="RAM" />
                        }
                        @for (var index = 0; index < ComputerRamColumns; index++)
                        {
                            <ClayColumnDef ColumnId="@(100 + index)" SqlName="@($"Ram{index}")" DisplayName="@($"RAM{index + 1}")" />
                        }
                        @if (_computerHistory.Any(item => item.HdGb != 0))
                        {
                            <ClayColumnDef ColumnId="3" SqlName="Hd" DisplayName="HD" />
                        }
                        @for (var index = 0; index < ComputerHdColumns; index++)
                        {
                            <ClayColumnDef ColumnId="@(200 + index)" SqlName="@($"Hd{index}")" DisplayName="@($"HD{index + 1}")" />
                        }
                        @if (_computerHistory.Any(item => item.SsdGb != 0))
                        {
                            <ClayColumnDef ColumnId="4" SqlName="Ssd" DisplayName="SSD" />
                        }
                        @for (var index = 0; index < ComputerSsdColumns; index++)
                        {
                            <ClayColumnDef ColumnId="@(300 + index)" SqlName="@($"Ssd{index}")" DisplayName="@($"SSD{index + 1}")" />
                        }
                        @if (_computerHistory.Any(item => item.Configuration1Id is not null))
                        {
                            <ClayColumnDef ColumnId="5" SqlName="Configuration1" DisplayName="Стандартная конфигурация 1" />
                        }
                        @if (_computerHistory.Any(item => item.Configuration2Id is not null))
                        {
                            <ClayColumnDef ColumnId="6" SqlName="Configuration2" DisplayName="Стандартная конфигурация 2" />
                        }
                        <ClayColumnDef ColumnId="7" SqlName="License" DisplayName="Лицензия" />
                        <ClayColumnDef ColumnId="8" SqlName="Notes" DisplayName="Примечания" />
                        <ClayColumnDef ColumnId="9" SqlName="ChangedBy" DisplayName="Изменил" />
                        <ClayColumnDef ColumnId="10" SqlName="ChangedAt" DisplayName="Изменено" />
                    </ColumnDefs>
                    <Columns>
                        <ClayColumn TEntity="EquipmentComputerSnapshot" ColumnId="1" TextSelector="@(item => item.Date.ToString("dd.MM.yyyy"))" />
                        @if (_computerHistory.Any(item => item.RamMb != 0))
                        {
                            <ClayColumn TEntity="EquipmentComputerSnapshot" ColumnId="2" TextSelector="@(item => item.RamMb.ToString())" />
                        }
                        @for (var index = 0; index < ComputerRamColumns; index++)
                        {
                            var componentIndex = index;
                            <ClayColumn TEntity="EquipmentComputerSnapshot" ColumnId="@(100 + index)" TextSelector="@(item => ComputerComponent(item.RamComponents, componentIndex))" />
                        }
                        @if (_computerHistory.Any(item => item.HdGb != 0))
                        {
                            <ClayColumn TEntity="EquipmentComputerSnapshot" ColumnId="3" TextSelector="@(item => item.HdGb.ToString("0.###"))" />
                        }
                        @for (var index = 0; index < ComputerHdColumns; index++)
                        {
                            var componentIndex = index;
                            <ClayColumn TEntity="EquipmentComputerSnapshot" ColumnId="@(200 + index)" TextSelector="@(item => ComputerComponent(item.HdComponents, componentIndex))" />
                        }
                        @if (_computerHistory.Any(item => item.SsdGb != 0))
                        {
                            <ClayColumn TEntity="EquipmentComputerSnapshot" ColumnId="4" TextSelector="@(item => item.SsdGb.ToString())" />
                        }
                        @for (var index = 0; index < ComputerSsdColumns; index++)
                        {
                            var componentIndex = index;
                            <ClayColumn TEntity="EquipmentComputerSnapshot" ColumnId="@(300 + index)" TextSelector="@(item => ComputerComponent(item.SsdComponents, componentIndex))" />
                        }
                        @if (_computerHistory.Any(item => item.Configuration1Id is not null))
                        {
                            <ClayColumn TEntity="EquipmentComputerSnapshot" ColumnId="5" TextSelector="@(item => FormatConfiguration(item.Configuration1Name, item.Configuration1Date))" />
                        }
                        @if (_computerHistory.Any(item => item.Configuration2Id is not null))
                        {
                            <ClayColumn TEntity="EquipmentComputerSnapshot" ColumnId="6" TextSelector="@(item => FormatConfiguration(item.Configuration2Name, item.Configuration2Date))" />
                        }
                        <ClayColumn TEntity="EquipmentComputerSnapshot" ColumnId="7" TextSelector="@(item => item.License)" />
                        <ClayColumn TEntity="EquipmentComputerSnapshot" ColumnId="8" TextSelector="@(item => item.Notes)" />
                        <ClayColumn TEntity="EquipmentComputerSnapshot" ColumnId="9" TextSelector="@(item => item.ChangedByName)" />
                        <ClayColumn TEntity="EquipmentComputerSnapshot" ColumnId="10" TextSelector="@(item => FormatDisplayDate(item.ChangedAt, true))" />
                    </Columns>
                </ClayGrid>
            }
            <ClayGrid TEntity="EquipmentLocationPeriod" Items="_locations" Options="_locationGridOptions"
                      OnAdd="@(() => OpenLocationDialogAsync(null))" AddDisabled="@(!_canEdit || _saving)">
                <ColumnDefs>
                    <ClayColumnDef ColumnId="1" SqlName="Date" DisplayName="Дата" />
                    <ClayColumnDef ColumnId="2" SqlName="Location" DisplayName="Расположение" />
                    <ClayColumnDef ColumnId="3" SqlName="Notes" DisplayName="Примечания" />
                    <ClayColumnDef ColumnId="4" SqlName="ChangedBy" DisplayName="Изменил" />
                    <ClayColumnDef ColumnId="5" SqlName="ChangedAt" DisplayName="Изменено" />
                </ColumnDefs>
                <Columns>
                    <ClayColumn TEntity="EquipmentLocationPeriod" ColumnId="1" TextSelector="@(item => FormatLocationDate(item))" />
                    <ClayColumn TEntity="EquipmentLocationPeriod" ColumnId="2" TextSelector="@(item => item.LocationName)" />
                    <ClayColumn TEntity="EquipmentLocationPeriod" ColumnId="3" TextSelector="@(item => item.Notes)" />
                    <ClayColumn TEntity="EquipmentLocationPeriod" ColumnId="4" TextSelector="@(item => item.ChangedByName)" />
                    <ClayColumn TEntity="EquipmentLocationPeriod" ColumnId="5" TextSelector="@(item => FormatDisplayDate(item.ChangedAtUtc, true))" />
                </Columns>
                <RowActions Context="item">
                    @if (_locations.LastOrDefault() == item)
                    {
                        <ClayButton Icon="@Icons.Material.Filled.Edit" Text="Изменить срок возврата и примечания"
                                    Disabled="@(!_canEdit || _saving)" OnClick="@(() => OpenLocationDialogAsync(item))" />
                    }
                </RowActions>
            </ClayGrid>
            @if (_lastInventory is not null)
            {
                <div class="equipment-last-inventory-inline">
                    <strong>Последняя инвентаризация:</strong>
                    @FormatDisplayDate(_lastInventory.CheckedAt, true) —
                    @if (EmployeeUrl(_lastInventory.ChangedById) is string employeeUrl)
                    {
                        <a href="@employeeUrl" target="_blank" rel="noopener">@_lastInventory.ChangedByName</a>
                    }
                    else
                    {
                        @_lastInventory.ChangedByName
                    }
                    @if (!string.IsNullOrWhiteSpace(_lastInventory.Notes))
                    {
                        <text>; @_lastInventory.Notes</text>
                    }
                    @if (_lastInventory.IsBeyondRepair > 0)
                    {
                        <text>; оборудование сломано и ремонту не подлежит</text>
                    }
                    @if (_lastInventory.LocationId != _model.LocationId)
                    {
                        <text>; фактическое расположение: @(string.IsNullOrWhiteSpace(_lastInventory.LocationName) ? $"#{_lastInventory.LocationId}" : _lastInventory.LocationName)</text>
                    }
                </div>
            }
            <ClayGrid TEntity="EquipmentResponsiblePeriod" Items="_responsibles" Options="_responsibleGridOptions"
                      OnAdd="@(() => OpenResponsibleDialogAsync(EquipmentResponsibleDialogMode.Issue, null))" AddDisabled="@(!_canEdit || _saving)">
                <ColumnDefs>
                    <ClayColumnDef ColumnId="1" SqlName="Period" DisplayName="Период" />
                    <ClayColumnDef ColumnId="2" SqlName="Employee" DisplayName="Ответственный" />
                    <ClayColumnDef ColumnId="3" SqlName="Notes" DisplayName="Примечания" />
                    <ClayColumnDef ColumnId="4" SqlName="ChangedBy" DisplayName="Изменил" />
                    <ClayColumnDef ColumnId="5" SqlName="ChangedAt" DisplayName="Изменено" />
                </ColumnDefs>
                <Columns>
                    <ClayColumn TEntity="EquipmentResponsiblePeriod" ColumnId="1" TextSelector="@(item => FormatResponsiblePeriod(item))" />
                    <ClayColumn TEntity="EquipmentResponsiblePeriod" ColumnId="2" TextSelector="@(item => item.EmployeeName)" />
                    <ClayColumn TEntity="EquipmentResponsiblePeriod" ColumnId="3" TextSelector="@(item => item.Notes)" />
                    <ClayColumn TEntity="EquipmentResponsiblePeriod" ColumnId="4" TextSelector="@(item => item.ChangedByName)" />
                    <ClayColumn TEntity="EquipmentResponsiblePeriod" ColumnId="5" TextSelector="@(item => FormatDisplayDate(item.ChangedAtUtc, true))" />
                </Columns>
                <RowActions Context="item">
                    @if (_responsibles.LastOrDefault() == item)
                    {
                        <ClayButton Icon="@Icons.Material.Filled.Edit" Text="Изменить срок возврата и примечания"
                                    Disabled="@(!_canEdit || _saving)" OnClick="@(() => OpenResponsibleDialogAsync(EquipmentResponsibleDialogMode.Edit, item))" />
                    }
                    @if (item.ToUtc is null)
                    {
                        <ClayButton Icon="@Icons.Material.Filled.PersonRemove" Text="Изыять оборудование"
                                    Disabled="@(!_canEdit || _saving)" OnClick="@(() => OpenResponsibleDialogAsync(EquipmentResponsibleDialogMode.Withdraw, item))" />
                    }
                </RowActions>
            </ClayGrid>
            @if (ShowComputer)
            {
                <ClayGrid TEntity="EquipmentSoftwareInstallation" Items="_softwareInstallations" Options="_softwareGridOptions"
                          RowClass="@(item => item.IsUninstalled > 0 ? "equipment-uninstalled" : null)"
                          OnAdd="@(() => OpenSoftwareDialogAsync(null))" AddDisabled="@(!_canEdit || _saving)">
                    <ColumnDefs>
                        <ClayColumnDef ColumnId="1" SqlName="Installed" DisplayName="Установлено ПО" />
                        <ClayColumnDef ColumnId="2" SqlName="Distribution" DisplayName="Дистрибутив" />
                        <ClayColumnDef ColumnId="3" SqlName="Period" DisplayName="Период" />
                        <ClayColumnDef ColumnId="4" SqlName="Notes" DisplayName="Примечания" />
                        <ClayColumnDef ColumnId="5" SqlName="ChangedBy" DisplayName="Изменил" />
                        <ClayColumnDef ColumnId="6" SqlName="ChangedAt" DisplayName="Изменено" />
                    </ColumnDefs>
                    <Columns>
                        <ClayColumn TEntity="EquipmentSoftwareInstallation" ColumnId="1">
                            <CellTemplate>@RenderLink(EquipmentUrl(context.Item.SoftwareId), context.Item.Installed, "Открыть форму редактирования информации о ПО")</CellTemplate>
                        </ClayColumn>
                        <ClayColumn TEntity="EquipmentSoftwareInstallation" ColumnId="2" TextSelector="@(item => item.Distribution)" />
                        <ClayColumn TEntity="EquipmentSoftwareInstallation" ColumnId="3" TextSelector="@(item => FormatPeriod(item.InstalledAt, item.UninstalledAt))" />
                        <ClayColumn TEntity="EquipmentSoftwareInstallation" ColumnId="4" TextSelector="@(item => item.Notes)" />
                        <ClayColumn TEntity="EquipmentSoftwareInstallation" ColumnId="5" TextSelector="@(item => item.ChangedByName)" />
                        <ClayColumn TEntity="EquipmentSoftwareInstallation" ColumnId="6" TextSelector="@(item => FormatDisplayDate(item.ChangedAt, true))" />
                    </Columns>
                    <RowActions Context="item">
                        <ClayButton Icon="@Icons.Material.Filled.Edit" Text="Изменить установленное ПО"
                                    Disabled="@(!CanEditComputer || _saving)" OnClick="@(() => OpenSoftwareDialogAsync(item))" />
                    </RowActions>
                </ClayGrid>
            }
            <ClayGrid TEntity="EquipmentAccounting" Items="_accounting" Options="_accountingGridOptions"
                      OnAdd="@(() => OpenAccountingDialogAsync(null))" AddDisabled="@(!_canUseAccounting || _saving)">
                <ColumnDefs>
                    <ClayColumnDef ColumnId="1" SqlName="Owner" DisplayName="Бухгалтерия" />
                    <ClayColumnDef ColumnId="2" SqlName="InventoryNumber" DisplayName="Инв №" />
                    <ClayColumnDef ColumnId="3" SqlName="Tenant" DisplayName="Арендатор" />
                    <ClayColumnDef ColumnId="4" SqlName="DateFrom" DisplayName="Дата поступления" />
                    <ClayColumnDef ColumnId="5" SqlName="DateTo" DisplayName="Дата списания" />
                    <ClayColumnDef ColumnId="6" SqlName="Notes" DisplayName="Примечания" />
                    <ClayColumnDef ColumnId="7" SqlName="ChangedBy" DisplayName="Изменил" />
                    <ClayColumnDef ColumnId="8" SqlName="ChangedAt" DisplayName="Изменено" />
                </ColumnDefs>
                <Columns>
                    <ClayColumn TEntity="EquipmentAccounting" ColumnId="1" TextSelector="@(item => item.OwnerName)" />
                    <ClayColumn TEntity="EquipmentAccounting" ColumnId="2" TextSelector="@(item => item.InventoryNumber)" />
                    <ClayColumn TEntity="EquipmentAccounting" ColumnId="3" TextSelector="@(item => item.TenantName)" />
                    <ClayColumn TEntity="EquipmentAccounting" ColumnId="4" TextSelector="@(item => item.DateFrom?.ToString("dd.MM.yyyy") ?? string.Empty)" />
                    <ClayColumn TEntity="EquipmentAccounting" ColumnId="5" TextSelector="@(item => item.DateTo?.ToString("dd.MM.yyyy") ?? string.Empty)" />
                    <ClayColumn TEntity="EquipmentAccounting" ColumnId="6" TextSelector="@(item => item.Notes)" />
                    <ClayColumn TEntity="EquipmentAccounting" ColumnId="7" TextSelector="@(item => item.ChangedByName)" />
                    <ClayColumn TEntity="EquipmentAccounting" ColumnId="8" TextSelector="@(item => FormatDisplayDate(item.ChangedAt, true))" />
                </Columns>
                <RowActions Context="item">
                    <ClayButton Icon="@Icons.Material.Filled.Edit" Text="Изменить запись бухгалтерского учёта"
                                Disabled="@(!_canUseAccounting || _saving)" OnClick="@(() => OpenAccountingDialogAsync(item))" />
                    @if (_accounting.LastOrDefault()?.Id == item.Id)
                    {
                        <ClayButton Icon="@Icons.Material.Filled.Delete" Text="Удалить последнюю запись бухгалтерского учёта"
                                    Disabled="@(!_canUseAccounting || _saving)" OnClick="@(() => DeleteAccountingAsync(item))" />
                    }
                </RowActions>
            </ClayGrid>
            <div class="equipment-form-fields equipment-form-ownership">
                <div class="equipment-form-pair">
                    <span class="equipment-form-label">Владелец:</span>
                    <ClaySelect TItem="PersonLookup" TValue="int?"
                                DataSource="PersonSource"
                                ValueSelector="@(item => (int?)item.Id)"
                                TextSelector="@(item => item.Name)"
                                Value="_model.OwnerId"
                                ValueChanged="OnOwnerChangedAsync"
                                Options="_ownerOptions" />
                    <span class="equipment-form-label">Арендатор:</span>
                    <ClaySelect TItem="PersonLookup" TValue="int?"
                                DataSource="PersonSource"
                                ValueSelector="@(item => (int?)item.Id)"
                                TextSelector="@(item => item.Name)"
                                @bind-Value="_model.TenantId"
                                Options="_tenantOptions" />
                </div>
                <div class="equipment-form-pair">
                    <span class="equipment-form-label">Документ поступления:</span>
                    <ClaySelect TItem="DocumentLookup" TValue="int?"
                                DataSource="ReceiptDocumentSource"
                                ValueSelector="@(item => (int?)item.Id)"
                                TextSelector="@(item => item.DisplayName)"
                                Value="_model.DocumentReceiptOuId"
                                ValueChanged="OnReceiptDocumentChangedAsync"
                                Options="_receiptDocumentOptions" />
                    <span class="equipment-form-label">Поставщик:</span>
                    <ClaySelect TItem="PersonLookup" TValue="int?"
                                DataSource="PersonSource"
                                ValueSelector="@(item => (int?)item.Id)"
                                TextSelector="@(item => item.Name)"
                                Value="_model.ShipperId"
                                ValueChanged="OnShipperChanged"
                                Options="_shipperOptions" />
                </div>
            </div>
            @if (ShowSim)
            {
                <div class="equipment-sim-service-filters">
                    <ClayCheckbox State="_showServiceHistory" StateChanged="value => _showServiceHistory = value == true" Label="Показать историю" OnToggle="OnSimServiceFiltersChangedAsync" />
                    <ClayCheckbox State="_showCompanyRequiredServices" StateChanged="value => _showCompanyRequiredServices = value == true" Label="Показать обязательные услуги" OnToggle="OnSimServiceFiltersChangedAsync" />
                </div>
                @if (SimIsBlocked)
                {
                    <MudText Typo="Typo.body2" Color="Color.Error" data-testid="sim-block-warning">заблокировано</MudText>
                }
                <ClayGrid TEntity="EquipmentSimService" @key="_showCompanyRequiredServices"
                          Items="_simServices" Options="_simServiceGridOptions"
                          RowClass="SimServiceRowClass"
                          OnAdd="@(() => OpenSimServiceDialogAsync(null))" AddDisabled="@(!CanEditSim || _simCards.Count == 0 || _saving)">
                    <ColumnDefs>
                        <ClayColumnDef ColumnId="1" SqlName="Period" DisplayName="Срок оказания услуги" />
                        <ClayColumnDef ColumnId="2" SqlName="ServiceType" DisplayName="Код услуги" />
                        <ClayColumnDef ColumnId="3" SqlName="Service" DisplayName="Услуга" />
                        @if (_simServices.Any(item => item.PlannedDateFrom is not null))
                        {
                            <ClayColumnDef ColumnId="9" SqlName="PlannedFrom" DisplayName="План подкл." />
                        }
                        @if (_simServices.Any(item => item.PlannedDateTo is not null))
                        {
                            <ClayColumnDef ColumnId="10" SqlName="PlannedTo" DisplayName="План откл." />
                        }
                        <ClayColumnDef ColumnId="4" SqlName="DailyCost" DisplayName="Стоимость в день" />
                        <ClayColumnDef ColumnId="5" SqlName="MonthlyCost" DisplayName="Стоимость в месяц" />
                        @if (_showCompanyRequiredServices)
                        {
                            <ClayColumnDef ColumnId="6" SqlName="Required" DisplayName="Обяз." />
                        }
                        <ClayColumnDef ColumnId="7" SqlName="ChangedBy" DisplayName="Изменил" />
                        <ClayColumnDef ColumnId="8" SqlName="ChangedAt" DisplayName="Изменено" />
                    </ColumnDefs>
                    <Columns>
                        <ClayColumn TEntity="EquipmentSimService" ColumnId="1" TextSelector="@(item => FormatPeriod(item.DateFrom, item.DateTo))" />
                        <ClayColumn TEntity="EquipmentSimService" ColumnId="2" TextSelector="@(item => item.ServiceTypeId)" />
                        <ClayColumn TEntity="EquipmentSimService" ColumnId="3">
                            <CellTemplate>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <span>@context.Item.ServiceName</span>
                                    @if (context.Item.GetWarning(DateTime.Today) is string warning)
                                    {
                                        <MudTooltip Text="@warning">
                                            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Size="Size.Small" />
                                        </MudTooltip>
                                    }
                                </MudStack>
                            </CellTemplate>
                        </ClayColumn>
                        @if (_simServices.Any(item => item.PlannedDateFrom is not null))
                        {
                            <ClayColumn TEntity="EquipmentSimService" ColumnId="9" TextSelector="@(item => item.PlannedDateFrom?.ToString("dd.MM.yyyy") ?? string.Empty)" />
                        }
                        @if (_simServices.Any(item => item.PlannedDateTo is not null))
                        {
                            <ClayColumn TEntity="EquipmentSimService" ColumnId="10" TextSelector="@(item => item.PlannedDateTo?.ToString("dd.MM.yyyy") ?? string.Empty)" />
                        }
                        <ClayColumn TEntity="EquipmentSimService" ColumnId="4" TextSelector="@(item => item.DailyCost.ToString("0.00"))" />
                        <ClayColumn TEntity="EquipmentSimService" ColumnId="5" TextSelector="@(item => item.MonthlyCost.ToString("0.00"))" />
                        @if (_showCompanyRequiredServices)
                        {
                            <ClayColumn TEntity="EquipmentSimService" ColumnId="6">
                                <CellTemplate>
                                    @if (context.Item.IsCompanyRequired)
                                    {
                                        <MudTooltip Text="@context.Item.RequiredServiceDescription">
                                            <MudIcon Icon="@Icons.Material.Filled.CheckBox" Size="Size.Small" />
                                        </MudTooltip>
                                    }
                                </CellTemplate>
                            </ClayColumn>
                        }
                        <ClayColumn TEntity="EquipmentSimService" ColumnId="7" TextSelector="@(item => item.ChangedByName)" />
                        <ClayColumn TEntity="EquipmentSimService" ColumnId="8" TextSelector="@(item => FormatDisplayDate(item.ChangedAt, true))" />
                    </Columns>
                    <RowActions Context="item">
                        <ClayButton Icon="@Icons.Material.Filled.Edit" Text="Изменить дополнительную услугу"
                                    Disabled="@(!CanEditSim || _saving)" OnClick="@(() => OpenSimServiceDialogAsync(item))" />
                    </RowActions>
                </ClayGrid>
                @if (_simServices.Count > 0)
                {
                    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="3" data-testid="sim-service-totals">
                        <MudText Typo="Typo.body2">Общая сумма</MudText>
                        <MudText Typo="Typo.body2">В день: @SimDailyTotal.ToString("0.00")</MudText>
                        <MudText Typo="Typo.body2">В месяц: @SimMonthlyTotal.ToString("0.00")</MudText>
                    </MudStack>
                }
            }
            </MudForm>
        }
    </ChildContent>
    <Footer>
        <ClayChanged ChangedById="_model?.ChangedById"
                     ChangedByName="@_model?.ChangedByName"
                     ChangedAt="_model?.ChangedAtUtc"
                     ChangedByUrl="@ChangedByUrl" />
    </Footer>
</ClayEntityForm>

<MudOverlay Visible="@(_loading || _saving)" DarkBackground="true">
    <div class="clay-busy">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        <span>@(_saving ? "Сохранение оборудования…" : "Загрузка формы…")</span>
    </div>
</MudOverlay>
