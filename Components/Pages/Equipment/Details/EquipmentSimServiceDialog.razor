@inherits EquipmentEditorDialogBase<EquipmentSimService>
@using Clayzor.Lib.Entities.Inventory
@using Clayzor.Lib.Web.Controls.Components.Form

<MudDialog>
    <TitleContent>Дополнительная услуга SIM</TitleContent>
    <DialogContent>
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error">@_error</MudAlert>
        }
        <div class="equipment-ins-row">
            <span class="equipment-ins-label">Тип услуги:</span>
            <ClayDropDownList TItem="SimServiceType" TValue="string"
                              Items="Types"
                              ValueSelector="@(item => item.Id)"
                              TextSelector="@(item => item.Name)"
                              Value="Value.ServiceTypeId"
                              ValueChanged="OnTypeChanged"
                              Options="_typeOptions" />
        </div>
        <div class="equipment-ins-row">
            <span class="equipment-ins-label">Название:</span>
            <ClayTextBox @bind-Value="Value.ServiceName" Options="_nameOptions" />
        </div>
        <div class="equipment-ins-row">
            <span class="equipment-ins-label">Подключена:</span>
            <ClayDatePicker @bind-Value="Value.DateFrom" Options="_fromOptions" />
        </div>
        <div class="equipment-ins-row">
            <span class="equipment-ins-label">Прекращена:</span>
            <ClayDatePicker @bind-Value="Value.DateTo" />
        </div>
        <div class="equipment-ins-row">
            <span class="equipment-ins-label">Включение:</span>
            <ClayNumber Value="@((decimal?)Value.ActivationCost)" ValueChanged="value => Value.ActivationCost = value ?? 0" Options="_costOptions" />
            <span class="equipment-ins-label">В день:</span>
            <ClayNumber Value="@((decimal?)Value.DailyCost)" ValueChanged="value => Value.DailyCost = value ?? 0" Options="_costOptions" />
            <span class="equipment-ins-label">В месяц:</span>
            <ClayNumber Value="@((decimal?)Value.MonthlyCost)" ValueChanged="value => Value.MonthlyCost = value ?? 0" Options="_costOptions" />
        </div>
    </DialogContent>
    <DialogActions>
        <ClayToolbarButton Options="_cancelButtonOptions" OnClick="Cancel" Disabled="@_saving" />
        <ClayToolbarButton Options="_okButtonOptions" OnClick="Apply" Disabled="@(_saving || _saveBlocked)" />
    </DialogActions>
</MudDialog>

@code {
    private readonly ClayToolbarButtonOptions _cancelButtonOptions = new() { Text = "Отмена" };
    private readonly ClayToolbarButtonOptions _okButtonOptions = new() { Text = "OK", Color = Color.Primary, Variant = Variant.Filled };
    private readonly ClayDropDownListOptions _typeOptions = new() { DraftKey = "sim-service.type" };
    private readonly ClayTextBoxOptions _nameOptions = new() { MaxLength = 100, DraftKey = "sim-service.name" };
    private readonly ClayDatePickerOptions _fromOptions = new() { Required = true, DraftKey = "sim-service.from" };
    private readonly ClayNumberOptions _costOptions = new() { Precision = 2, DraftKey = "sim-service.cost" };

    /// <summary>Редактируемая услуга.</summary>
    [Parameter] public EquipmentSimService Value { get; set; } = new();

    /// <summary>Доступные типы услуг.</summary>
    [Parameter] public IReadOnlyList<SimServiceType> Types { get; set; } = [];

    /// <summary>Календарная дата клиента для проверки фактических дат услуги.</summary>
    [Parameter] public DateTime? Today { get; set; }

    /// <summary>Возвращает актуальную business date непосредственно перед Apply.</summary>
    [Parameter] public Func<Task<DateTime>>? GetToday { get; set; }

    private bool IsEdit => Value.Id > 0;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        _typeOptions.ReadOnly = IsEdit;
        _nameOptions.ReadOnly = IsEdit && !string.IsNullOrWhiteSpace(Value.ServiceTypeId);
        _costOptions.ReadOnly = !IsEdit;
    }

    private void OnTypeChanged(string? id)
    {
        Value.ServiceTypeId = id ?? string.Empty;
        var type = Types.FirstOrDefault(item => item.Id == id);
        if (type is null)
            return;
        Value.ServiceName = type.Name;
        Value.ActivationCost = type.ActivationCost;
        Value.DailyCost = type.DailyCost;
        Value.MonthlyCost = type.MonthlyCost;
    }

    private async Task Apply()
    {
        var today = GetToday is null ? Today : (await GetToday()).Date;
        if (!IsEditorCurrent())
            return;
        await ApplyAsync(Value, () => today is null
            ? "Календарная дата клиента не задана. Сохранение дополнительной услуги SIM отменено."
            : Value.Validate(today.Value));
    }
}
