@using Clayzor.Lib.Entities.Inventory
@using Clayzor.Lib.Web.Controls.Components.Form
@using Clayzor.Lib.Web.Controls.Components.Grid
@using Kesco.App.Web.Inventory.Components.Layout
@using Kesco.App.Web.Inventory.Rules

<MudDialog>
    <TitleContent>Тестирование UPS</TitleContent>
    <DialogContent>
        <ClayFormActions Form="InventoryFormHelp.EquipmentUps" />
        <div class="@DraftOwnerClass" data-draft-scope="@DraftScope">
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error">@_error</MudAlert>
        }
        <div class="equipment-ins-row">
            <span class="equipment-ins-label">Дата и время:</span>
            <div class="equipment-ins-date">
                <ClayDatePicker @bind-Value="Date" Options="_dateOptions" />
                <ClayTime @bind-Value="Time" Options="_timeOptions" />
            </div>
        </div>
        <div class="equipment-ins-row">
            <span class="equipment-ins-label">Время батарей:</span>
            <ClayNumber Value="@((decimal?)Value.BatteryTime)" ValueChanged="value => Value.BatteryTime = (int)(value ?? 0)" Options="_batteryOptions" />
        </div>
        <div class="equipment-ins-row">
            <span class="equipment-ins-label">Серверы:</span>
            <div>
                @if (UncheckedServerNames.Count > 0)
                {
                    <MudAlert Severity="Severity.Warning">В списке серверов, получивших уведомление, выбраны не все сервера. Отсутствуют следующие: @string.Join(", ", UncheckedServerNames).</MudAlert>
                }
                <ClayGrid TEntity="UpsTestServerSelectionItem" Items="ServerRows" Options="_serverGridOptions">
                    <ColumnDefs>
                        <ClayColumnDef ColumnId="1" SqlName="ServerName" DisplayName="Сервер" />
                    </ColumnDefs>
                    <Columns>
                        <ClayColumn TEntity="UpsTestServerSelectionItem" ColumnId="1" TextSelector="@(item => item.Name)" />
                    </Columns>
                    <RowActions Context="item">
                        <ClayCheckbox State="item.IsChecked" ReadOnly="@(!item.IsRecognized)" OnToggle="() => ToggleServer(item)" Label="Получил уведомление" />
                    </RowActions>
                </ClayGrid>
            </div>
        </div>
        <div class="equipment-ins-row">
            <span class="equipment-ins-label">Ошибки:</span>
            <ClayTextArea @bind-Value="Value.Issues" Options="_issuesOptions" />
        </div>
        </div>
    </DialogContent>
    <DialogActions>
        <ClayToolbarButton Options="_cancelButtonOptions" OnClick="Cancel" />
        <ClayToolbarButton Options="_okButtonOptions" OnClick="Apply" Disabled="@RawNotReady" />
    </DialogActions>
</MudDialog>

@code {
    private readonly ClayToolbarButtonOptions _cancelButtonOptions = new() { Text = "Отмена" };
    private readonly ClayToolbarButtonOptions _okButtonOptions = new() { Text = "OK", Color = Color.Primary, Variant = Variant.Filled };
    private readonly ClayDatePickerOptions _dateOptions = new() { Required = true, DraftKey = "ups-test.date" };
    private readonly ClayTimeOptions _timeOptions = new() { Required = true, DraftKey = "ups-test.time" };
    private readonly ClayNumberOptions _batteryOptions = new() { Required = true, Min = 0, DraftKey = "ups-test.battery" };
    private readonly ClayGridOptions _serverGridOptions = new()
    {
        Id = "ups-test-servers",
        Class = "equipment-detail-grid",
        EmptyText = "Нет серверов для выбора",
        ShowToolbar = false,
        ShowPagination = false,
        AutoHeight = true,
        AllowColumnReorder = false,
        AllowSorting = false,
        ColumnMenuMode = ColumnMenuMode.Hidden,
    };
    private readonly ClayTextAreaOptions _issuesOptions = new() { MaxLength = 4000, Lines = 3, DraftKey = "ups-test.issues" };
    private readonly List<UpsTestServerSelectionItem> _selectedServers = [];
    private bool _selectionInitialized;
    private string? _error;
    private EquipmentUpsTestDraft? _lastPublishedDraft;
    private bool _restorePending;
    private bool _restoreAttempted;
    private bool _restoringRaw;
    private bool RawNotReady => RestoreRaw is not null && (!_restoreAttempted || _restoringRaw || _restorePending);

    /// <summary>Стабильная raw-область вложенного теста.</summary>
    [Parameter] public string? DraftScope { get; set; }

    /// <summary>Класс зарегистрированного DOM-владельца.</summary>
    [Parameter] public string? DraftOwnerClass { get; set; }

    /// <summary>Исходный тест до изменений.</summary>
    [Parameter] public UpsTest? Original { get; set; }

    /// <summary>Публикует typed ввод до подтверждения.</summary>
    [Parameter] public Func<EquipmentUpsTestDraft, Task>? PublishDraft { get; set; }

    /// <summary>Восстанавливает raw ввод после готовности DOM.</summary>
    [Parameter] public Func<Task<bool>>? RestoreRaw { get; set; }

    /// <summary>Проверяет готовность ввода перед принятием.</summary>
    [Parameter] public Func<Task<bool>>? CanAcceptDraft { get; set; }

    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;

    /// <summary>Редактируемый тест.</summary>
    [Parameter] public UpsTest Value { get; set; } = new();

    /// <summary>Серверы текущего UPS, доступные для выбора.</summary>
    [Parameter] public IReadOnlyList<UpsServerLink> AvailableServers { get; set; } = [];

    /// <summary>Дата тестирования.</summary>
    [Parameter] public DateTime? Date { get; set; }

    /// <summary>Время тестирования.</summary>
    [Parameter] public TimeSpan? Time { get; set; }

    private IReadOnlyList<UpsTestServerSelectionItem> ServerRows =>
        UpsTestServerSelection.BuildRows(_selectedServers, AvailableServers);

    private IReadOnlyList<string> UncheckedServerNames => ServerRows
        .Where(row => row.IsRecognized && !row.IsChecked)
        .Select(row => row.Name)
        .ToArray();

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (_selectionInitialized)
            return;
        _selectedServers.AddRange(UpsTestServerSelection.ParseSelected(
            Value.Servers, UpsTestServerSelection.AvailableNames(AvailableServers)));
        _selectionInitialized = true;
    }

    private void ToggleServer(UpsTestServerSelectionItem item) =>
        UpsTestServerSelection.Toggle(_selectedServers, item);

    private void Cancel() => Dialog.Cancel();

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && RestoreRaw is not null)
        {
            await RetryRawAsync();
            if (_restorePending)
                await RetryRawAsync();
        }
        if (PublishDraft is null || Original is null)
            return;

        var state = new EquipmentUpsTestDraft(Original, Date, Time, Value.BatteryTime,
            UpsTestServerSelection.Format(_selectedServers), Value.Issues);
        if (state == _lastPublishedDraft)
            return;
        try
        {
            await PublishDraft(state);
            _lastPublishedDraft = state;
        }
        catch (Exception ex) when (ex is InvalidOperationException or Microsoft.JSInterop.JSException or
            Microsoft.JSInterop.JSDisconnectedException or OperationCanceledException)
        {
            const string message = "Не удалось сохранить черновик теста UPS.";
            if (_error != message)
            {
                _error = message;
                StateHasChanged();
            }
        }
    }

    private async Task RetryRawAsync()
    {
        if (!RawNotReady || _restoringRaw)
            return;
        _restoringRaw = true;
        _restoreAttempted = true;
        try
        {
            _restorePending = RestoreRaw is not null && !await RestoreRaw();
        }
        catch (Exception ex) when (ex is InvalidOperationException or Microsoft.JSInterop.JSException or
            Microsoft.JSInterop.JSDisconnectedException or OperationCanceledException)
        {
            _restorePending = true;
        }
        finally { _restoringRaw = false; }
        _error = _restorePending ? "Восстановление ввода теста UPS не завершено." : null;
        StateHasChanged();
    }

    private async Task Apply()
    {
        try
        {
            if (RawNotReady || CanAcceptDraft is not null && !await CanAcceptDraft())
            {
                _error = "Сначала восстановите ввод теста UPS.";
                return;
            }
        }
        catch (Exception ex) when (ex is InvalidOperationException or Microsoft.JSInterop.JSException or
            Microsoft.JSInterop.JSDisconnectedException or OperationCanceledException)
        {
            _error = "Не удалось проверить черновик теста UPS.";
            return;
        }
        if (Date is null || Time is null)
        {
            _error = "Укажите дату и время тестирования.";
            return;
        }
        Value.Servers = UpsTestServerSelection.Format(_selectedServers);
        var issues = UpsTestServerSelection.PatchIssues(Value.Issues, ServerRows);
        if (issues.Length > _issuesOptions.MaxLength)
        {
            _error = $"Не удалось дописать в поле с \"Ошибками\" список серверов, не получивших уведомление: {string.Join(", ", UncheckedServerNames)}";
            return;
        }
        Value.Issues = issues;
        Value.TestedAt = Date.Value.Date.Add(Time.Value);
        Dialog.Close(DialogResult.Ok(Value));
    }
}
