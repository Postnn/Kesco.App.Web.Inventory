@inherits EquipmentEditorDialogBase<EquipmentLocationDialogResult>
@implements IEquipmentDeferredRawRestore
@using Clayzor.Lib.Entities.Inventory
@using Clayzor.Lib.Web.Controls.Components.Form
@using Clayzor.Lib.Web.Controls.Components.Select
@using Clayzor.Lib.Web.DBSelect.Employees
@using Clayzor.Lib.Web.DBSelect.Locations
@using Kesco.App.Web.Inventory.Components.Layout
@inject LocationSelectDataSource LocationSource
@inject EmployeeSelectDataSource EmployeeSource
@inject Kesco.App.Web.Inventory.Services.EquipmentFormService Service
@inject IConfiguration Configuration
@inject IJSRuntime JS

<MudDialog>
    <TitleContent>@(IsEdit ? "Изменение расположения" : "Новое расположение")</TitleContent>
    <DialogContent>
        <ClayFormActions Form="InventoryFormHelp.EquipmentLocation" />
        @RawRestoreNotice
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error">@_error</MudAlert>
        }
        <div class="equipment-ins-row">
            <span class="equipment-ins-label">Расположение:</span>
            <ClaySelect TItem="LocationLookup" TValue="int?"
                        DataSource="LocationSource"
                        ValueSelector="@(item => (int?)item.Id)"
                        TextSelector="@(item => item.Name)"
                        @bind-Value="LocationId"
                        SelectedItemChanged="OnLocationChangedAsync"
                        Options="_locationOptions" />
        </div>
        @if (_advisoryError is not null)
        {
            <MudAlert Severity="Severity.Warning">@_advisoryError</MudAlert>
        }
        @if (_advisories.Count > 0)
        {
            <MudAlert Severity="Severity.Info">
                На этом рабочем месте уже находится другое оборудование этой группы:
                @string.Join("; ", _advisories.Select(item => item.DisplayText)).
            </MudAlert>
        }
        <div class="equipment-ins-row">
            <span class="equipment-ins-label">С:</span>
            <div class="equipment-ins-date">
                <ClayDatePicker @bind-Value="FromDate" Options="_fromDateOptions" />
                <ClayTime @bind-Value="FromTime" Options="_fromTimeOptions" />
            </div>
        </div>
        @if (ResponsibleRequired)
        {
            <div class="equipment-ins-row">
                <span class="equipment-ins-label">Ответственный:</span>
                <ClaySelect TItem="Employee" TValue="int?"
                            DataSource="EmployeeSource"
                            ValueSelector="@(item => (int?)item.Id)"
                            TextSelector="@(item => item.Name)"
                            ViewItem="EmployeeViewItem"
                            @bind-Value="EmployeeId"
                            Options="_employeeOptions" />
            </div>
        }
        <div class="equipment-ins-row">
            <span class="equipment-ins-label">Срок возврата:</span>
            <ClayDatePicker @bind-Value="ReturnDate" Options="_returnDateOptions" />
        </div>
        <div class="equipment-ins-row">
            <span class="equipment-ins-label">Примечания:</span>
            <ClayTextArea @bind-Value="Notes" Options="_notesOptions" />
        </div>
    </DialogContent>
    <DialogActions>
        <ClayToolbarButton Options="_cancelButtonOptions" OnClick="Cancel" Disabled="@_saving" />
        <ClayToolbarButton Options="_okButtonOptions" OnClick="Apply" Disabled="@(_saving || _saveBlocked || RawRestoreBlocked)" />
    </DialogActions>
</MudDialog>

@code {
    private readonly ClayToolbarButtonOptions _cancelButtonOptions = new() { Text = "Отмена" };
    private readonly ClayToolbarButtonOptions _okButtonOptions = new() { Text = "OK", Color = Color.Primary, Variant = Variant.Filled };
    private readonly ClaySelectOptions _locationOptions = new() { Required = true, AutoSelectSingle = true, Placeholder = "Выберите расположение", DraftKey = "location.location" };
    private readonly ClaySelectOptions _employeeOptions = new() { Required = true, AutoSelectSingle = true, Placeholder = "Выберите сотрудника", DraftKey = "location.employee" };
    private readonly ClayDatePickerOptions _fromDateOptions = new() { Required = true, DraftKey = "location.from-date" };
    private readonly ClayTimeOptions _fromTimeOptions = new() { Required = true, DraftKey = "location.from-time" };
    private readonly ClayDatePickerOptions _returnDateOptions = new() { DraftKey = "location.return-date" };
    private readonly ClayTextAreaOptions _notesOptions = new() { MaxLength = 300, Lines = 3, DraftKey = "location.notes" };
    private IReadOnlyList<EquipmentWorkplaceAdvisoryItem> _advisories = [];
    private string? _advisoryError;
    private int _advisoryVersion;

    /// <summary>Идентификатор текущего оборудования.</summary>
    [Parameter] public int EquipmentId { get; set; }

    /// <summary>Признак редактирования существующего периода.</summary>
    [Parameter] public bool IsEdit { get; set; }

    /// <summary>Требуется одновременно назначить ответственного.</summary>
    [Parameter] public bool RequireResponsible { get; set; }

    /// <summary>Текущее локальное время браузера на момент открытия.</summary>
    [Parameter] public DateTime Now { get; set; } = DateTime.Now;

    /// <summary>Получает актуальное локальное время браузера при Apply.</summary>
    [Parameter] public Func<Task<DateTime>>? GetNow { get; set; }

    /// <summary>Идентификатор расположения.</summary>
    [Parameter] public int? LocationId { get; set; }

    /// <summary>Идентификатор ответственного сотрудника.</summary>
    [Parameter] public int? EmployeeId { get; set; }

    /// <summary>Дата начала периода.</summary>
    [Parameter] public DateTime? FromDate { get; set; }

    /// <summary>Время начала периода.</summary>
    [Parameter] public TimeSpan? FromTime { get; set; }

    /// <summary>Срок возврата.</summary>
    [Parameter] public DateTime? ReturnDate { get; set; }

    /// <summary>Примечания.</summary>
    [Parameter] public string Notes { get; set; } = string.Empty;

    /// <summary>Исходный baseline, восстанавливаемый независимо от fresh read.</summary>
    [Parameter] public EquipmentPeriodOriginal? Original { get; set; }

    /// <summary>Свежая строка для сверки; не заменяет <see cref="Original"/>.</summary>
    [Parameter] public EquipmentLocationPeriod? FreshOriginal { get; set; }

    /// <summary>Признак активности свежей исходной строки.</summary>
    [Parameter] public bool FreshOriginalActive { get; set; }

    private bool _originalInitialized;
    private bool ResponsibleRequired => RequireResponsible && LocationId == (int)Clayzor.Lib.Entities.Расположения.На_руках;

    private Func<Employee, Task>? EmployeeViewItem =>
        !string.IsNullOrWhiteSpace(Configuration["URI_user_form"]) ? OpenEmployeeViewAsync : null;

    private async Task OpenEmployeeViewAsync(Employee employee) =>
        await JS.InvokeVoidAsync("clayOpen", EquipmentIns.BuildEditUrl(Configuration["URI_user_form"]!, employee.Id), "_blank");

    private async Task OnLocationChangedAsync(LocationLookup? location)
    {
        if (IsEdit || LocationId is null)
        {
            _advisories = [];
            _advisoryError = null;
            return;
        }
        var version = ++_advisoryVersion;
        var locationId = LocationId.Value;
        _advisoryError = null;
        try
        {
            var items = await Service.GetWorkplaceAdvisoryAsync(EquipmentId, locationId);
            if (!IsEditorCurrent() || version != _advisoryVersion || LocationId != locationId)
                return;
            _advisories = items;
        }
        catch (Exception ex) when (ex is Microsoft.Data.SqlClient.SqlException or InvalidOperationException or UnauthorizedAccessException)
        {
            if (IsEditorCurrent() && version == _advisoryVersion && LocationId == locationId)
                _advisoryError = "Не удалось проверить другое оборудование на рабочем месте. Операция расположения остаётся доступной.";
        }
        if (IsEditorCurrent() && version == _advisoryVersion && LocationId == locationId)
            await InvokeAsync(StateHasChanged);
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        _locationOptions.ReadOnly = IsEdit;
        _fromDateOptions.ReadOnly = IsEdit;
        _fromDateOptions.Disabled = IsEdit;
        _fromTimeOptions.ReadOnly = IsEdit;
        _fromTimeOptions.Disabled = IsEdit;
        if (!_originalInitialized && (Original is not null || FreshOriginal is not null))
        {
            Original ??= EquipmentPeriodOriginal.FromLocation(FreshOriginal!, FreshOriginalActive);
            _originalInitialized = true;
        }
    }

    private async Task Apply()
    {
        var now = GetNow is null ? Now : await GetNow();
        if (!IsEditorCurrent())
            return;
        var from = (FromDate ?? now.Date).Date.Add(FromTime ?? TimeSpan.Zero);
        var draft = new EquipmentLocationDialogResult(
            LocationId ?? 0, from, ReturnDate, Notes ?? string.Empty, ResponsibleRequired ? EmployeeId : null)
        {
            Original = Original,
        };
        await ApplyAsync(draft, () => Validate(from, now));
    }

    private string? Validate(DateTime from, DateTime now)
    {
        if (IsEdit)
        {
            if (Original is null)
                return "Исходный период расположения не подтверждён. Черновик сохранён; запись не отправлена.";
            var conflict = Original.ValidateFresh(FreshOriginal, FreshOriginalActive);
            if (conflict is not null)
                return conflict;
        }
        else
        {
            if (LocationId is null || FromDate is null || FromTime is null)
                return "Укажите расположение, дату и время начала.";
            if (ResponsibleRequired && EmployeeId is null)
                return "Для расположения «На руках» укажите ответственного сотрудника.";
            if (from > now)
                return "Дата и время начала не могут быть в будущем.";
        }
        if (ReturnDate is not null && (ReturnDate.Value.Date < from.Date || ReturnDate.Value.Date > now.Date.AddMonths(3)))
            return "Срок возврата должен быть не раньше даты начала и не позднее трёх месяцев.";
        return null;
    }
}
