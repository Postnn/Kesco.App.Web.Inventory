@inherits EquipmentEditorDialogBase<EquipmentComputerSnapshot>
@using Clayzor.Lib.Entities.Inventory
@using Clayzor.Lib.Web.Controls.Components.Form

<MudDialog>
    <TitleContent>Конфигурация компьютера</TitleContent>
    <DialogContent>
        @if (!string.IsNullOrWhiteSpace(_loadError))
        {
            <MudAlert Severity="Severity.Error">@_loadError</MudAlert>
        }
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error">@_error</MudAlert>
        }
        <div class="equipment-ins-row">
            <span class="equipment-ins-label">RAM, Мб:</span>
            <div class="equipment-computer-components">
                @foreach (var row in ComponentRows(RamSlots, DeletedRamSlots))
                {
                    if (row.Index is int index)
                    {
                        <div class="equipment-computer-number d-flex gap-1">
                            <ClayNumber Value="Ram[index]" ValueChanged="value => Ram[index] = value" Options="_ramOptions" />
                            @if (index >= MemoryBanks)
                            {
                                <ClayButton Icon="@Icons.Material.Filled.Delete" Text="Удалить лишний компонент RAM" OnClick="() => RemoveComponent(Ram, RamSlots, DeletedRamSlots, index)" />
                            }
                        </div>
                    }
                    else
                    {
                        <div hidden><ClayNumber Value="(decimal?)null" Options="_ramTombstoneOptions" /></div>
                    }
                }
            </div>
        </div>
        <div class="equipment-ins-row">
            <span class="equipment-ins-label">HD, Гб:</span>
            <div class="equipment-computer-components">
                <ClayButton Icon="@Icons.Material.Filled.Add" Text="Добавить HD" Class="equipment-add-hd" OnClick="AddHd" />
                @foreach (var row in ComponentRows(HdSlots, DeletedHdSlots))
                {
                    if (row.Index is int index)
                    {
                        <div class="equipment-computer-number d-flex gap-1">
                            <ClayNumber Value="Hd[index]" ValueChanged="value => Hd[index] = value" Options="_diskOptions" />
                            <ClayButton Icon="@Icons.Material.Filled.Delete" Text="Удалить компонент HD" OnClick="() => RemoveComponent(Hd, HdSlots, DeletedHdSlots, index)" />
                        </div>
                    }
                    else
                    {
                        <div hidden><ClayNumber Value="(decimal?)null" Options="_diskTombstoneOptions" /></div>
                    }
                }
            </div>
        </div>
        <div class="equipment-ins-row">
            <span class="equipment-ins-label">SSD, Гб:</span>
            <div class="equipment-computer-components">
                <ClayButton Icon="@Icons.Material.Filled.Add" Text="Добавить SSD" Class="equipment-add-ssd" OnClick="AddSsd" />
                @foreach (var row in ComponentRows(SsdSlots, DeletedSsdSlots))
                {
                    if (row.Index is int index)
                    {
                        <div class="equipment-computer-number d-flex gap-1">
                            <ClayNumber Value="Ssd[index]" ValueChanged="value => Ssd[index] = value" Options="_ssdOptions" />
                            <ClayButton Icon="@Icons.Material.Filled.Delete" Text="Удалить компонент SSD" OnClick="() => RemoveComponent(Ssd, SsdSlots, DeletedSsdSlots, index)" />
                        </div>
                    }
                    else
                    {
                        <div hidden><ClayNumber Value="(decimal?)null" Options="_ssdTombstoneOptions" /></div>
                    }
                }
            </div>
        </div>
        <div class="equipment-ins-row">
            <span class="equipment-ins-label">Конфигурация 1:</span>
            <div class="equipment-computer-configuration">
                <ClayDropDownList TItem="StandardConfiguration" TValue="int?"
                                  Items="Configurations"
                                  ValueSelector="@(item => (int?)item.Id)"
                                  TextSelector="@(item => item.Name)"
                                  @bind-Value="Configuration1Id" />
                <ClayDatePicker @bind-Value="Configuration1Date" />
            </div>
        </div>
        <div class="equipment-ins-row">
            <span class="equipment-ins-label">Конфигурация 2:</span>
            <div class="equipment-computer-configuration">
                <ClayDropDownList TItem="StandardConfiguration" TValue="int?"
                                  Items="Configurations"
                                  ValueSelector="@(item => (int?)item.Id)"
                                  TextSelector="@(item => item.Name)"
                                  @bind-Value="Configuration2Id" />
                <ClayDatePicker @bind-Value="Configuration2Date" />
            </div>
        </div>
        <div class="equipment-ins-row">
            <span class="equipment-ins-label">Лицензия:</span>
            <ClayTextBox @bind-Value="License" Options="_licenseOptions" />
        </div>
        <div class="equipment-ins-row">
            <span class="equipment-ins-label">Примечания:</span>
            <ClayTextArea @bind-Value="Notes" Options="_notesOptions" />
        </div>
    </DialogContent>
    <DialogActions>
        <ClayToolbarButton Options="_cancelButtonOptions" OnClick="Cancel" Disabled="@_saving" />
        <ClayToolbarButton Options="_okButtonOptions" OnClick="Apply" Disabled="@(_saving || _saveBlocked || _loadError is not null)" />
    </DialogActions>
</MudDialog>

@code {
    private readonly ClayToolbarButtonOptions _cancelButtonOptions = new() { Text = "Отмена" };
    private readonly ClayToolbarButtonOptions _okButtonOptions = new() { Text = "OK", Color = Color.Primary, Variant = Variant.Filled };
    private readonly ClayNumberOptions _ramOptions = new() { Min = 0, Precision = 0, DraftKey = "computer.ram" };
    private readonly ClayNumberOptions _ssdOptions = new() { Min = 0, Precision = 0, DraftKey = "computer.ssd" };
    private readonly ClayNumberOptions _diskOptions = new() { Min = 0, Precision = 2, Step = 0.5m, DraftKey = "computer.hd" };
    private readonly ClayNumberOptions _ramTombstoneOptions = new() { Disabled = true, DraftKey = "computer.ram" };
    private readonly ClayNumberOptions _ssdTombstoneOptions = new() { Disabled = true, DraftKey = "computer.ssd" };
    private readonly ClayNumberOptions _diskTombstoneOptions = new() { Disabled = true, DraftKey = "computer.hd" };
    private readonly ClayTextBoxOptions _licenseOptions = new() { MaxLength = 50, DraftKey = "computer.license" };
    private readonly ClayTextAreaOptions _notesOptions = new() { MaxLength = 300, Lines = 3, DraftKey = "computer.notes" };
    private bool _initialized;
    private string? _loadError;

    [Inject] private ILogger<EquipmentComputerDialog> Logger { get; set; } = default!;

    /// <summary>Карточка хранит предыдущую операцию компьютера без подтверждённого результата.</summary>
    [Parameter] public bool HasUnresolvedComputerOperation { get; set; }

    /// <summary>Идентификатор оборудования.</summary>
    [Parameter] public int EquipmentId { get; set; }

    /// <summary>Дата дневного снимка.</summary>
    [Parameter] public DateTime Date { get; set; }

    /// <summary>Признак существования дневного снимка при открытии.</summary>
    [Parameter] public bool ExpectedExisting { get; set; }

    /// <summary>Исходное время изменения дневного снимка.</summary>
    [Parameter] public DateTime ChangedAt { get; set; }

    /// <summary>Максимальное число банков RAM.</summary>
    [Parameter] public int MemoryBanks { get; set; }

    /// <summary>Сериализованные компоненты RAM.</summary>
    [Parameter] public string RamDetail { get; set; } = string.Empty;

    /// <summary>Сериализованные компоненты HD.</summary>
    [Parameter] public string HdDetail { get; set; } = string.Empty;

    /// <summary>Сериализованные компоненты SSD.</summary>
    [Parameter] public string SsdDetail { get; set; } = string.Empty;

    /// <summary>Первая конфигурация.</summary>
    [Parameter] public int? Configuration1Id { get; set; }

    /// <summary>Дата первой конфигурации.</summary>
    [Parameter] public DateTime? Configuration1Date { get; set; }

    /// <summary>Вторая конфигурация.</summary>
    [Parameter] public int? Configuration2Id { get; set; }

    /// <summary>Дата второй конфигурации.</summary>
    [Parameter] public DateTime? Configuration2Date { get; set; }

    /// <summary>Лицензия.</summary>
    [Parameter] public string License { get; set; } = string.Empty;

    /// <summary>Примечания.</summary>
    [Parameter] public string Notes { get; set; } = string.Empty;

    /// <summary>Стандартные конфигурации.</summary>
    [Parameter] public IReadOnlyList<StandardConfiguration> Configurations { get; set; } = [];

    /// <summary>Редактируемые компоненты RAM.</summary>
    public List<decimal?> Ram { get; } = [];

    /// <summary>Редактируемые компоненты HD.</summary>
    public List<decimal?> Hd { get; } = [];

    /// <summary>Редактируемые компоненты SSD.</summary>
    public List<decimal?> Ssd { get; } = [];

    /// <summary>Клиентская календарная дата для проверки конфигураций.</summary>
    [Parameter] public DateTime Today { get; set; } = DateTime.Today;

    /// <summary>Возвращает актуальную business date перед проверкой конфигурации.</summary>
    [Parameter] public Func<Task<DateTime>>? GetToday { get; set; }

    internal List<int> RamSlots { get; } = [];
    internal List<int> HdSlots { get; } = [];
    internal List<int> SsdSlots { get; } = [];
    internal HashSet<int> DeletedRamSlots { get; } = [];
    internal HashSet<int> DeletedHdSlots { get; } = [];
    internal HashSet<int> DeletedSsdSlots { get; } = [];

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (_initialized)
            return;
        _initialized = true;
        if (HasUnresolvedComputerOperation)
        {
            _saveBlocked = true;
            _error = "Результат предыдущего сохранения конфигурации не подтверждён. Повторная запись заблокирована.";
        }
        try
        {
            var ram = EquipmentComputerDetail.Parse(RamDetail);
            Ram.AddRange(ram.Select(value => (decimal?)value));
            while (Ram.Count < MemoryBanks)
                Ram.Add(0);
            Hd.AddRange(EquipmentComputerDetail.Parse(HdDetail).Select(value => (decimal?)value));
            Ssd.AddRange(EquipmentComputerDetail.Parse(SsdDetail).Select(value => (decimal?)value));
            InitializeSlots(RamSlots, Ram.Count);
            InitializeSlots(HdSlots, Hd.Count);
            InitializeSlots(SsdSlots, Ssd.Count);
        }
        catch (FormatException ex)
        {
            _loadError = ex.Message;
        }
    }

    private async Task Apply()
    {
        if (_saveBlocked || _loadError is not null)
            return;
        var today = GetToday is null ? Today : (await GetToday()).Date;
        if (!IsEditorCurrent())
            return;
        Logger.LogInformation("ComputerApply start EquipmentId={EquipmentId}, Ram={RamCount}, Hd={HdCount}, Ssd={SsdCount}",
            EquipmentId, Ram.Count, Hd.Count, Ssd.Count);
        try
        {
            var snapshot = new EquipmentComputerSnapshot
            {
                EquipmentId = EquipmentId,
                Date = Date,
                ExpectedExisting = ExpectedExisting,
                ChangedAt = ChangedAt,
                RamComponents = Values(Ram),
                HdComponents = Values(Hd),
                SsdComponents = Values(Ssd),
                Configuration1Id = Configuration1Id,
                Configuration1Date = Configuration1Date,
                Configuration2Id = Configuration2Id,
                Configuration2Date = Configuration2Date,
                License = License ?? string.Empty,
                Notes = Notes ?? string.Empty,
            };
            snapshot.RamDetail = EquipmentComputerDetail.Serialize(snapshot.RamComponents, false);
            snapshot.HdDetail = EquipmentComputerDetail.Serialize(snapshot.HdComponents, true);
            snapshot.SsdDetail = EquipmentComputerDetail.Serialize(snapshot.SsdComponents, false);
            await ApplyAsync(snapshot, () => snapshot.ValidateConfiguration(today, MemoryBanks));
            Logger.LogInformation("ComputerApply completed EquipmentId={EquipmentId}", EquipmentId);
        }
        catch (Exception ex) when (ex is FormatException or OverflowException)
        {
            Logger.LogWarning(ex, "ComputerApply validation failed EquipmentId={EquipmentId}", EquipmentId);
            _error = ex.Message;
        }
        catch (System.Data.SqlTypes.SqlTypeException ex)
        {
            Logger.LogError(ex, "ComputerApply SQL type validation failed EquipmentId={EquipmentId}", EquipmentId);
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "ComputerApply failed EquipmentId={EquipmentId}", EquipmentId);
            throw;
        }
    }

    private void AddHd() => AddComponent(Hd, HdSlots, DeletedHdSlots);

    private void AddSsd() => AddComponent(Ssd, SsdSlots, DeletedSsdSlots);

    private static void InitializeSlots(ICollection<int> slots, int count)
    {
        for (var slot = 0; slot < count; slot++)
            slots.Add(slot);
    }

    private static void AddComponent(ICollection<decimal?> values, ICollection<int> slots, ISet<int> deleted)
    {
        values.Add(0);
        var next = slots.Concat(deleted).Select(slot => (int?)slot).Max() + 1 ?? 0;
        slots.Add(next);
    }

    private static void RemoveComponent(IList<decimal?> values, IList<int> slots, ISet<int> deleted, int index)
    {
        deleted.Add(slots[index]);
        values.RemoveAt(index);
        slots.RemoveAt(index);
    }

    private static IEnumerable<ComponentRow> ComponentRows(IList<int> slots, ISet<int> deleted) =>
        slots.Concat(deleted).OrderBy(slot => slot).Select(slot =>
            new ComponentRow(slots.IndexOf(slot) is var index && index >= 0 ? index : null));

    private static IReadOnlyList<decimal> Values(IEnumerable<decimal?> values) =>
        values.Where(value => value is not null).Select(value => value!.Value).ToList();

    private sealed record ComponentRow(int? Index);
}
