@inherits EquipmentEditorDialogBase<EquipmentAccounting>
@implements IEquipmentDeferredRawRestore
@using Clayzor.Lib.Entities.Inventory
@using Clayzor.Lib.Web.Controls.Components.Form
@using Clayzor.Lib.Web.Controls.Components.Select
@using Clayzor.Lib.Web.DBSelect.Equipment
@using Clayzor.Lib.Web.DBSelect.Persons
@using Kesco.App.Web.Inventory.Components.Layout
@inject AccountingPersonSelectDataSource OwnerSource
@inject PersonSelectDataSource TenantSource
@inject IServiceProvider Services

<MudDialog>
    <TitleContent>Бухгалтерский учёт</TitleContent>
    <DialogContent>
        <ClayFormActions Form="InventoryFormHelp.EquipmentAccounting" />
        @EditorPresence
        @{ var baseline = OpeningFieldValue<EquipmentAccounting>(nameof(Value)); }
        <ClayEditorFocusScope @key="ScopedInputVersion" Label="Бухгалтерский учёт" Ready="@(IsEditorCurrent() && !_saving && !_saveBlocked && !RawRestoreBlocked)" Inert="@CancelPending" AdvanceOnEnter="true">
            @RawRestoreNotice
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error">@_error</MudAlert>
            }
            <div class="equipment-ins-row">
                <span class="equipment-ins-label">Владелец:</span>
                <ClayFieldChange Changed="@(baseline is not null && Value.OwnerId != baseline.OwnerId)" WatchLookupRaw="true">
                    <ClaySelect TItem="PersonLookup" TValue="int?"
                                DataSource="OwnerSource"
                                ValueSelector="@(item => (int?)item.Id)"
                                TextSelector="@(item => item.Name)"
                                @bind-Value="Value.OwnerId"
                                SelectedItemChanged="OnOwnerChanged"
                                Options="_ownerOptions" />
                </ClayFieldChange>
            </div>
            <div class="equipment-ins-row">
                <span class="equipment-ins-label">Тип:</span>
                <ClayFieldChange Changed="@(baseline is not null && Value.IsMaterial != baseline.IsMaterial)">
                    <ClayCheckbox State="Value.IsMaterial" StateChanged="OnMaterialChanged" Label="Материал (иначе — основное средство)" />
                </ClayFieldChange>
            </div>
            @if (!Value.IsMaterial)
            {
                <div class="equipment-ins-row">
                    <span class="equipment-ins-label">Арендатор:</span>
                    <ClayFieldChange Changed="@(baseline is not null && Value.TenantId != baseline.TenantId)" WatchLookupRaw="true">
                        <ClaySelect TItem="PersonLookup" TValue="int?"
                                    DataSource="TenantSource"
                                    ValueSelector="@(item => (int?)item.Id)"
                                    TextSelector="@(item => item.Name)"
                                    @bind-Value="Value.TenantId"
                                    Options="_tenantOptions" />
                    </ClayFieldChange>
                </div>
                <div class="equipment-ins-row">
                    <span class="equipment-ins-label">Инв. номер:</span>
                    <ClayFieldChange Changed="@(baseline is not null && Value.InventoryNumber != baseline.InventoryNumber)" RawBaseline="@(baseline is null ? null : baseline.InventoryNumber ?? string.Empty)">
                        <ClayTextBox @bind-Value="Value.InventoryNumber" Options="_inventoryOptions" />
                    </ClayFieldChange>
                </div>
            }
            <div class="equipment-ins-row">
                <span class="equipment-ins-label">Поступление:</span>
                <div class="equipment-accounting-date-document">
                    <ClayFieldChange Changed="@(baseline is not null && Value.DateFrom?.Date != baseline.DateFrom?.Date)" RawBaseline="@(baseline is null ? null : ((DateTime?)baseline.DateFrom)?.ToString(_fromOptions.DateFormat) ?? string.Empty)">
                        <ClayDatePicker @bind-Value="Value.DateFrom" Options="_fromOptions" />
                    </ClayFieldChange>
                    <ClayFieldChange Changed="@(baseline is not null && Value.ReceiptDocumentId != baseline.ReceiptDocumentId)" WatchLookupRaw="true">
                        <ClaySelect TItem="DocumentLookup" TValue="int?"
                                    DataSource="ReceiptSource"
                                    ValueSelector="@(item => (int?)item.Id)"
                                    TextSelector="@(item => item.Name)"
                                    @bind-Value="Value.ReceiptDocumentId"
                                    Options="_documentOptions" />
                    </ClayFieldChange>
                </div>
            </div>
            <div class="equipment-ins-row">
                <span class="equipment-ins-label">Списание:</span>
                <div class="equipment-accounting-date-document">
                    <ClayFieldChange Changed="@(baseline is not null && Value.DateTo?.Date != baseline.DateTo?.Date)" RawBaseline="@(baseline is null ? null : ((DateTime?)baseline.DateTo)?.ToString(new ClayDatePickerOptions().DateFormat) ?? string.Empty)">
                        <ClayDatePicker @bind-Value="Value.DateTo" />
                    </ClayFieldChange>
                    <ClayFieldChange Changed="@(baseline is not null && Value.WriteOffDocumentId != baseline.WriteOffDocumentId)" WatchLookupRaw="true">
                        <ClaySelect TItem="DocumentLookup" TValue="int?"
                                    DataSource="WriteOffSource"
                                    ValueSelector="@(item => (int?)item.Id)"
                                    TextSelector="@(item => item.Name)"
                                    @bind-Value="Value.WriteOffDocumentId"
                                    Options="_documentOptions" />
                    </ClayFieldChange>
                </div>
            </div>
            <div class="equipment-ins-row">
                <span class="equipment-ins-label">Примечания:</span>
                <ClayFieldChange Changed="@(baseline is not null && Value.Notes != baseline.Notes)" RawBaseline="@(baseline is null ? null : baseline.Notes ?? string.Empty)">
                    <ClayTextArea @bind-Value="Value.Notes" Options="_notesOptions" />
                </ClayFieldChange>
            </div>
        </ClayEditorFocusScope>
    </DialogContent>
    <DialogActions>
        <ClayToolbarButton Options="_cancelButtonOptions" OnClick="CancelScopedAsync" Disabled="@(_saving || CancelPending)" />
        <ClayToolbarButton Options="_okButtonOptions" OnClick="Apply" Disabled="@(_saving || CancelPending || _saveBlocked || RawRestoreBlocked)" />
    </DialogActions>
</MudDialog>

@code {
    private readonly ClayToolbarButtonOptions _cancelButtonOptions = new() { Text = "Отмена" };
    private readonly ClayToolbarButtonOptions _okButtonOptions = new() { Text = "OK", Color = Color.Primary, Variant = Variant.Filled };
    private readonly ClaySelectOptions _ownerOptions = new() { AdvanceFocusOnSelection = true, Required = true, AutoSelectSingle = true, Placeholder = "Выберите владельца", DraftKey = "accounting.owner" };
    private readonly ClaySelectOptions _tenantOptions = new() { AdvanceFocusOnSelection = true, AutoSelectSingle = true, Placeholder = "Выберите арендатора", DraftKey = "accounting.tenant" };
    private readonly ClaySelectOptions _documentOptions = new() { AdvanceFocusOnSelection = true, AutoSelectSingle = true, Placeholder = "Выберите документ", DraftKey = "accounting.document" };
    private readonly ClayTextBoxOptions _inventoryOptions = new() { Required = true, MaxLength = 50, DraftKey = "accounting.inventory-number" };
    private readonly ClayDatePickerOptions _fromOptions = new() { Required = true, DraftKey = "accounting.from" };
    private readonly ClayTextAreaOptions _notesOptions = new() { MaxLength = 255, Lines = 2, DraftKey = "accounting.notes" };
    private bool _ready;

    /// <summary>Редактируемая запись.</summary>
    [Parameter] public EquipmentAccounting Value { get; set; } = new();

    private AccountingDocumentSelectDataSource ReceiptSource => Services.GetRequiredKeyedService<AccountingDocumentSelectDataSource>("accountingReceipt");
    private AccountingDocumentSelectDataSource WriteOffSource => Services.GetRequiredKeyedService<AccountingDocumentSelectDataSource>("accountingWriteOff");

    /// <inheritdoc />
    protected override void OnParametersSet() => ReceiptSource.PersonId = WriteOffSource.PersonId = Value.OwnerId;

    /// <inheritdoc />
    protected override void OnDraftStateRestored() => OnParametersSet();

    /// <inheritdoc />
    protected override void OnAfterRender(bool firstRender) => _ready |= firstRender;

    private void OnOwnerChanged(PersonLookup? owner)
    {
        ReceiptSource.PersonId = WriteOffSource.PersonId = Value.OwnerId;
        if (!_ready)
            return;
        Value.ReceiptDocumentId = null;
        Value.WriteOffDocumentId = null;
    }

    private void OnMaterialChanged(bool? value)
    {
        Value.IsMaterial = value == true;
        Value.ApplyMaterialRules();
    }

    private Task Apply() => ApplyAsync(Value, Value.Validate);
}
