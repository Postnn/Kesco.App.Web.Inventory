@using Clayzor.Lib.Entities.Inventory
@using Clayzor.Lib.Web.Controls.Components.Grid
@using Clayzor.Lib.Web.Controls.Components.Form
@using Kesco.App.Web.Inventory.Components.Layout

<MudDialog>
    <TitleContent>История сетевых имён</TitleContent>
    <DialogContent>
        <ClayFormActions Form="InventoryFormHelp.Equipment" />
        <ClayGrid TEntity="EquipmentNetworkNameHistory" Items="Items" Options="_gridOptions">
            <ColumnDefs>
                <ClayColumnDef ColumnId="1" SqlName="NetworkName" DisplayName="Сетевое имя" />
                <ClayColumnDef ColumnId="2" SqlName="ChangedAt" DisplayName="Изменено" />
                <ClayColumnDef ColumnId="3" SqlName="ChangedBy" DisplayName="Изменил" />
            </ColumnDefs>
            <Columns>
                <ClayColumn TEntity="EquipmentNetworkNameHistory" ColumnId="1" TextSelector="item => item.NetworkName" />
                <ClayColumn TEntity="EquipmentNetworkNameHistory" ColumnId="2" TextSelector="item => FormatDate(item.ChangedAtUtc)" />
                <ClayColumn TEntity="EquipmentNetworkNameHistory" ColumnId="3" TextSelector="item => item.ChangedByName" />
            </Columns>
        </ClayGrid>
    </DialogContent>
    <DialogActions>
        <ClayToolbarButton Options="_closeButtonOptions" OnClick="Close" />
    </DialogActions>
</MudDialog>

@code {
    private readonly ClayToolbarButtonOptions _closeButtonOptions = new() { Text = "Закрыть" };
    private readonly ClayGridOptions _gridOptions = new()
    {
        Id = "equipment-network-history",
        Class = "equipment-detail-grid",
        EmptyText = "История сетевых имён отсутствует",
        ShowAddButton = false,
        ShowToolbar = false,
        ShowPagination = false,
        AutoHeight = true,
        AllowColumnReorder = false,
        AllowSorting = false,
        ColumnMenuMode = ColumnMenuMode.Hidden,
    };

    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;

    /// <summary>Записи истории, отсортированные от новых к старым.</summary>
    [Parameter] public IReadOnlyList<EquipmentNetworkNameHistory> Items { get; set; } = [];

    /// <summary>Преобразование UTC даты в отображаемое локальное время.</summary>
    [Parameter] public Func<DateTime, string> FormatDate { get; set; } = value => value.ToString("dd.MM.yyyy HH:mm:ss");

    private void Close() => Dialog.Cancel();
}
