@inherits EquipmentEditorDialogBase<EquipmentResponsibleDialogResult>
@using Clayzor.Lib.Entities.Inventory
@using Clayzor.Lib.Web.Controls.Components.Form
@using Clayzor.Lib.Web.Controls.Components.Select
@using Clayzor.Lib.Web.DBSelect.Employees
@using Clayzor.Lib.Web.DBSelect.Locations
@inject EmployeeSelectDataSource EmployeeSource
@inject LocationSelectDataSource LocationSource
@inject IConfiguration Configuration
@inject IJSRuntime JS

<MudDialog>
    <TitleContent>@Title</TitleContent>
    <DialogContent>
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error">@_error</MudAlert>
        }
        @if (Mode != EquipmentResponsibleDialogMode.Edit)
        {
            <div class="equipment-ins-row">
                <span class="equipment-ins-label">Сотрудник:</span>
                <ClaySelect TItem="Employee" TValue="int?"
                            DataSource="EmployeeSource"
                            ValueSelector="@(item => (int?)item.Id)"
                            TextSelector="@(item => item.Name)"
                            ViewItem="EmployeeViewItem"
                            @bind-Value="EmployeeId"
                            Options="_employeeOptions" />
            </div>
            <div class="equipment-ins-row">
                <span class="equipment-ins-label">С:</span>
                <div class="equipment-ins-date">
                    <ClayDatePicker @bind-Value="FromDate" Options="_fromDateOptions" />
                    <ClayTime @bind-Value="FromTime" Options="_fromTimeOptions" />
                </div>
            </div>
            @if (Mode == EquipmentResponsibleDialogMode.Withdraw)
            {
                <div class="equipment-ins-row">
                    <span class="equipment-ins-label">По:</span>
                    <div class="equipment-ins-date">
                        <ClayDatePicker @bind-Value="ToDate" Options="_toDateOptions" />
                        <ClayTime @bind-Value="ToTime" Options="_toTimeOptions" />
                    </div>
                </div>
            }
            @if (RequireLocation)
            {
                <div class="equipment-ins-row">
                    <span class="equipment-ins-label">Новое расположение:</span>
                    <ClaySelect TItem="LocationLookup" TValue="int?"
                                DataSource="LocationSource"
                                ValueSelector="@(item => (int?)item.Id)"
                                TextSelector="@(item => item.Name)"
                                @bind-Value="LocationId"
                                Options="_locationOptions" />
                </div>
            }
        }
        <div class="equipment-ins-row">
            <span class="equipment-ins-label">Срок возврата:</span>
            <ClayDatePicker @bind-Value="ReturnDate" Options="_returnDateOptions" />
        </div>
        <div class="equipment-ins-row">
            <span class="equipment-ins-label">Примечания:</span>
            <ClayTextArea @bind-Value="Notes" Options="_notesOptions" />
        </div>
    </DialogContent>
    <DialogActions>
        <ClayToolbarButton Options="_cancelButtonOptions" OnClick="Cancel" Disabled="@_saving" />
        <ClayToolbarButton Options="_okButtonOptions" OnClick="Apply" Disabled="@(_saving || _saveBlocked)" />
    </DialogActions>
</MudDialog>

@code {
    private readonly ClayToolbarButtonOptions _cancelButtonOptions = new() { Text = "Отмена" };
    private readonly ClayToolbarButtonOptions _okButtonOptions = new() { Text = "OK", Color = Color.Primary, Variant = Variant.Filled };
    private readonly ClaySelectOptions _employeeOptions = new() { AutoSelectSingle = true, Placeholder = "Выберите сотрудника", DraftKey = "responsible.employee" };
    private readonly ClaySelectOptions _locationOptions = new() { Required = true, AutoSelectSingle = true, Placeholder = "Выберите расположение", DraftKey = "responsible.location" };
    private readonly ClayDatePickerOptions _fromDateOptions = new() { Required = true, DraftKey = "responsible.from-date" };
    private readonly ClayTimeOptions _fromTimeOptions = new() { Required = true, DraftKey = "responsible.from-time" };
    private readonly ClayDatePickerOptions _toDateOptions = new() { Required = true, DraftKey = "responsible.to-date" };
    private readonly ClayTimeOptions _toTimeOptions = new() { Required = true, DraftKey = "responsible.to-time" };
    private readonly ClayDatePickerOptions _returnDateOptions = new() { DraftKey = "responsible.return-date" };
    private readonly ClayTextAreaOptions _notesOptions = new() { MaxLength = 300, Lines = 3, DraftKey = "responsible.notes" };

    /// <summary>Операция с ответственным.</summary>
    [Parameter] public EquipmentResponsibleDialogMode Mode { get; set; }

    /// <summary>Требуется новое расположение, отличное от «На руках».</summary>
    [Parameter] public bool RequireLocation { get; set; }

    /// <summary>Действующий сотрудник при изъятии.</summary>
    [Parameter] public int? CurrentEmployeeId { get; set; }

    /// <summary>Локальное время браузера на момент открытия; используется без <see cref="GetNow"/>.</summary>
    [Parameter] public DateTime Now { get; set; } = DateTime.Now;

    /// <summary>Возвращает актуальное локальное время браузера при применении редактора.</summary>
    [Parameter] public Func<Task<DateTime>>? GetNow { get; set; }

    /// <summary>Ответственный сотрудник.</summary>
    [Parameter] public int? EmployeeId { get; set; }

    /// <summary>Дата начала периода.</summary>
    [Parameter] public DateTime? FromDate { get; set; }

    /// <summary>Время начала периода.</summary>
    [Parameter] public TimeSpan? FromTime { get; set; }

    /// <summary>Дата окончания периода.</summary>
    [Parameter] public DateTime? ToDate { get; set; }

    /// <summary>Время окончания периода.</summary>
    [Parameter] public TimeSpan? ToTime { get; set; }

    /// <summary>Текущее расположение.</summary>
    [Parameter] public int? LocationId { get; set; }

    /// <summary>Срок возврата.</summary>
    [Parameter] public DateTime? ReturnDate { get; set; }

    /// <summary>Примечания.</summary>
    [Parameter] public string Notes { get; set; } = string.Empty;

    private string Title => Mode switch
    {
        EquipmentResponsibleDialogMode.Issue => "Выдача оборудования",
        EquipmentResponsibleDialogMode.Withdraw => "Изъятие оборудования",
        _ => "Изменение ответственного",
    };
    private string ActionText => Mode == EquipmentResponsibleDialogMode.Withdraw ? "Изъять" : "OK";
    private Func<Employee, Task>? EmployeeViewItem =>
        !string.IsNullOrWhiteSpace(Configuration["URI_user_form"]) ? OpenEmployeeViewAsync : null;

    /// <inheritdoc />
    protected override void OnParametersSet() => _okButtonOptions.Text = ActionText;

    private async Task OpenEmployeeViewAsync(Employee employee) =>
        await JS.InvokeVoidAsync("clayOpen", EquipmentIns.BuildEditUrl(Configuration["URI_user_form"]!, employee.Id), "_blank");

    private async Task Apply()
    {
        var now = GetNow is null ? Now : await GetNow();
        var from = FromDate?.Date.Add(FromTime ?? TimeSpan.Zero);
        var to = ToDate?.Date.Add(ToTime ?? TimeSpan.Zero);
        var draft = new EquipmentResponsibleDialogResult(
            EmployeeId, from, to, ReturnDate, Notes ?? string.Empty, LocationId);
        await ApplyAsync(draft, () => Validate(from, to, now));
    }

    private string? Validate(DateTime? from, DateTime? to, DateTime now)
    {
        if (Mode != EquipmentResponsibleDialogMode.Edit)
        {
            if (Mode == EquipmentResponsibleDialogMode.Issue && (EmployeeId is null || FromDate is null || FromTime is null))
                return "Укажите сотрудника, дату и время выдачи.";
            if (Mode == EquipmentResponsibleDialogMode.Withdraw && (ToDate is null || ToTime is null))
                return "Укажите дату и время изъятия.";
            if (Mode == EquipmentResponsibleDialogMode.Withdraw && EmployeeId is not null && (FromDate is null || FromTime is null))
                return "Для следующего ответственного укажите дату и время начала.";
            if (Mode == EquipmentResponsibleDialogMode.Withdraw && EmployeeId is not null && EmployeeId == CurrentEmployeeId)
                return "Следующий ответственный должен отличаться от действующего.";
            if (RequireLocation && (LocationId is null || LocationId == (int)Clayzor.Lib.Entities.Расположения.На_руках))
                return "Выберите новое расположение, отличное от «На руках».";
        }
        if (from > now || to > now)
            return "Дата и время не могут быть в будущем.";
        var periodStart = Mode == EquipmentResponsibleDialogMode.Withdraw
            ? EmployeeId is not null ? from : to ?? from
            : from;
        if (ReturnDate is not null && periodStart is not null &&
            (ReturnDate.Value.Date < periodStart.Value.Date || ReturnDate.Value.Date > now.Date.AddMonths(3)))
            return "Срок возврата должен быть не раньше начала периода и не позднее трёх месяцев.";
        return null;
    }
}
