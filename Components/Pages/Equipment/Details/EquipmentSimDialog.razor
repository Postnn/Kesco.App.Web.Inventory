@inherits EquipmentEditorDialogBase<EquipmentSimDialogResult>
@using Clayzor.Lib.Entities.Inventory
@using Clayzor.Lib.Web.Controls.Components.Form
@using Clayzor.Lib.Web.Controls.Components.Select
@using Clayzor.Lib.Web.DBSelect.Equipment
@using Kesco.App.Web.Inventory.Components.Layout
@inject MobileContractSelectDataSource ContractSource
@inject PersonalDataPersonSelectDataSource PersonalDataSource
@inject Kesco.App.Web.Inventory.Services.EquipmentFormService Service
@inject IConfiguration Configuration

<MudDialog>
    <TitleContent>SIM-карта</TitleContent>
    <DialogContent>
        <ClayFormActions Form="InventoryFormHelp.EquipmentSim" />
        @EditorPresence
        <div @ref="_sensitiveCancelRoot">
        <ClayEditorFocusScope @key="ScopedInputVersion" Label="SIM-карта" Ready="@(IsEditorCurrent() && !_saving && !_saveBlocked && !RawRestoreBlocked && _ready && !_loading && !_readinessInFlight && _loadError is null && !_versionConflict)" Inert="@CancelPending" AdvanceOnEnter="true">
            @if (!string.IsNullOrWhiteSpace(_loadError))
            {
                <MudAlert Severity="Severity.Error">@_loadError</MudAlert>
            }
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error">@_error</MudAlert>
            }
            <div class="equipment-ins-row">
                <span class="equipment-ins-label">Номер телефона:</span>
                <ClayFieldChange Changed="@IsFieldChanged(nameof(PhoneNumber), PhoneNumber)" RawBaseline="@OpeningFieldText(nameof(PhoneNumber))">
                    <ClayTextBox @bind-Value="PhoneNumber" Options="_phoneOptions" />
                </ClayFieldChange>
            </div>
            <div class="equipment-ins-row">
                <span class="equipment-ins-label">Активация:</span>
                <div class="equipment-ins-date">
                    <ClayFieldChange Changed="@IsFieldChanged(nameof(ActivatedDate), ActivatedDate)" RawBaseline="@OpeningFieldDate(nameof(ActivatedDate), _activationDateOptions.DateFormat)">
                        <ClayDatePicker @bind-Value="ActivatedDate" Options="_activationDateOptions" />
                    </ClayFieldChange>
                    <ClayFieldChange Changed="@IsFieldChanged(nameof(ActivatedTime), ActivatedTime)" RawBaseline="@OpeningFieldTime(nameof(ActivatedTime), _activationTimeOptions.TimeFormat)">
                        <ClayTime @bind-Value="ActivatedTime" Options="_activationTimeOptions" />
                    </ClayFieldChange>
                    <ClayToolbarButton Options="_nowButtonOptions" OnClick="SetActivationNow" Disabled="@_saving" />
                </div>
            </div>
            <div class="equipment-ins-row">
                <span class="equipment-ins-label">Договор:</span>
                <ClayFieldChange Changed="@IsFieldChanged(nameof(ContractId), ContractId)" WatchLookupRaw="true">
                    <ClaySelect TItem="MobileContractLookup" TValue="int?"
                                DataSource="ContractSource"
                                ValueSelector="@(item => (int?)item.Id)"
                                TextSelector="@(item => item.Name)"
                                @bind-Value="ContractId"
                                SelectedItemChanged="OnContractChanged"
                                Options="_contractOptions" />
                </ClayFieldChange>
            </div>
            <div class="equipment-ins-row">
                <span class="equipment-ins-label">Лицо ПДн:</span>
                <ClayFieldChange Changed="@IsFieldChanged(nameof(PersonalDataPersonId), PersonalDataPersonId)" WatchLookupRaw="true">
                    <ClaySelect TItem="PersonLookup" TValue="int?"
                                DataSource="PersonalDataSource"
                                ValueSelector="@(item => (int?)item.Id)"
                                TextSelector="@(item => item.Name)"
                                @bind-Value="PersonalDataPersonId"
                                SelectedItemChanged="OnPersonalDataChanged"
                                Options="_personOptions" />
                </ClayFieldChange>
                <ClayToolbarButton Options="_fillButtonOptions" OnClick="FillPersonalDataAsync" Disabled="@(CurrentEmployeeId is null)" />
            </div>
            @if (!string.IsNullOrWhiteSpace(_personalDataAdvisoryError))
            {
                <MudAlert Severity="Severity.Error">@_personalDataAdvisoryError</MudAlert>
            }
            @if (!string.IsNullOrWhiteSpace(_personalDataAdvisory))
            {
                <MudAlert Severity="Severity.Warning">@_personalDataAdvisory</MudAlert>
            }
            <div class="equipment-ins-row">
                <span class="equipment-ins-label">PIN:</span>
                <ClayTextBox @bind-Value="Secrets.Pin" Options="_pinOptions" />
                <span class="equipment-ins-label">PIN2:</span>
                <ClayTextBox @bind-Value="Secrets.Pin2" Options="_pin2Options" />
            </div>
            <div class="equipment-ins-row">
                <span class="equipment-ins-label">PUK:</span>
                <ClayTextBox @bind-Value="Secrets.Puk" Options="_pukOptions" />
                <span class="equipment-ins-label">PUK2:</span>
                <ClayTextBox @bind-Value="Secrets.Puk2" Options="_pukOptions" />
            </div>
        </ClayEditorFocusScope>
        </div>
    </DialogContent>
    <DialogActions>
        <ClayToolbarButton Options="_cancelButtonOptions" OnClick="CancelScopedAsync" Disabled="@(_saving || CancelPending || _readinessInFlight)" />
        @if (_loadError is not null && !_pendingRawRetry)
        {
            <ClayToolbarButton Options="_retryButtonOptions" OnClick="InitializeReadinessAsync" Disabled="@(_loading || _readinessInFlight || CancelPending)" />
        }
        <ClayToolbarButton Options="_okButtonOptions" OnClick="Apply" Disabled="@(_loading || _readinessInFlight || !_ready || _loadError is not null || _saving || _saveBlocked || _versionConflict || CancelPending)" />
    </DialogActions>
</MudDialog>

@code {
    private readonly ClayToolbarButtonOptions _cancelButtonOptions = new() { Text = "Отмена" };
    private readonly ClayToolbarButtonOptions _retryButtonOptions = new() { Text = "Повторить" };
    private readonly ClayToolbarButtonOptions _okButtonOptions = new() { Text = "OK", Color = Color.Primary, Variant = Variant.Filled };
    private readonly ClayToolbarButtonOptions _fillButtonOptions = new() { Text = "Заполнить" };
    private readonly ClayToolbarButtonOptions _nowButtonOptions = new() { Text = "Сейчас" };
    private readonly ClayTextBoxOptions _phoneOptions = new() { Required = true, MaxLength = 50, DraftKey = "sim.phone" };
    private readonly ClayDatePickerOptions _activationDateOptions = new() { Required = true, DraftKey = "sim.activation-date" };
    private readonly ClayTimeOptions _activationTimeOptions = new() { Required = true, DraftKey = "sim.activation-time" };
    private readonly ClaySelectOptions _contractOptions = new() { AdvanceFocusOnSelection = true, Required = true, AutoSelectSingle = true, Placeholder = "Выберите договор", DraftKey = "sim.contract", ReadOnly = true };
    private readonly ClaySelectOptions _personOptions = new() { AdvanceFocusOnSelection = true, AutoSelectSingle = true, Placeholder = "Выберите лицо персональных данных", DraftKey = "sim.person", ReadOnly = true };
    private readonly ClayTextBoxOptions _pinOptions = new() { MaxLength = 4, InputType = InputType.Password, Disabled = true };
    private readonly ClayTextBoxOptions _pin2Options = new() { MaxLength = 8, InputType = InputType.Password, Disabled = true };
    private readonly ClayTextBoxOptions _pukOptions = new() { MaxLength = 8, InputType = InputType.Password, Disabled = true };
    private ElementReference _sensitiveCancelRoot;
    private int? _freshResetCustomerType;
    private bool _refreshResetAdvisory;
    /// <inheritdoc />
    protected override ElementReference? SensitiveCancellationRoot => _sensitiveCancelRoot;

    private bool _loading = true;
    private bool _ready;
    private bool _secretReady;
    private bool _restoreContractPending;
    private bool _contractReadFailed;
    private int _readinessVersion;
    private int _contractVersion;
    private int _personVersion;
    private int _personSelectionRevision;
    private int _advisoryVersion;
    private string? _personalDataAdvisory;
    private string? _personalDataAdvisoryError;
    private int? _resolvedContractId;
    private int? _resolvedPersonalDataPersonId;
    private string? _loadError;
    private bool _draftRestored;
    private bool _readinessInFlight;
    private bool _pendingRawRetry;
    private bool _retryRequiresReopen;
    private bool _versionConflict;

    /// <summary>Идентификатор оборудования.</summary>
    [Parameter] public int EquipmentId { get; set; }

    /// <summary>Признак существующей SIM.</summary>
    [Parameter] public bool HasExisting { get; set; }

    /// <summary>Неизменяемые исходные поля отображённой SIM, без PIN/PUK.</summary>
    [Parameter] public EquipmentSimOriginal? Original { get; set; }

    /// <summary>Непрозрачная исходная версия для защищённого редактирования и восстановления.</summary>
    [Parameter] public string? OriginalVersion { get; set; }

    /// <summary>Текущее локальное время браузера.</summary>
    [Parameter] public DateTime Now { get; set; } = DateTime.Now;

    /// <summary>Номер телефона.</summary>
    [Parameter] public string PhoneNumber { get; set; } = string.Empty;

    /// <summary>Дата активации.</summary>
    [Parameter] public DateTime? ActivatedDate { get; set; }

    /// <summary>Время активации.</summary>
    [Parameter] public TimeSpan? ActivatedTime { get; set; }

    /// <summary>Договор связи.</summary>
    [Parameter] public int? ContractId { get; set; }

    /// <summary>Лицо ПДн.</summary>
    [Parameter] public int? PersonalDataPersonId { get; set; }

    /// <summary>Текущий ответственный сотрудник.</summary>
    [Parameter] public int? CurrentEmployeeId { get; set; }

    /// <summary>Секретные коды, не передаваемые из общего списка.</summary>
    public EquipmentSimSecrets Secrets { get; } = new();

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        PersonalDataSource.EquipmentId = EquipmentId;
        PersonalDataSource.ContractId = ContractId;
        PersonalDataSource.TechnicalTariffs = Configuration["technicalTariffs"] ?? string.Empty;
        if (!_ready)
        {
            _resolvedContractId = ContractId;
            _resolvedPersonalDataPersonId = PersonalDataPersonId;
        }
    }

    /// <inheritdoc />
    protected override void OnDraftStateRestored()
    {
        _draftRestored = true;
        _resolvedContractId = ContractId;
        _resolvedPersonalDataPersonId = PersonalDataPersonId;
        _restoreContractPending = ContractId is not null;
        PersonalDataSource.ContractId = ContractId;
        if (_freshResetCustomerType is { } customerType)
        {
            _freshResetCustomerType = null;
            PersonalDataSource.CustomerType = customerType;
            _restoreContractPending = false;
            _refreshResetAdvisory = true;
        }
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (_refreshResetAdvisory && IsEditorCurrent())
        {
            _refreshResetAdvisory = false;
            await RefreshPersonalDataAdvisoryAsync();
        }
        if (!firstRender)
            return;

        await InitializeReadinessAsync();
        if (_pendingRawRetry && !_retryRequiresReopen)
            await InitializeReadinessAsync();
    }

    private async Task InitializeReadinessAsync()
    {
        if (_readinessInFlight || _saving || CancelPending || !IsEditorCurrent())
            return;
        _readinessInFlight = true;
        try { await ReadAuthorizedInputAsync(); }
        finally
        {
            _readinessInFlight = false;
            if (IsEditorCurrent())
                StateHasChanged();
        }
    }

    private async Task ReadAuthorizedInputAsync()
    {
        var retry = _loadError is not null;
        var version = ++_readinessVersion;
        var equipmentId = EquipmentId;
        _loading = true;
        _ready = false;
        _secretReady = false;
        _contractReadFailed = false;
        _loadError = null;
        if (!_pendingRawRetry)
            ClearSecrets();
        SetSecretInputsDisabled(true);
        if (retry && ContractId is not null)
            _restoreContractPending = true;
        if (EditorContext is not null)
            await EditorContext.ReportReadinessAsync(EquipmentEditorReadiness.Pending);
        var secretsTask = LoadSecretsAsync(version, equipmentId);
        var contractTask = ResolveRestoredContractAsync(version, equipmentId);
        await Task.WhenAll(secretsTask, contractTask);
        if (!IsReadinessCurrent(version, equipmentId))
            return;
        if (_secretReady && _pendingRawRetry && (_retryRequiresReopen || _versionConflict))
        {
            _retryRequiresReopen = true;
            _secretReady = false;
            ClearSecrets();
            _loadError = "Ввод сохранён в черновике. Откройте редактор для восстановления и сверки.";
        }
        _loading = false;
        _ready = _secretReady && !_contractReadFailed;
        _contractOptions.ReadOnly = _personOptions.ReadOnly = false;
        SetSecretInputsDisabled(!_secretReady);
        await InvokeAsync(StateHasChanged);
        if (!_ready)
        {
            if (EditorContext is not null)
                await EditorContext.ReportReadinessAsync(EquipmentEditorReadiness.Failed);
            return;
        }
        try
        {
            if (EditorContext is not null)
            {
                if (_pendingRawRetry)
                    await EditorContext.ApplyPendingRawAsync();
                else
                    await EditorContext.ApplyRawAsync();
            }
            if (!IsReadinessCurrent(version, equipmentId))
                return;
            if (_versionConflict)
            {
                _error = "Исходное состояние SIM не подтверждено. Ввод сохранён. Сверьте актуальные данные перед записью.";
                await InvokeAsync(StateHasChanged);
            }
            if (EditorContext is not null)
                await EditorContext.ReportReadinessAsync(EquipmentEditorReadiness.Ready);
        }
        catch (Exception ex) when (ex is Microsoft.JSInterop.JSException or Microsoft.JSInterop.JSDisconnectedException or InvalidOperationException or OperationCanceledException)
        {
            if (!IsReadinessCurrent(version, equipmentId))
                return;
            _pendingRawRetry = EditorContext?.PendingRawRestore is not null;
            _retryRequiresReopen |= _pendingRawRetry && _versionConflict;
            if (!_pendingRawRetry || _retryRequiresReopen)
                ClearSecrets();
            _ready = false;
            _secretReady = false;
            SetSecretInputsDisabled(true);
            _loadError = _retryRequiresReopen
                ? "Ввод сохранён в черновике. Откройте редактор для восстановления и сверки."
                : "Не удалось восстановить все поля. Повторите восстановление.";
            if (EditorContext is not null)
                await EditorContext.ReportReadinessAsync(EquipmentEditorReadiness.Failed);
            await InvokeAsync(StateHasChanged);
            return;
        }
        await RefreshPersonalDataAdvisoryAsync();
    }

    private async Task LoadSecretsAsync(int version, int equipmentId)
    {
        if (!HasExisting)
        {
            _secretReady = true;
            return;
        }
        try
        {
            var snapshot = await Service.GetSimEditorSnapshotAsync(equipmentId);
            if (!IsReadinessCurrent(version, equipmentId))
                return;
            if (!_draftRestored && OriginalVersion is null && snapshot is not null && snapshot.CaptureOriginal() == Original)
                OriginalVersion = snapshot.EditorVersion;
            _versionConflict = snapshot is null || OriginalVersion is null || OriginalVersion != snapshot.EditorVersion;
            if (snapshot is not null && (!_pendingRawRetry || _retryRequiresReopen))
            {
                Secrets.Pin = snapshot.Secrets.Pin;
                Secrets.Pin2 = snapshot.Secrets.Pin2;
                Secrets.Puk = snapshot.Secrets.Puk;
                Secrets.Puk2 = snapshot.Secrets.Puk2;
            }
            _secretReady = true;
        }
        catch (Exception ex) when (ex is UnauthorizedAccessException or Microsoft.Data.SqlClient.SqlException or InvalidOperationException)
        {
            if (!IsReadinessCurrent(version, equipmentId))
                return;
            ClearSecrets();
            _retryRequiresReopen |= _pendingRawRetry;
            _secretReady = false;
            _loadError = ex is UnauthorizedAccessException or InvalidOperationException and not EquipmentSimStorageException
                ? ex.Message
                : "Не удалось прочитать коды SIM. Повторите чтение; сохранение заблокировано.";
        }
    }

    private async Task ResolveRestoredContractAsync(int version, int equipmentId)
    {
        if (!_restoreContractPending)
            return;
        _restoreContractPending = false;
        var contractId = ContractId;
        var contractVersion = _contractVersion;
        if (contractId is null)
            return;
        try
        {
            var contract = await ContractSource.GetByIdAsync(contractId);
            if (!IsReadinessCurrent(version, equipmentId) || contractVersion != _contractVersion || contractId != ContractId)
                return;
            PersonalDataSource.CustomerType = contract?.CustomerType ?? 0;
            PersonalDataSource.ContractId = contractId;
            _resolvedContractId = contractId;
        }
        catch (Exception ex) when (ex is UnauthorizedAccessException or Microsoft.Data.SqlClient.SqlException or InvalidOperationException)
        {
            if (!IsReadinessCurrent(version, equipmentId) || contractVersion != _contractVersion || contractId != ContractId)
                return;
            _contractReadFailed = true;
            _loadError = ex is Microsoft.Data.SqlClient.SqlException
                ? "Не удалось загрузить восстановленный договор. Выбор и лицо ПДн сохранены; повторите чтение."
                : ex.Message;
        }
    }

    private bool IsReadinessCurrent(int version, int equipmentId) =>
        IsEditorCurrent() && version == _readinessVersion && equipmentId == EquipmentId;

    private void SetSecretInputsDisabled(bool disabled) =>
        _pinOptions.Disabled = _pin2Options.Disabled = _pukOptions.Disabled = disabled;

    private void ClearSecrets() => Secrets.Pin = Secrets.Pin2 = Secrets.Puk = Secrets.Puk2 = string.Empty;

    private async Task OnContractChanged(MobileContractLookup? contract)
    {
        _contractVersion++;
        _restoreContractPending = false;
        PersonalDataSource.CustomerType = contract?.CustomerType ?? 0;
        PersonalDataSource.ContractId = ContractId;
        if (_ready && _resolvedContractId != ContractId)
        {
            _personVersion++;
            _personSelectionRevision++;
            PersonalDataPersonId = null;
            _resolvedPersonalDataPersonId = null;
        }
        _resolvedContractId = ContractId;
        await RefreshPersonalDataAdvisoryAsync();
    }

    private async Task OnPersonalDataChanged(PersonLookup? person)
    {
        if (_ready && _resolvedPersonalDataPersonId == PersonalDataPersonId)
            return;
        if (_ready)
            _personSelectionRevision++;
        _resolvedPersonalDataPersonId = PersonalDataPersonId;
        await RefreshPersonalDataAdvisoryAsync();
    }

    private async Task FillPersonalDataAsync()
    {
        if (CurrentEmployeeId is null)
            return;
        var version = ++_personVersion;
        var selectionRevision = _personSelectionRevision;
        var equipmentId = EquipmentId;
        var contractId = ContractId;
        try
        {
            var personId = await Service.GetEmployeePersonIdAsync(CurrentEmployeeId.Value);
            if (!IsEditorCurrent() || version != _personVersion || selectionRevision != _personSelectionRevision ||
                equipmentId != EquipmentId || contractId != ContractId || personId is null)
                return;
            PersonalDataPersonId = personId;
            _resolvedPersonalDataPersonId = personId;
        }
        catch (Exception ex) when (ex is UnauthorizedAccessException or Microsoft.Data.SqlClient.SqlException or InvalidOperationException)
        {
            if (!IsEditorCurrent() || version != _personVersion || selectionRevision != _personSelectionRevision ||
                equipmentId != EquipmentId || contractId != ContractId)
                return;
            _error = ex is Microsoft.Data.SqlClient.SqlException
                ? "Не удалось определить лицо персональных данных. Повторите попытку."
                : ex.Message;
        }
        if (!IsEditorCurrent() || version != _personVersion || selectionRevision != _personSelectionRevision ||
            equipmentId != EquipmentId || contractId != ContractId)
            return;
        await RefreshPersonalDataAdvisoryAsync();
        if (IsEditorCurrent())
            await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshPersonalDataAdvisoryAsync()
    {
        var version = ++_advisoryVersion;
        var selectionRevision = _personSelectionRevision;
        var equipmentId = EquipmentId;
        var contractId = ContractId;
        var personId = PersonalDataPersonId;
        _personalDataAdvisory = null;
        _personalDataAdvisoryError = null;
        if (!_ready || personId is null)
            return;
        try
        {
            var businessToday = GetNow is null ? Now.Date : (await GetNow()).Date;
            if (!IsAdvisoryCurrent(version, selectionRevision, equipmentId, contractId, personId))
                return;
            var result = await Service.GetPersonalDataAdvisoryAsync(
                equipmentId, contractId, personId, Configuration["technicalTariffs"] ?? string.Empty, businessToday);
            if (!IsAdvisoryCurrent(version, selectionRevision, equipmentId, contractId, personId))
                return;
            _personalDataAdvisory = result.Message;
        }
        catch (Exception ex) when (ex is UnauthorizedAccessException or Microsoft.Data.SqlClient.SqlException or InvalidOperationException)
        {
            if (!IsAdvisoryCurrent(version, selectionRevision, equipmentId, contractId, personId))
                return;
            _personalDataAdvisoryError = "Не удалось проверить соответствие лица ПДн. Выбор сохранён; это не отрицательный результат проверки. " + ex.Message;
        }
        if (IsAdvisoryCurrent(version, selectionRevision, equipmentId, contractId, personId))
            await InvokeAsync(StateHasChanged);
    }

    private bool IsAdvisoryCurrent(int version, int selectionRevision, int equipmentId, int? contractId, int? personId) =>
        IsEditorCurrent() && version == _advisoryVersion && selectionRevision == _personSelectionRevision &&
        equipmentId == EquipmentId && contractId == ContractId && personId == PersonalDataPersonId;

    /// <summary>Возвращает актуальное локальное время браузера для команды «Сейчас».</summary>
    [Parameter] public Func<Task<DateTime>>? GetNow { get; set; }

    private async Task SetActivationNow()
    {
        var now = GetNow is null ? Now : await GetNow();
        if (!IsEditorCurrent())
            return;
        ActivatedDate = now.Date;
        ActivatedTime = now.TimeOfDay;
        await InvokeAsync(StateHasChanged);
    }

    internal void AcceptFreshResetSecrets(EquipmentSimSecrets fresh, int customerType)
    {
        ++_readinessVersion;
        ++_contractVersion;
        ++_personVersion;
        ++_personSelectionRevision;
        ++_advisoryVersion;
        Secrets.Pin = fresh.Pin;
        Secrets.Pin2 = fresh.Pin2;
        Secrets.Puk = fresh.Puk;
        Secrets.Puk2 = fresh.Puk2;
        _freshResetCustomerType = customerType;
        _versionConflict = _pendingRawRetry = _retryRequiresReopen = _contractReadFailed = false;
        _loading = false;
        _secretReady = _ready = true;
        _loadError = null;
        _personalDataAdvisory = _personalDataAdvisoryError = null;
        _contractOptions.ReadOnly = _personOptions.ReadOnly = false;
        SetSecretInputsDisabled(false);
    }

    private Task Apply()
    {
        if (_loading || _readinessInFlight || !_ready || _loadError is not null || _versionConflict)
            return Task.CompletedTask;
        var localActivation = ActivatedDate?.Date.Add(ActivatedTime ?? TimeSpan.Zero) ?? default;
        var candidate = new EquipmentSimCard
        {
            PhoneNumber = PhoneNumber?.Trim() ?? string.Empty,
            ContractId = ContractId,
            ActivatedAtUtc = localActivation,
            Secrets = new EquipmentSimSecrets { Pin = Secrets.Pin, Pin2 = Secrets.Pin2, Puk = Secrets.Puk, Puk2 = Secrets.Puk2 },
        };
        var draft = new EquipmentSimDialogResult(
            candidate.PhoneNumber, localActivation, ContractId, PersonalDataPersonId, candidate.Secrets)
        {
            Mode = HasExisting ? EquipmentSimWriteMode.Edit : EquipmentSimWriteMode.Add,
            OriginalVersion = OriginalVersion,
        };
        return ApplyAsync(draft, () => ActivatedDate is null || ActivatedTime is null
            ? "Укажите дату и время активации."
            : candidate.Validate());
    }
}
