@inherits EquipmentEditorDialogBase<EquipmentUpsDialogResult>
@using Clayzor.Lib.Entities.Inventory
@using Clayzor.Lib.Web.Controls.Components.Grid
@using Clayzor.Lib.Web.Controls.Components.Form
@using Clayzor.Lib.Web.Controls.Components.Select
@using Clayzor.Lib.Web.DBSelect.Equipment
@using Kesco.App.Web.Inventory.Components.Layout
@inject IServiceProvider Services
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>Подключение UPS #@UpsEquipmentId</TitleContent>
    <DialogContent>
        <ClayFormActions Form="InventoryFormHelp.EquipmentUps" />
        <div data-draft-scope="@DraftScope">
        @if (BaselineError is not null)
        {
            <MudAlert Severity="Severity.Warning">@BaselineError</MudAlert>
        }
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error">@_error</MudAlert>
        }
        @if (Servers.Any(item => !IsComputer(item)))
        {
            <MudAlert Severity="Severity.Info">Признак «Выключение настроено» доступен только для компьютеров. Для другого оборудования значение доступно только для чтения.</MudAlert>
        }
        <div class="equipment-ins-row">
            <span class="equipment-ins-label">Сервер:</span>
            <ClaySelect TItem="UpsEquipmentLookup" TValue="int?"
                        DataSource="ServerSource"
                        ValueSelector="@(item => (int?)item.Id)"
                        TextSelector="@(item => item.Name)"
                        @bind-Value="_serverToAdd"
                        Options="_serverOptions" />
            <ClayToolbarButton Options="_addButtonOptions" OnClick="AddServer" />
        </div>
        <ClayGrid TEntity="UpsServerLink" Items="Servers" Options="_serverGridOptions">
            <ColumnDefs>
                <ClayColumnDef ColumnId="1" SqlName="Server" DisplayName="Сервер" />
                <ClayColumnDef ColumnId="2" SqlName="ChangedBy" DisplayName="Изменил" />
                <ClayColumnDef ColumnId="3" SqlName="ChangedAt" DisplayName="Изменено" />
            </ColumnDefs>
            <Columns>
                <ClayColumn TEntity="UpsServerLink" ColumnId="1" TextSelector="@(item => string.IsNullOrWhiteSpace(item.ServerName) ? item.EquipmentName : item.ServerName)" />
                <ClayColumn TEntity="UpsServerLink" ColumnId="2" TextSelector="@(item => item.ChangedByName)" />
                <ClayColumn TEntity="UpsServerLink" ColumnId="3">
                    <CellTemplate>
                        @if (context.Item.ChangedAt != default)
                        {
                            <ClayLocalTime Value="context.Item.ChangedAt" />
                        }
                    </CellTemplate>
                </ClayColumn>
            </Columns>
            <RowActions Context="item">
                <ClayCheckbox State="item.TurnOffConfigured > 0" ReadOnly="@(!IsComputer(item))" OnToggle="() => ToggleServer(item)" Label="Выключение" />
                <ClayButton Icon="@Icons.Material.Filled.Delete" Text="Удалить сервер" OnClick="() => Servers.Remove(item)" />
            </RowActions>
        </ClayGrid>
        <ClayGrid TEntity="UpsTest" Items="Tests" Options="_testGridOptions" OnAdd="AddTest">
            <ColumnDefs>
                <ClayColumnDef ColumnId="1" SqlName="TestedAt" DisplayName="Дата" />
                <ClayColumnDef ColumnId="2" SqlName="BatteryTime" DisplayName="Батарея" />
                <ClayColumnDef ColumnId="3" SqlName="Servers" DisplayName="Серверы" />
                <ClayColumnDef ColumnId="4" SqlName="Issues" DisplayName="Ошибки" />
                <ClayColumnDef ColumnId="5" SqlName="ChangedBy" DisplayName="Изменил" />
                <ClayColumnDef ColumnId="6" SqlName="ChangedAt" DisplayName="Изменено" />
            </ColumnDefs>
            <Columns>
                <ClayColumn TEntity="UpsTest" ColumnId="1" TextSelector="@(item => item.TestedAt.ToString("dd.MM.yyyy HH:mm:ss"))" />
                <ClayColumn TEntity="UpsTest" ColumnId="2" TextSelector="@(item => item.BatteryTime.ToString())" />
                <ClayColumn TEntity="UpsTest" ColumnId="3" TextSelector="@(item => item.Servers)" />
                <ClayColumn TEntity="UpsTest" ColumnId="4" TextSelector="@(item => item.Issues)" />
                <ClayColumn TEntity="UpsTest" ColumnId="5" TextSelector="@(item => item.ChangedByName)" />
                <ClayColumn TEntity="UpsTest" ColumnId="6">
                    <CellTemplate>
                        @if (context.Item.ChangedAt != default)
                        {
                            <ClayLocalTime Value="context.Item.ChangedAt" />
                        }
                    </CellTemplate>
                </ClayColumn>
            </Columns>
            <RowActions Context="item">
                <ClayButton Icon="@Icons.Material.Filled.Edit" Text="Изменить тест" OnClick="() => EditTest(item)" />
            </RowActions>
        </ClayGrid>
        </div>
    </DialogContent>
    <DialogActions>
        <ClayToolbarButton Options="_cancelButtonOptions" OnClick="CancelUps" Disabled="@_saving" />
        <ClayToolbarButton Options="_okButtonOptions" OnClick="Apply" Disabled="@(_saving || _saveBlocked || BaselineError is not null)" />
    </DialogActions>
</MudDialog>

@code {
    private readonly ClayToolbarButtonOptions _cancelButtonOptions = new() { Text = "Отмена" };
    private readonly ClayToolbarButtonOptions _okButtonOptions = new() { Text = "OK", Color = Color.Primary, Variant = Variant.Filled };
    private readonly ClayToolbarButtonOptions _addButtonOptions = new() { Text = "Добавить" };
    private readonly ClaySelectOptions _serverOptions = new() { AutoSelectSingle = true, Placeholder = "Выберите сервер", DraftKey = "ups.server" };
    private readonly ClayGridOptions _serverGridOptions = SectionOptions("ups-servers", "Нет серверов", false);
    private readonly ClayGridOptions _testGridOptions = SectionOptions("ups-tests", "Нет тестов", true);

    private static ClayGridOptions SectionOptions(string id, string emptyText, bool showAdd) => new()
    {
        Id = id,
        Class = "equipment-detail-grid",
        EmptyText = emptyText,
        AddTooltip = "Добавить тест",
        ShowAddButton = showAdd,
        ShowToolbar = false,
        ShowPagination = false,
        AutoHeight = true,
        AllowColumnReorder = false,
        AllowSorting = false,
        ColumnMenuMode = ColumnMenuMode.Hidden,
    };
    private int? _serverToAdd;
    private bool _addingServer;
    private bool _openingTest;
    private EquipmentUpsTestDraft? _pendingTestDraft;

    /// <summary>Идентификатор UPS.</summary>
    [Parameter] public int UpsEquipmentId { get; set; }

    /// <summary>Сообщение восстановления, если сохранённый ввод не имеет исходной версии для записи.</summary>
    [Parameter] public string? BaselineError { get; set; }

    /// <summary>Возвращает актуальное локальное время браузера.</summary>
    [Parameter] public Func<Task<DateTime>>? GetNow { get; set; }

    /// <summary>Уведомляет владельца DR-01 об изменении состава редакторов.</summary>
    [Parameter] public Func<Task>? DraftChanged { get; set; }

    /// <summary>Идентификатор вложенного теста для восстановления.</summary>
    [Parameter] public int? RestoreTestId { get; set; }

    /// <summary>Черновик ранее открытого вложенного теста.</summary>
    [Parameter] public EquipmentUpsTestDraft? RestoredTestDraft { get; set; }

    /// <summary>Стабильная область родительского диалога.</summary>
    [Parameter] public string? DraftScope { get; set; }

    /// <summary>Класс DOM-владельца для портала вложенного диалога.</summary>
    [Parameter] public string? DraftOwnerClass { get; set; }

    /// <summary>Сохраняет незавершённый typed ввод вложенного теста.</summary>
    [Parameter] public Func<EquipmentUpsTestDraft, Task>? PublishTestDraft { get; set; }

    /// <summary>Восстанавливает raw ввод после отрисовки вложенного теста.</summary>
    [Parameter] public Func<string, bool, Task<bool>>? RestoreTestRaw { get; set; }

    /// <summary>Проверяет, что raw ввод вложенного теста можно принять.</summary>
    [Parameter] public Func<string, Task<bool>>? CanAcceptTest { get; set; }

    /// <summary>Завершает область вложенного теста после принятия или отмены.</summary>
    [Parameter] public Func<int, bool, Task<bool>>? FinishTestDraft { get; set; }

    /// <summary>Редактируемые серверы.</summary>
    [Parameter] public List<UpsServerLink> Servers { get; set; } = [];

    /// <summary>Редактируемые тесты.</summary>
    [Parameter] public List<UpsTest> Tests { get; set; } = [];

    private UpsEquipmentSelectDataSource ServerSource => Services.GetRequiredKeyedService<UpsEquipmentSelectDataSource>("server");

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
            _pendingTestDraft = RestoredTestDraft;
        if (firstRender && RestoreTestId is not null)
        {
            var testId = RestoreTestId.Value;
            var item = Tests.FirstOrDefault(test => test.Id == testId);
            item ??= new UpsTest
            {
                UpsEquipmentId = UpsEquipmentId,
                TestedAt = GetNow is null ? DateTime.Now : await GetNow(),
            };
            await EditTest(item);
        }
        if (DraftChanged is not null)
            await DraftChanged();
    }

    private async Task AddServer()
    {
        if (_addingServer || _serverToAdd is null || Servers.Any(item => item.ServerEquipmentId == _serverToAdd.Value))
            return;
        _addingServer = true;
        _error = null;
        try
        {
            var serverId = _serverToAdd.Value;
            var selected = await ServerSource.GetByIdAsync(serverId) ??
                           throw new InvalidOperationException("Выбранное оборудование не найдено. Обновите список.");
            Servers.Add(new UpsServerLink
            {
                UpsEquipmentId = UpsEquipmentId,
                ServerEquipmentId = serverId,
                ServerName = selected.ServerName,
                EquipmentTypeId = selected.EquipmentTypeId,
                EquipmentName = selected.Name,
            });
            _serverToAdd = null;
        }
        catch (Exception ex) when (ex is Microsoft.Data.SqlClient.SqlException or InvalidOperationException)
        {
            _error = ex is InvalidOperationException
                ? ex.Message
                : "Не удалось загрузить выбранный сервер. Повторите попытку.";
        }
        finally
        {
            _addingServer = false;
        }
    }

    private static bool IsComputer(UpsServerLink item) =>
        item.EquipmentTypeId == (int)ТипыОборудования.Компьютер;

    private static void ToggleServer(UpsServerLink item)
    {
        if (!IsComputer(item))
            return;
        item.TurnOffConfigured = item.TurnOffConfigured > 0 ? (byte)0 : (byte)1;
    }

    private async Task AddTest()
    {
        var now = GetNow is null ? DateTime.Now : await GetNow();
        var item = new UpsTest { UpsEquipmentId = UpsEquipmentId, TestedAt = now };
        await EditTest(item);
    }

    private async Task EditTest(UpsTest item)
    {
        if (_openingTest)
            return;
        if (_pendingTestDraft is { } pending && pending.Original.Id != item.Id)
        {
            _error = "Сначала завершите открытый черновик теста UPS.";
            return;
        }
        _openingTest = true;
        _error = null;
        try
        {
            var original = new UpsTest
            {
                Id = item.Id,
                UpsEquipmentId = UpsEquipmentId,
                TestedAt = item.TestedAt,
                BatteryTime = item.BatteryTime,
                Servers = item.Servers,
                Issues = item.Issues,
                ChangedByName = item.ChangedByName,
                ChangedAt = item.ChangedAt,
            };
            var restored = _pendingTestDraft is { } draft && draft.Original.Id == item.Id &&
                draft.Original.UpsEquipmentId == UpsEquipmentId ? draft : null;
            var current = restored ?? new EquipmentUpsTestDraft(original, original.TestedAt.Date,
                original.TestedAt.TimeOfDay, original.BatteryTime, original.Servers, original.Issues);
            var value = new UpsTest
            {
                Id = item.Id,
                UpsEquipmentId = UpsEquipmentId,
                TestedAt = item.TestedAt,
                BatteryTime = current.BatteryTime,
                Servers = current.Servers,
                Issues = current.Issues,
                ChangedByName = item.ChangedByName,
                ChangedAt = item.ChangedAt,
            };
            var scope = DraftScope is null ? null : $"{DraftScope[..^"root".Length]}{item.Id}";
            Func<Task<bool>>? restoreRaw = null;
            var rawReady = scope is null || RestoreTestRaw is null;
            if (scope is not null && RestoreTestRaw is { } restoreTestRaw)
            {
                var requested = false;
                restoreRaw = async () =>
                {
                    var retry = requested;
                    requested = true;
                    rawReady = false;
                    rawReady = await restoreTestRaw(scope, retry);
                    return rawReady;
                };
            }
            Func<Task<bool>>? canAccept = scope is null || CanAcceptTest is null ? null : () => CanAcceptTest(scope);
            var parameters = new DialogParameters<EquipmentUpsTestDialog>
            {
                { dialog => dialog.Value, value },
                { dialog => dialog.Date, current.Date },
                { dialog => dialog.Time, current.Time },
                { dialog => dialog.AvailableServers, Servers },
                { dialog => dialog.Original, current.Original },
                { dialog => dialog.DraftScope, scope },
                { dialog => dialog.DraftOwnerClass, DraftOwnerClass },
                { dialog => dialog.PublishDraft, PublishTestDraft is null ? null : SaveTestDraftAsync },
                { dialog => dialog.RestoreRaw, restoreRaw },
                { dialog => dialog.CanAcceptDraft, canAccept },
            };
            if (PublishTestDraft is not null)
                await SaveTestDraftAsync(current);

            var reference = await DialogService.ShowExAsync<EquipmentUpsTestDialog>("Тестирование UPS", parameters,
                new DialogOptionsEx { DragMode = MudDialogDragMode.Simple });
            var result = await reference.Result;
            if (result is null)
                return;

            var accepted = !result.Canceled && result.Data is UpsTest;
            if (!accepted && !rawReady)
            {
                _error = "Ввод теста сохранён. Откройте этот же тест для восстановления.";
                return;
            }
            if (accepted && result.Data is UpsTest updated)
            {
                var index = Tests.IndexOf(item);
                if (index >= 0)
                    Tests[index] = updated;
                else
                    Tests.Add(updated);
            }
            if (FinishTestDraft is null || await FinishTestDraft(item.Id, accepted))
                _pendingTestDraft = null;
            else
                _error = "Не удалось завершить черновик теста UPS. Откройте этот же тест для сверки.";
        }
        catch (Exception ex) when (ex is InvalidOperationException or Microsoft.JSInterop.JSException or
            Microsoft.JSInterop.JSDisconnectedException or OperationCanceledException)
        {
            if (!_disposed)
                _error = "Не удалось завершить черновик вложенного теста UPS.";
        }
        finally
        {
            _openingTest = false;
        }
    }

    private async Task SaveTestDraftAsync(EquipmentUpsTestDraft draft)
    {
        _pendingTestDraft = draft;
        await PublishTestDraft!(draft);
    }

    private void CancelUps()
    {
        if (_pendingTestDraft is not null)
            _error = "Сначала завершите открытый черновик теста UPS.";
        else
            Cancel();
    }

    private Task Apply() => ApplyAsync(new EquipmentUpsDialogResult(Servers, Tests), () =>
        BaselineError ?? (_pendingTestDraft is not null ? "Сначала завершите открытый черновик теста UPS." : null));
}
