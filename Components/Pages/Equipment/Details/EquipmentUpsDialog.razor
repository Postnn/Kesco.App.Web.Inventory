@using Clayzor.Lib.Entities.Inventory
@using Clayzor.Lib.Web.Controls.Components.Detail
@using Clayzor.Lib.Web.Controls.Components.Form
@using Clayzor.Lib.Web.Controls.Components.Select
@using Clayzor.Lib.Web.DBSelect.Equipment
@inject IServiceProvider Services
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>Подключение UPS #@UpsEquipmentId</TitleContent>
    <DialogContent>
        <div class="equipment-ins-row">
            <span class="equipment-ins-label">Сервер:</span>
            <ClaySelect TItem="UpsEquipmentLookup" TValue="int?"
                        DataSource="ServerSource"
                        ValueSelector="@(item => (int?)item.Id)"
                        TextSelector="@(item => item.Name)"
                        @bind-Value="_serverToAdd"
                        Options="_serverOptions" />
            <ClayToolbarButton Options="_addButtonOptions" OnClick="AddServer" />
        </div>
        <ClayDetailGrid TItem="UpsServerLink"
                        Title="Серверы"
                        Items="Servers"
                        Columns="_serverColumns"
                        Options="_serverGridOptions">
            <Actions Context="item">
                <ClayCheckbox State="item.TurnOffConfigured > 0" OnToggle="() => ToggleServer(item)" Label="Выключение" />
                <ClayButton Icon="@Icons.Material.Filled.Delete" Text="Удалить сервер" OnClick="() => Servers.Remove(item)" />
            </Actions>
        </ClayDetailGrid>
        <ClayDetailGrid TItem="UpsTest"
                        Title="Тестирование"
                        Items="Tests"
                        Columns="_testColumns"
                        Options="_testGridOptions"
                        OnAdd="AddTest">
            <Actions Context="item">
                <ClayButton Icon="@Icons.Material.Filled.Edit" Text="Изменить тест" OnClick="() => EditTest(item)" />
            </Actions>
        </ClayDetailGrid>
    </DialogContent>
    <DialogActions>
        <ClayToolbarButton Options="_cancelButtonOptions" OnClick="Cancel" />
        <ClayToolbarButton Options="_okButtonOptions" OnClick="Apply" />
    </DialogActions>
</MudDialog>

@code {
    private readonly ClayToolbarButtonOptions _cancelButtonOptions = new() { Text = "Отмена" };
    private readonly ClayToolbarButtonOptions _okButtonOptions = new() { Text = "OK", Color = Color.Primary, Variant = Variant.Filled };
    private readonly ClayToolbarButtonOptions _addButtonOptions = new() { Text = "Добавить" };
    private readonly ClaySelectOptions _serverOptions = new() { AutoSelectSingle = true, Placeholder = "Введите сервер" };
    private readonly ClayDetailGridOptions _serverGridOptions = new() { EmptyText = "Нет серверов" };
    private readonly ClayDetailGridOptions _testGridOptions = new() { EmptyText = "Нет тестов", AddTooltip = "Добавить тест" };
    private readonly IReadOnlyList<ClayDetailColumn<UpsServerLink>> _serverColumns =
    [
        new() { Title = "Сервер", TextSelector = item => item.ServerName },
    ];
    private readonly IReadOnlyList<ClayDetailColumn<UpsTest>> _testColumns =
    [
        new() { Title = "Дата", TextSelector = item => item.TestedAt.ToString("dd.MM.yyyy HH:mm:ss") },
        new() { Title = "Батарея", TextSelector = item => item.BatteryTime.ToString() },
        new() { Title = "Серверы", TextSelector = item => item.Servers },
        new() { Title = "Ошибки", TextSelector = item => item.Issues },
    ];
    private int? _serverToAdd;

    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;

    /// <summary>Идентификатор UPS.</summary>
    [Parameter] public int UpsEquipmentId { get; set; }

    /// <summary>Редактируемые серверы.</summary>
    [Parameter] public List<UpsServerLink> Servers { get; set; } = [];

    /// <summary>Редактируемые тесты.</summary>
    [Parameter] public List<UpsTest> Tests { get; set; } = [];

    private UpsEquipmentSelectDataSource ServerSource => Services.GetRequiredKeyedService<UpsEquipmentSelectDataSource>("server");

    private void AddServer()
    {
        if (_serverToAdd is null || Servers.Any(item => item.ServerEquipmentId == _serverToAdd.Value))
            return;
        Servers.Add(new UpsServerLink
        {
            UpsEquipmentId = UpsEquipmentId,
            ServerEquipmentId = _serverToAdd.Value,
            ServerName = $"#{_serverToAdd.Value}",
        });
        _serverToAdd = null;
    }

    private static void ToggleServer(UpsServerLink item) => item.TurnOffConfigured = item.TurnOffConfigured > 0 ? (byte)0 : (byte)1;

    private async Task AddTest()
    {
        var item = new UpsTest { UpsEquipmentId = UpsEquipmentId, TestedAt = DateTime.Now };
        var updated = await EditTest(item);
        if (updated is not null)
            Tests.Add(updated);
    }

    private async Task<UpsTest?> EditTest(UpsTest item)
    {
        var value = new UpsTest
        {
            Id = item.Id,
            UpsEquipmentId = UpsEquipmentId,
            TestedAt = item.TestedAt,
            BatteryTime = item.BatteryTime,
            Servers = item.Servers,
            Issues = item.Issues,
        };
        var parameters = new DialogParameters<EquipmentUpsTestDialog>
        {
            { dialog => dialog.Value, value },
            { dialog => dialog.Date, value.TestedAt.Date },
            { dialog => dialog.Time, value.TestedAt.TimeOfDay },
        };
        var dialog = await DialogService.ShowAsync<EquipmentUpsTestDialog>("Тестирование UPS", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not UpsTest updated)
            return null;
        var index = Tests.IndexOf(item);
        if (index >= 0)
            Tests[index] = updated;
        return updated;
    }

    private void Cancel() => Dialog.Cancel();

    private void Apply() => Dialog.Close(DialogResult.Ok(new EquipmentUpsDialogResult(Servers, Tests)));
}
