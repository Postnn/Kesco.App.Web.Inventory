@page "/Maintenance"
@page "/Maintenance.aspx"
@using Clayzor.Lib.Entities.Inventory

<PageTitle>Регламентные работы</PageTitle>
<NavigationLock ConfirmExternalNavigation="@HasUnsentConfirmation" OnBeforeInternalNavigation="BeforeMaintenanceNavigationAsync" />
<InventoryMainMenu />

<div class="inventory-list-page @_draftRoot">
    <MudText Typo="Typo.h5" Class="clay-page-title mb-2">Регламентные работы</MudText>
    @if (_sourceTimeZone is null)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-2">Укажите часовой пояс источника, чтобы показать даты и включить фильтры по ним.</MudAlert>
    }
    @if (_message is not null)
    {
        <MudAlert Severity="@_messageSeverity" Class="mb-2">@_message</MudAlert>
    }
    @if ((_loadFailed || RecoveryRequired) && !IsBusy)
    {
        <MudButton OnClick="ReloadAsync">Перечитать список</MudButton>
    }
    @if (HasUnsentConfirmation && !IsBusy)
    {
        <MudButton OnClick="CancelPendingAsync">Отменить вопрос</MudButton>
    }
    @if (_list is { } list)
    {
        <ClayGrid TEntity="MaintenanceWork" Options="_options" Items="@_rows" Loading="@IsBusy"
                  TotalCount="@_rows.Count" @ref="_grid" OnQueryChanged="OnFilterChangedAsync"
                  DistinctValuesLoader="LoadFilterValuesAsync">
            <RowActions>
                <ClayButton @key="context.Id" Icon="@Icons.Material.Filled.Check" Text="Подтвердить выполнение"
                            Disabled="@(!CanConfirm(context))" OnClick="@(() => ConfirmAsync(context.Id))" />
            </RowActions>
            <ColumnDefs>
                <ClayColumnDef Filterable="@(_sourceTimeZone is not null)" AllowValueFilter="@(_sourceTimeZone is not null)" ColumnId="1" SqlName="@MaintenanceColumns.Deadline" DisplayName="Выполнить до" />
                <ClayColumnDef Filterable="true" AllowValueFilter="true" ColumnId="2" SqlName="@MaintenanceColumns.Name" DisplayName="Регламентная работа" />
                <ClayColumnDef Filterable="true" AllowValueFilter="true" ColumnId="3" SqlName="@MaintenanceColumns.Responsible" DisplayName="Ответственный" />
                <ClayColumnDef Filterable="true" AllowValueFilter="true" ColumnId="4" SqlName="@MaintenanceColumns.Instruction" DisplayName="Ссылка" />
                <ClayColumnDef Filterable="@(_sourceTimeZone is not null)" AllowValueFilter="@(_sourceTimeZone is not null)" ColumnId="5" SqlName="@MaintenanceColumns.LastCompleted" DisplayName="Последнее выполнение" />
                <ClayColumnDef Filterable="true" AllowValueFilter="true" ColumnId="6" SqlName="@MaintenanceColumns.EmployeeName" DisplayName="Сотрудник" />
            </ColumnDefs>
            <Columns>
                <ClayColumn TEntity="MaintenanceWork" ColumnId="1">
                    <CellTemplate>
                        @if (MaintenanceTime.ToUtc(context.Item.Deadline, _sourceTimeZone) is { } deadline)
                        {
                            <MudText Color="@DeadlineColor(deadline, list.ServerNow)" Typo="Typo.body2">
                                <ClayLocalTime Value="deadline" />
                            </MudText>
                        }
                    </CellTemplate>
                </ClayColumn>
                <ClayColumn TEntity="MaintenanceWork" ColumnId="2"><CellTemplate>@context.Item.Name</CellTemplate></ClayColumn>
                <ClayColumn TEntity="MaintenanceWork" ColumnId="3"><CellTemplate>@context.Item.Responsible</CellTemplate></ClayColumn>
                <ClayColumn TEntity="MaintenanceWork" ColumnId="4">
                    <CellTemplate>
                        @{
                            var instruction = context.Item.Instruction.Trim();
                        }
                        @if (MaintenancePresentation.WebInstruction(instruction) is { } uri)
                        {
                            <a href="@uri.AbsoluteUri" target="_blank" rel="noopener noreferrer">@instruction</a>
                        }
                        else if (MaintenancePresentation.IsDrivePath(instruction))
                        {
                            <MudText Typo="Typo.body2">@instruction</MudText>
                            <MudText Typo="Typo.caption">Скопируйте путь и откройте его в Проводнике.</MudText>
                        }
                    </CellTemplate>
                </ClayColumn>
                <ClayColumn TEntity="MaintenanceWork" ColumnId="5">
                    <CellTemplate><ClayLocalTime Value="@MaintenanceTime.ToUtc(context.Item.LastCompleted, _sourceTimeZone)" /></CellTemplate>
                </ClayColumn>
                <ClayColumn TEntity="MaintenanceWork" ColumnId="6">
                    <CellTemplate>
                        @if (EmployeeLink(context.Item) is { } link)
                        {
                            <a href="@link" @onclick:preventDefault
                               @onclick="@(() => OpenAsync(link, $"maintenance-employee-{context.Item.EmployeeId}"))">@context.Item.EmployeeName</a>
                        }
                        else
                        {
                            @context.Item.EmployeeName
                        }
                    </CellTemplate>
                </ClayColumn>
            </Columns>
        </ClayGrid>
    }
    else if (IsBusy)
    {
        <MudProgressLinear Indeterminate="true" />
    }
</div>

