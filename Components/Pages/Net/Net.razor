@page "/Net/Net"
@layout Kesco.App.Web.Inventory.Components.Layout.EntityFormLayout
@using Clayzor.Lib.Entities.Inventory
@using Clayzor.Lib.Web.Controls.Components.Form
@using Clayzor.Lib.Web.Controls.Components.Presence
@using Clayzor.Lib.Web.Controls.Components.Select
@using Clayzor.Lib.Web.Controls.Services

<PageTitle>Локальная сеть</PageTitle>
<div data-net-operation="@_operationRoot">
<NavigationLock ConfirmExternalNavigation="@ConfirmNetExternalExit" OnBeforeInternalNavigation="BeforeInternalNavigationAsync" />

<ClayEntityForm Options="_entityFormOptions">
    <Toolbar>
        <ClayToolbar>
            <ClayToolbarButton Options="_okOptions" Disabled="@(_loading || _saving || _poeRunning || !_loaded || CurrentUser is null || RequiresReconciliation || OperationBlocked || InputBlocked)" OnClick="@(() => SaveAsync(true))" />
            <ClayToolbarButton Options="_applyOptions" Disabled="@(!CanSave)" OnClick="@(() => SaveAsync(false))" />
            @if (_model?.Poe == 1)
            {
                <ClayToolbarButton Options="_poeOptions" Disabled="@(_loading || _saving || _poeRunning || CurrentUser is null || OperationBlocked || RawInputBlocked)" OnClick="RestartPoeAsync" />
            }
            <ClayToolbarButton Options="_cancelOptions" Disabled="@(_loading || _saving || _poeRunning || _inspectingOperation)" OnClick="CancelAsync" />
        </ClayToolbar>
    </Toolbar>
    <ChildContent>
        @if (_loadError is not null)
        {
            <MudAlert Severity="Severity.Error">
                <div class="d-flex flex-wrap gap-2 align-center">
                    <span>@_loadError</span>
                    <ClayToolbarButton Options="_retryOptions" Disabled="@_loading" OnClick="RetryLoadAsync" />
                </div>
            </MudAlert>
        }
        else if (_notFound)
        {
            <MudAlert Severity="Severity.Warning">Порт локальной сети с указанным идентификатором не найден.</MudAlert>
        }
        else if (_model is not null)
        {
            @if (GetPresenceTarget() is { } presenceTarget)
            {
                <ClayPresencePanel Target="presenceTarget" />
            }
            var baseline = _loaded && _model.Id == Id && CurrentUser is not null ? _originalSnapshot : null;
            if (CurrentUser is null)
            {
                <MudAlert Severity="Severity.Warning">Текущий пользователь не определён. Изменение и перезапуск PoE запрещены.</MudAlert>
            }
            @if (!string.IsNullOrWhiteSpace(_validationMessage))
            {
                <MudAlert Severity="Severity.Error">@_validationMessage</MudAlert>
            }
            @if (!string.IsNullOrWhiteSpace(_parentRefreshWarning))
            {
                <MudAlert Severity="Severity.Warning">@_parentRefreshWarning</MudAlert>
            }
            @if (_operationNotice is not null || _observedOutcome is not null)
            {
                <section aria-label="Состояние записи" data-testid="net-operation-journal">
                    @if (_operationNotice is not null)
                    {
                        <MudAlert Severity="Severity.Warning">@_operationNotice</MudAlert>
                        <ClayToolbarButton Options="RetryDraftStorageOptions" Disabled="@(!CanInspectOperation)" OnClick="RetryDraftStorageAsync" />
                    }
                    @if (_observedOutcome is not null)
                    {
                        <MudText>@_observedOutcome</MudText>
                    }
                </section>
            }
            @if (_reconciliation is { } reconciliation)
            {
                <section aria-label="Сверка после сохранения" data-testid="net-reconciliation">
                    <ClayToolbarButton Options="ReconcileOptions" Disabled="@(!CanReconcile)" OnClick="ReviewReconciliationAsync" />
                    @if (reconciliation.Review is { } review)
                    {
                        @foreach (var field in review.Conflicts)
                        {
                            <fieldset @key="field" disabled="@_loading">
                                <legend>@field.Label</legend>
                                <div>Отправлено: @field.Sent</div>
                                <div>Мой ввод: @field.Local</div>
                                <div>Из БД: @field.Fresh</div>
                                <ClayRadioGroup TValue="bool?" Items="ReconciliationChoices" @bind-Value="field.KeepLocal" />
                            </fieldset>
                        }
                        <ClayToolbarButton Options="AcceptReconcileOptions"
                            Disabled="@(!CanReconcile || review.Conflicts.Any(field => field.KeepLocal is null))"
                            OnClick="ResolveReconciliationAsync" />
                    }
                </section>
            }
            <MudText Typo="Typo.subtitle1" Class="font-weight-bold" data-testid="net-port-caption">@PortCaption</MudText>
            @if (InputNotice is { } inputNotice)
            {
                <MudAlert Severity="Severity.Warning" data-testid="net-input-notice">
                    @inputNotice
                    @if (_operationContext is { InputConflict: true, LastSavedInput: not null })
                    {
                        <ClayToolbarButton Options="ReviewStaleInputOptions" Disabled="@(!CanReviewStaleInput)" OnClick="ReviewStaleNetInputAsync" />
                    }
                </MudAlert>
            }
            @if (_operationContext?.InputReview is { } draftReview)
            {
                <section aria-label="Сверка данных порта" data-testid="net-input-review">
                    @foreach (var field in draftReview.Conflicts)
                    {
                        <fieldset @key="field" disabled="@(!CanReviewStaleInput)">
                            <legend>@field.Label</legend>
                            <div>Исходное значение: @field.Sent</div>
                            <div>Мой ввод: @field.Local</div>
                            @if (draftReview.RawFields.Contains(field.Field))
                            {
                                <div>Для этого поля сохранён также незавершённый ввод.</div>
                            }
                            <div>Из БД: @field.Fresh</div>
                            <ClayRadioGroup TValue="bool?" Items="ReconciliationChoices" @bind-Value="field.KeepLocal" />
                        </fieldset>
                    }
                    @if (draftReview.Conflicts.Count == 0)
                    {
                        <MudText>Независимые изменения можно объединить.</MudText>
                    }
                    <ClayToolbarButton Options="AcceptStaleInputOptions"
                        Disabled="@(!CanReviewStaleInput || draftReview.Conflicts.Any(field => field.KeepLocal is null))"
                        OnClick="AcceptStaleNetInputAsync" />
                </section>
            }
            <div @key="_inputViewRevision" data-draft-scope="@NetInputScope" inert="@(_cancellingInput || _pendingNetClose is not null || _netDraftClosed)">
            <ClayEditorFocusScope @key="_model.Id" Label="Поля порта локальной сети" Ready="@NetFocusReady" AdvanceOnEnter="true">
            <MudGrid Spacing="2">
                <MudItem xs="12" md="6">
                    <div class="equipment-ins-row">
                        <span class="equipment-ins-label">Розетка:</span>
                        <div>
                            <ClayFieldChange Changed="@(baseline is not null && _model.SocketId != baseline.SocketId)" WatchLookupRaw="@(baseline is not null)">
                            <ClaySelect TItem="NetSocketLookup" TValue="int?"
                                        DataSource="SocketSource"
                                        ValueSelector="@(item => (int?)item.Id)"
                                        TextSelector="@(item => item.Name)"
                                        Value="_model.SocketId"
                                        ValueChanged="OnSocketChangedAsync"
                                        Options="_socketOptions" />
                            </ClayFieldChange>
                            @if (!string.IsNullOrWhiteSpace(_socketNotes))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary" data-testid="net-socket-notes">@_socketNotes</MudText>
                            }
                        </div>
                    </div>
                    <div class="equipment-ins-row equipment-ins-row-top">
                        <span class="equipment-ins-label">Подключено:</span>
                        <div>
                            <ClayFieldChange Changed="@(baseline is not null && _model.Connected != baseline.Connected)" RawBaseline="@baseline?.Connected">
                                <ClayTextArea @bind-Value="_model.Connected" Options="_connectedOptions" />
                            </ClayFieldChange>
                            @if (_connectedLinks.Count > 0)
                            {
                                <div data-testid="net-connected-links">
                                    @foreach (var link in _connectedLinks)
                                    {
                                        <a href="@($"{Configuration["URI_equipment_form"]}?id={link.EquipmentId}")"
                                           @onclick="() => OpenEquipmentAsync(link.EquipmentId)" @onclick:preventDefault>@link.Token</a>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                    <div class="equipment-ins-row equipment-ins-row-top">
                        <span class="equipment-ins-label">Примечание:</span>
                        <div>
                            <ClayFieldChange Changed="@(baseline is not null && _model.Description != baseline.Description)" RawBaseline="@baseline?.Description">
                                <ClayTextArea @bind-Value="_model.Description" Options="_descriptionOptions" />
                            </ClayFieldChange>
                            @if (_descriptionLinks.Count > 0)
                            {
                                <div data-testid="net-description-links">
                                    @foreach (var link in _descriptionLinks)
                                    {
                                        <a href="@($"{Configuration["URI_equipment_form"]}?id={link.EquipmentId}")"
                                           @onclick="() => OpenEquipmentAsync(link.EquipmentId)" @onclick:preventDefault>@link.Token</a>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_linkError))
                    {
                        <MudAlert Severity="Severity.Warning">@_linkError</MudAlert>
                    }
                </MudItem>
                <MudItem xs="12" md="6" Class="equipment-ins-fields">
                    <div class="equipment-ins-row">
                        <span class="equipment-ins-label">Сотрудник:</span>
                        <ClayFieldChange Changed="@(baseline is not null && _model.EmployeeId != baseline.EmployeeId)" WatchLookupRaw="@(baseline is not null)">
                        <ClaySelect TItem="Employee" TValue="int?"
                                    DataSource="EmployeeSource"
                                    ValueSelector="@(item => (int?)item.Id)"
                                    TextSelector="@(item => item.Name)"
                                    Value="_model.EmployeeId"
                                    ValueChanged="OnEmployeeChangedAsync"
                                    Options="_employeeOptions" />
                        </ClayFieldChange>
                    </div>
                    @if (ShowCompanyMismatch)
                    {
                        <MudAlert Severity="Severity.Error">Компания сотрудника: @CompanyMismatchName</MudAlert>
                    }
                    <div class="equipment-ins-row">
                        <span class="equipment-ins-label">Заказчик:</span>
                        <ClayFieldChange Changed="@(baseline is not null && _model.PersonCustomerId != baseline.CustomerId)" WatchLookupRaw="@(baseline is not null)">
                        <ClaySelect TItem="PersonLookup" TValue="int?"
                                    DataSource="CustomerSource"
                                    ValueSelector="@(item => (int?)item.Id)"
                                    TextSelector="@(item => item.Name)"
                                    Value="_model.PersonCustomerId"
                                    ValueChanged="OnCustomerChanged"
                                    Options="_customerOptions" />
                        </ClayFieldChange>
                    </div>
                    @if (ShowSwitch)
                    {
                        <div class="equipment-ins-row" data-testid="net-switch-row">
                            <span class="equipment-ins-label">Переключить на:</span>
                            <ClayFieldChange Changed="@(baseline is not null && _switchToId != baseline.SwitchToId)">
                            <ClayDropDownList TItem="LocalNetworkNeighborPort" TValue="int?"
                                              Items="_switchPorts"
                                              ValueSelector="@(item => (int?)item.Id)"
                                              TextSelector="@(item => item.Name)"
                                              Value="_switchToId"
                                              ValueChanged="OnSwitchChanged" Options="_switchOptions" />
                            </ClayFieldChange>
                        </div>
                    }
                    @if (ShowExchange)
                    {
                        <div class="equipment-ins-row" data-testid="net-exchange-row">
                            <span class="equipment-ins-label">Обменять с:</span>
                            <ClayFieldChange Changed="@(baseline is not null && _exchangeWithId != baseline.ExchangeWithId)">
                            <ClayDropDownList TItem="LocalNetworkNeighborPort" TValue="int?"
                                              Items="_exchangePorts"
                                              ValueSelector="@(item => (int?)item.Id)"
                                              TextSelector="@(item => item.Name)"
                                              Value="_exchangeWithId"
                                              ValueChanged="OnExchangeChanged" Options="_exchangeOptions" />
                            </ClayFieldChange>
                        </div>
                    }
                    <ClayFieldChange Changed="@(baseline is not null && (baseline.HasReturnDate != _hasReturnDate ||
                        _hasReturnDate && _model.ReturnDate?.Date != baseline.ReturnDate?.Date))"
                        RawBaseline="@(baseline is null || !_hasReturnDate ? null : baseline.HasReturnDate
                             ? baseline.ReturnDate?.ToString(_dateOptions.DateFormat) ?? string.Empty : string.Empty)">
                    <div class="equipment-ins-row">
                        <ClayCheckbox State="_hasReturnDate" StateChanged="OnReturnDateEnabledChanged" Label="Срок возврата" />
                        @if (_hasReturnDate)
                        {
                            <ClayDatePicker @bind-Value="_model.ReturnDate" Options="_dateOptions" />
                        }
                    </div>
                    </ClayFieldChange>
                    @if (ShowExpiredWarning)
                    {
                        <MudAlert Severity="Severity.Error">просрочено</MudAlert>
                    }
                </MudItem>
            </MudGrid>
            </ClayEditorFocusScope>
            </div>
        }
    </ChildContent>
    <Footer>
        <ClayChanged ChangedById="_model?.ChangedById"
                     ChangedByName="@_model?.ChangedByName"
                     ChangedAt="_model?.ChangedAtUtc"
                     ChangedByUrl="@ChangedByUrl" />
    </Footer>
</ClayEntityForm>

<MudOverlay Visible="@(_loading || _saving || _poeRunning)" DarkBackground="true">
    <div class="clay-busy">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        <span>@(_poeRunning ? "Перезапуск PoE…" : _saving ? "Сохранение локальной сети…" : "Загрузка локальной сети…")</span>
    </div>
</MudOverlay>
</div>
