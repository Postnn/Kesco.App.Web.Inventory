@using Clayzor.Lib.Web.Controls.Components.Presence
@page "/Inv/LocationFact"
@page "/Inv/LocationFact.aspx"
@using Clayzor.Lib.Entities.Inventory
@using Kesco.App.Web.Inventory.Components
@using Kesco.App.Web.Inventory.Components.Layout

<PageTitle>Инвентаризация рабочего места</PageTitle>
<InventoryMainMenu />
<NavigationLock ConfirmExternalNavigation="@ProtectExternalExit" OnBeforeInternalNavigation="BeforeInternalNavigationAsync" />
<div class="@($"location-fact {DraftRootClass}")">
    <MudText Typo="Typo.h5" Class="clay-page-title mb-2">Инвентаризация рабочего места</MudText>
    <div class="d-flex flex-column gap-2" data-draft-scope="@WorkplaceScope" inert="@(_busy || !_ready || _pageDraftClosed)">
        <div class="d-flex align-center flex-wrap gap-2">
            <ClaySelect @ref="_locationSelect" TItem="LocationLookup" TValue="int?" DataSource="Locations" Options="LocationOptions"
                        ValueSelector="@(item => item.Id)" TextSelector="@(item => item.Name)" Value="_siteChoice" ValueChanged="ChangeSiteChoiceAsync" Cleared="@(() => ChangeSiteAsync(null))" />
            <ClayCheckbox Label="IT-оборудование" State="_itOnly" StateChanged="ChangeItAsync" />
        </div>
        <ClaySelect TItem="Employee" TValue="int?" DataSource="Employees" Options="EmployeeOptions" ValueSelector="@(item => item.Id)"
                    TextSelector="@(item => item.Name)" Value="_responsibleId" ValueChanged="ChangeResponsibleAsync" />
        <ClaySelect @key="_equipmentVersion" @ref="_equipmentSelect" TItem="LocationFactMatch" TValue="int?" DataSource="_equipmentSource"
                    Options="_equipmentOptions" ValueSelector="@(item => item.Id)" TextSelector="@(item => item.MatchText)"
                    Value="_equipmentId" ValueChanged="ChooseEquipmentAsync">
            <ItemTemplate Context="item">
                <span>@item.Id · @item.Name</span>
                <small>SN: @item.SerialNumber · Владелец: @item.OwnerName · Инв.: @item.InventoryNumber</small>
            </ItemTemplate>
        </ClaySelect>
        <div class="d-flex align-center flex-wrap gap-2">
            <ClayCheckbox Label="Режим ввода - сканер" State="_scanner" StateChanged="ChangeScannerAsync" />
            <ClayButton Icon="@Icons.Material.Filled.Refresh" Text="Обновить список оборудования" Disabled="@(_site is null)" OnClick="RefreshAsync" />
        </div>
    </div>
    @if (_busy || !_ready && _message is null) { <MudProgressLinear Class="my-2" Indeterminate="true" /> }
    @if (_message is not null) { <MudAlert Severity="Severity.Warning" Class="my-2">@_message</MudAlert> }
    @if (_workplaceRawIncomplete)
    {
        <MudAlert Severity="Severity.Warning" Class="my-2">
            Часть ввода рабочего места ожидает восстановления.
        </MudAlert>
    }
    @if (_unboundEditorRaw)
    {
        <MudAlert Severity="Severity.Warning" Class="my-2">
            Не удалось связать ввод с подтверждением оборудования. Запись приостановлена.
        </MudAlert>
    }
    @if (_confirmedCleanup is { } receipt)
    {
        @if (receipt.CheckedAt is { } checkedAt)
        {
            <ClayLocalTime Value="@checkedAt" />
        }
    }
    @if (_blocked && !_dialogVisible && _pending is not null && _confirmedCleanup is null && !_storageRetryRequired)
    {
        <MudButton OnClick="ShowDialog" Disabled="@_busy">Вернуться к сверке</MudButton>
    }
    <ClayGrid TEntity="LocationFactRow" Options="GridOptions" Items="_rows" RowClass="@GetRowClass">
        <ColumnDefs>
            <ClayColumnDef ColumnId="1" SqlName="Id" DisplayName="Код" />
            <ClayColumnDef ColumnId="2" SqlName="Name" DisplayName="Оборудование" />
            <ClayColumnDef ColumnId="3" SqlName="CheckedAt" DisplayName="Последняя проверка" />
            <ClayColumnDef ColumnId="4" SqlName="LocationName" DisplayName="Расположение при последней проверке" />
            <ClayColumnDef ColumnId="5" SqlName="Notes" DisplayName="Примечание" />
        </ColumnDefs>
        <Columns>
            <ClayColumn TEntity="LocationFactRow" ColumnId="1">
                <CellTemplate><a href="@EquipmentUrl(context.Item.Id)" @onclick:preventDefault @onclick="@(() => OpenAsync(EquipmentUrl(context.Item.Id)))">@context.Item.Id</a></CellTemplate>
            </ClayColumn>
            <ClayColumn TEntity="LocationFactRow" ColumnId="2">
                <CellTemplate>
                    @if (CanConfirm) { <MudButton Variant="Variant.Text" OnClick="@(() => StartConfirmationAsync(context.Item.Id, false))" Disabled="@(_busy || _pending is not null)">@context.Item.Name</MudButton> }
                    else { @context.Item.Name }
                </CellTemplate>
            </ClayColumn>
            <ClayColumn TEntity="LocationFactRow" ColumnId="3">
                <CellTemplate><ClayLocalTime Value="@context.Item.CheckedAt" /></CellTemplate>
            </ClayColumn>
            <ClayColumn TEntity="LocationFactRow" ColumnId="4">
                <CellTemplate>
                    @if (GetLocationUrl(context.Item.LocationId) is { } url)
                    { <a href="@url" @onclick:preventDefault @onclick="@(() => OpenAsync(url))">@context.Item.LocationName</a> }
                    else { @context.Item.LocationName }
                </CellTemplate>
            </ClayColumn>
            <ClayColumn TEntity="LocationFactRow" ColumnId="5">
                <CellTemplate>@context.Item.DisplayNotes</CellTemplate>
            </ClayColumn>
        </Columns>
    </ClayGrid>
</div>

    <MudDialog Visible="@_dialogVisible" VisibleChanged="OnDialogVisibilityAsync" Class="@($"location-fact-dialog {DraftRootClass}")" Options="DialogOptions"
               DefaultFocus="@(_askRelocation ? DefaultFocus.Element : DefaultFocus.None)">
        <TitleContent>Подтверждение нахождения оборудования на расположении</TitleContent>
        <DialogContent>
            <ClayFormActions Form="InventoryFormHelp.LocationFact" />
            @if (GetPresenceTarget() is { } presenceTarget)
            {
                <ClayPresencePanel Target="presenceTarget" />
            }
            @if ((_blocked && !_storageRetryRequired && _confirmedCleanup is null) || _conflict ||
                (_pending is not null && (!_serverWriteChecked || _serverWritePending)))
            {
                <MudButton Disabled="@_busy" OnClick="CompareAsync">Сверить с базой</MudButton>
                @if (_comparison is { } fresh)
                {
                    <div>Учётное расположение: @fresh.Equipment.BookedLocationName</div>
                    <div>Последняя проверка: <ClayLocalTime Value="fresh.LastCheckedAt" /></div>
                    <div>Сломано: @(fresh.Broken ? "Да" : "Нет"). Примечание: @fresh.Notes</div>
                    @if (_conflict && !_blocked)
                    {
                        <MudButton Disabled="@_busy" OnClick="AcceptComparisonAsync">Обновить данные для подтверждения</MudButton>
                    }
                    else { <MudText>Сверка показывает последнюю запись. Принадлежность операции требует подтверждения.</MudText> }
                }
            }
            @if (_restoreIncomplete)
            {
                <MudAlert Severity="Severity.Warning">Ввод восстановлен частично. Сохранение приостановлено.</MudAlert>
            }
            @if (_dialogError is not null) { <MudAlert Severity="Severity.Warning" Class="mb-2">@_dialogError</MudAlert> }
            @if (_serverWritePending)
            {
                <MudAlert Severity="Severity.Warning">По оборудованию есть незавершённая операция. Повтор записи заблокирован.</MudAlert>
            }
            else if (_serverLastConfirmed is { } lastConfirmed)
            {
                <MudAlert Severity="Severity.Info">Сервер подтвердил предыдущую проверку <ClayLocalTime Value="@lastConfirmed" /></MudAlert>
            }
            @if (_pending is { } pending)
            {
            var editorVersion = _dialogVersion;
            <div class="d-flex flex-column gap-2" data-draft-scope="main" data-location-fact-dialog="@_dialogVersion" inert="@_busy">
                <div>Код оборудования @pending.Equipment.EquipmentId</div>
                <div>Оборудование <a href="@EquipmentUrl(pending.Equipment.EquipmentId)" @onclick:preventDefault @onclick="@(() => OpenAsync(EquipmentUrl(pending.Equipment.EquipmentId)))">@pending.Equipment.FactName</a></div>
                <div>
                    Владелец
                    @if (GetOwnerUrl(pending.Equipment.OwnerId) is { } ownerUrl)
                    { <a href="@ownerUrl" @onclick:preventDefault @onclick="@(() => OpenAsync(ownerUrl))">@pending.Equipment.OwnerName</a> }
                    else { @pending.Equipment.OwnerName }
                </div>
                @if (pending.Equipment.InventoryNumber.Length != 0) { <div>Инвентарный номер @pending.Equipment.InventoryNumber</div> }
                @if (!_askRelocation)
                {
                    <ClayFieldChange Changed="@(CanEditPending && _broken != (!_scanOperation && pending.Broken))">
                        <ClayCheckbox Label="Сломано, ремонту не подлежит" State="_broken" Disabled="@(!CanEditPending)"
                                      StateChanged="@(value => ChangeBrokenAsync(editorVersion, value))" />
                    </ClayFieldChange>
                    <ClayFieldChange Changed="@(CanEditPending && _notes != (_scanOperation ? string.Empty : pending.Notes))">
                        <ClayTextArea Options="@(CanEditPending ? NotesOptions : ReadOnlyNotesOptions)" Value="@_notes"
                                      ValueChanged="@(value => ChangeNotesAsync(editorVersion, value))" />
                    </ClayFieldChange>
                    <div>
                        Подтвердите, что оборудование находится на расположении
                        @if (GetLocationUrl(pending.Site.Id) is { } siteUrl)
                        { <a href="@siteUrl" @onclick:preventDefault @onclick="@(() => OpenAsync(siteUrl))">@pending.Site.Name</a> }
                        else { @pending.Site.Name }
                    </div>
                }
                else
                {
                    @if (pending.Equipment.BookedLocationId is not null)
                    { <MudText>Расположение оборудования [@pending.Equipment.FactName] не менялось с момента проведения последней инвентаризации: [@pending.Equipment.BookedLocationName].</MudText> }
                    <MudText>Выполнить перемещение оборудования [@pending.Equipment.FactName] на текущее место инвентаризации?</MudText>
                }
            </div>
            }
        </DialogContent>
        <DialogActions>
            @if (_askRelocation)
            {
                <MudButton Color="Color.Primary" Disabled="@(!CanSubmitPending)" OnClick="@(() => ConfirmAsync(true))">Да</MudButton>
                <MudButton Disabled="@(!CanSubmitPending)" OnClick="@(() => ConfirmAsync(false))">Нет</MudButton>
            }
            else
            {
                <MudButton Color="Color.Primary" Disabled="@(!CanSubmitPending)" OnClick="ReviewAsync">Подтвердить</MudButton>
            }
            <MudButton Disabled="@_busy" OnClick="CancelAsync">Отмена</MudButton>
        </DialogActions>
    </MudDialog>
