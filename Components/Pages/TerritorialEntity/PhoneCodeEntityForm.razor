@using Clayzor.Lib.Web.Controls.Components.Presence
@page "/TerritorialEntity/PhoneCodeEntity_form"
@page "/TerritorialEntity/PhoneCodeEntity_form.aspx"
@layout Kesco.App.Web.Inventory.Components.Layout.EntityFormLayout
@using Clayzor.Lib.Entities.TerritorialEntity
@inherits TerritorialEntityCardBase<PhoneCodeEntityForm.FormState>

<PageTitle>Телефонный код</PageTitle>
<NavigationLock ConfirmExternalNavigation="@(Dirty || Busy || ConfirmedCleanupPending)" OnBeforeInternalNavigation="BeforeNavigationAsync" />

<ClayEntityForm Options="FormOptions">
    <Toolbar>
        <ClayToolbar>
            <ClayToolbarButton Options="OkButton" Disabled="@(Busy || Loading || Draft is null || (Dirty && !CanCommitPhone))" OnClick="@(() => SaveAsync(true))" />
            <ClayToolbarButton Options="ApplyButton" Disabled="@(!Editable || !CanCommitPhone || !Dirty)" OnClick="@(() => SaveAsync(false))" />
            <ClayToolbarButton Options="ReloadButton" Disabled="@(!CanRefresh)" OnClick="RefreshPhoneAsync" />
            <ClayToolbarButton Options="CancelButton" Disabled="@Busy" OnClick="CancelAsync" />
            @if (CanDelete)
            {
                <ClayToolbarButton Options="DeleteButton" Disabled="@(!CanCommitPhone)" OnClick="DeleteAsync" />
            }
        </ClayToolbar>
    </Toolbar>
    <ChildContent>
        @if (Loading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        @if (Message is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-2">@Message</MudAlert>
        }
        @if (_serverWritePending)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-2">Есть незавершённая операция. Повтор записи заблокирован.</MudAlert>
        }
        else if (!Loading && (Editable || CanDelete) && !_serverJournalReady)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-2">Не удалось проверить серверный журнал. Сохранение недоступно.</MudAlert>
        }
        else if (_lastServerCode is { } previousCode)
        {
            <MudAlert Severity="Severity.Info" Class="mb-2">
                Сервер подтвердил операцию с телефонным кодом @previousCode.
                @if (QueryId is null)
                {
                    <a href="@PhoneCodeEditLink(previousCode)">Открыть сохранённый код</a>
                }
            </MudAlert>
        }
        @if (Validation.Count > 0)
        {
            <MudAlert Severity="Severity.Error" Class="mb-2">
                Запись не сохранена.
                <ul>@foreach (var error in Validation) { <li>@error</li> }</ul>
            </MudAlert>
        }
        @if (Draft is { } draft)
        {
            var baseline = AcceptedDraftBaseline;
            <ClayEditorFocusScope @key="RouteKey" Label="Поля телефонного кода" Ready="@(Editable && CanCommitPhone)" AdvanceOnEnter="true">
                <div class="d-flex flex-column gap-2" data-draft-scope="main" inert="@DraftInputSuppressed">
                    <ClayFieldChange Changed="@(Editable && !_territoryOptions.ReadOnly && !_territoryOptions.Disabled && baseline is not null && draft.TerritoryId != baseline.TerritoryId)"
                                     WatchLookupRaw="@(Editable && baseline is not null)">
                        <ClaySelect TItem="TerritorialEntityLookup" TValue="int?" DataSource="_territorySource"
                                    ValueSelector="@(item => (int?)item.Id)" TextSelector="@(item => item.DisplayName)"
                                    Value="@draft.TerritoryId" ValueChanged="ChangeTerritoryAsync" Options="_territoryOptions"
                                    ViewItem="OpenTerritoryAsync" AdvancedSearch="FindTerritoryAsync" />
                    </ClayFieldChange>
                    @if (!Editable && draft.TerritoryId is > 0)
                    {
                        <MudButton OnClick="@(() => ViewSavedTerritoryAsync(draft.TerritoryId.Value))">Открыть территорию</MudButton>
                    }
                    @if (_territoryConflict)
                    {
                        <MudAlert Severity="Severity.Warning">Сохранённая территория больше не входит в список допустимых. Выберите действующую территорию перед сохранением.</MudAlert>
                    }
                    <ClayFieldChange Changed="@(Editable && !_codeOptions.ReadOnly && !_codeOptions.Disabled && baseline is not null && draft.Code != baseline.Code)"
                                     RawBaseline="@(Editable ? baseline?.Code : null)">
                        <ClayTextBox Options="_codeOptions" Value="@draft.Code" ValueChanged="@(value => UpdateDraftAsync(Draft! with { Code = value ?? "" }))" />
                    </ClayFieldChange>
                    <ClayFieldChange Changed="@(Editable && !_lengthOptions.ReadOnly && !_lengthOptions.Disabled && baseline is not null && AreaLengthChanged(baseline.Length, draft.Length))">
                        <ClayTextBox Options="_lengthOptions" Value="@draft.Length" ValueChanged="@(value => UpdateDraftAsync(Draft! with { Length = value }))" />
                    </ClayFieldChange>
                    <ClayFieldChange Changed="@(Editable && !_typeOptions.ReadOnly && !_typeOptions.Disabled && baseline is not null && draft.TypeId != baseline.TypeId)">
                        <ClayDropDownList TItem="TerritorialEntityOption" TValue="int?" Options="_typeOptions" Items="_types"
                                          ValueSelector="@(item => (int?)item.Id)" TextSelector="@(item => item.Name)"
                                          Value="@draft.TypeId" ValueChanged="@(value => UpdateDraftAsync(Draft! with { TypeId = value }))" />
                    </ClayFieldChange>
                    <ClayFieldChange Changed="@(Editable && !_commentOptions.ReadOnly && !_commentOptions.Disabled && baseline is not null && draft.Comment != baseline.Comment)"
                                     RawBaseline="@(Editable && baseline is not null ? baseline.Comment ?? string.Empty : null)">
                        <ClayTextBox Options="_commentOptions" Value="@draft.Comment" ValueChanged="@(value => UpdateDraftAsync(Draft! with { Comment = value ?? "" }))" />
                    </ClayFieldChange>
                </div>
            </ClayEditorFocusScope>
        }
    </ChildContent>
    <Footer>
        @if (PhoneCodePresence() is { } presenceTarget)
        {
            <ClayPresencePanel Target="presenceTarget" />
        }
        @if (_original is { } original)
        {
            <ClayChanged ChangedById="@original.ChangedBy" ChangedByName="@original.ChangedByName" ChangedAt="@original.ChangedAt" />
        }
    </Footer>
</ClayEntityForm>
