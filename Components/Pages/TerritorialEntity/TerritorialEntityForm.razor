@page "/TerritorialEntity/TerritorialEntity_form"
@page "/TerritorialEntity/TerritorialEntity_form.aspx"
@layout Kesco.App.Web.Inventory.Components.Layout.EntityFormLayout
@using Clayzor.Lib.Entities.TerritorialEntity
@inherits TerritorialEntityCardBase<TerritorialEntityForm.FormState>

<PageTitle>Территория</PageTitle>
<NavigationLock ConfirmExternalNavigation="@(Dirty || Busy)" OnBeforeInternalNavigation="BeforeNavigationAsync" />

<ClayEntityForm Options="FormOptions">
    <Toolbar>
        <ClayToolbar>
            <ClayToolbarButton Options="OkButton" Disabled="@(Busy || Loading || Draft is null || (Dirty && !CanCommit))" OnClick="@(() => SaveAsync(true))" />
            <ClayToolbarButton Options="ApplyButton" Disabled="@(!Editable || !CanCommit || !Dirty)" OnClick="@(() => SaveAsync(false))" />
            <ClayToolbarButton Options="ReloadButton" Disabled="@(Busy || Loading || StorageBlocked)" OnClick="RefreshAsync" />
            <ClayToolbarButton Options="CancelButton" Disabled="@Busy" OnClick="CancelAsync" />
        </ClayToolbar>
    </Toolbar>
    <ChildContent>
        @if (Loading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        @if (Message is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-2">@Message</MudAlert>
        }
        @if (Validation.Count > 0)
        {
            <MudAlert Severity="Severity.Error" Class="mb-2">
                Запись не сохранена.
                <ul>@foreach (var error in Validation) { <li>@error</li> }</ul>
            </MudAlert>
        }
        @if (Draft is { } draft)
        {
            <div class="d-flex flex-column gap-2 territorial-form-fields" data-draft-scope="main" inert="@Busy">
                <ClayDropDownList TItem="TerritorialEntityOption" TValue="int?" Options="_typeOptions"
                                  Items="_types" ValueSelector="@(item => (int?)item.Id)" TextSelector="@(item => item.Name)"
                                  Value="@((int)draft.Record.Type > 0 ? (int?)draft.Record.Type : null)" ValueChanged="ChangeTypeAsync" />
                <ClayTextBox Options="_classificationOptions" Value="@draft.Classification" ValueChanged="ChangeClassificationAsync" />
                <ClayTextBox Options="_nameOptions" Value="@draft.Record.Name" ValueChanged="@(value => ChangeAsync(Draft!.Record with { Name = value ?? "" }))" />
                <ClayTextBox Options="_alternateNameOptions" Value="@draft.Record.AlternateName" ValueChanged="@(value => ChangeAsync(Draft!.Record with { AlternateName = value ?? "" }))" />
                <ClayTextBox Options="_captionOptions" Value="@draft.Record.Caption" ValueChanged="@(value => ChangeAsync(Draft!.Record with { Caption = value ?? "" }))" />
                <ClayTextBox Options="_alternateCaptionOptions" Value="@draft.Record.AlternateCaption" ValueChanged="@(value => ChangeAsync(Draft!.Record with { AlternateCaption = value ?? "" }))" />
                <ClayTextBox Options="_abbreviationOptions" Value="@draft.Record.Abbreviation" ValueChanged="@(value => ChangeAsync(Draft!.Record with { Abbreviation = value ?? "" }))" />
                <ClayTextBox Options="_countryOptions" Value="@draft.Record.CountryCode" ValueChanged="@(value => ChangeAsync(Draft!.Record with { CountryCode = value ?? "" }))" />
                <ClayTextBox Options="_directionOptions" Value="@draft.Record.Direction" ValueChanged="@(value => ChangeAsync(Draft!.Record with { Direction = value ?? "" }))" />
            </div>
            @if (draft.Record.Id > 0)
            {
                <div class="d-flex align-center flex-wrap gap-2 mt-3">
                    <MudText Typo="Typo.subtitle2">Телефонные коды</MudText>
                    @if (Access.PhoneInsert)
                    {
                        <MudButton OnClick="OpenPhoneAsync" StartIcon="@Icons.Material.Filled.Add">Добавить телефонный код</MudButton>
                    }
                </div>
                <iframe @key="_phoneListVersion" title="Телефонные коды территории" class="border-0"
                        style="width:100%;min-height:300px" src="@PhoneListUrl"></iframe>
            }
        }
    </ChildContent>
    <Footer>
        @if (Clean is { Record.Id: > 0 } saved)
        {
            <ClayChanged ChangedById="@saved.Record.ChangedBy" ChangedByName="@saved.Record.ChangedByName" ChangedAt="@saved.Record.ChangedAt" />
        }
    </Footer>
</ClayEntityForm>
