@page "/TerritorialEntity/TerritorialEntity_search"
@page "/TerritorialEntity/TerritorialEntity_search.aspx"
@using Clayzor.Lib.Entities.TerritorialEntity
@using Kesco.App.Web.Inventory.Components.Layout

<PageTitle>Территории и телефонные коды</PageTitle>

<div class="territorial-search-page">
@if (ReturnMode is null)
{
    <InventoryMainMenu />
}
<MudText Typo="Typo.h5" Class="mb-2">Территории и телефонные коды</MudText>
@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
@if (_message is not null)
{
    <MudAlert Severity="Severity.Warning" Class="mb-2">@_message</MudAlert>
}
@if (_treeRefreshError is not null)
{
    <MudAlert Severity="Severity.Warning" Class="mb-2">@_treeRefreshError</MudAlert>
}
@if (_knownMoveCleanup is { } cleanup)
{
    <MudAlert Severity="Severity.Warning">
        @(cleanup.Rejection is null ? "Перенос подтверждён. Требуется завершить очистку в браузере." : "Перенос отклонён. Требуется завершить очистку в браузере.")
        <MudButton Disabled="@_moving" OnClick="RetryMoveCleanupAsync">Повторить очистку</MudButton>
    </MudAlert>
}
else if (_pendingMove is not null)
{
    <MudAlert Severity="Severity.Warning">Результат переноса не подтверждён. <MudButton Disabled="@_moving" OnClick="CompareMoveAsync">Сверить родителя</MudButton>
        @if (_moveComparison is not null) { <div>@_moveComparison</div> }
    </MudAlert>
}
@if (_treeOptions is not null && _source is not null)
{
    <MudGrid Spacing="2" Class="territorial-search-grid">
        <MudItem xs="12" md="4" Class="territorial-search-tree-column">
            <MudPaper Class="pa-2 territorial-search-tree-panel" Elevation="0">
                <div class="d-flex align-center justify-space-between">
                    <MudButton Variant="Variant.Text" OnClick="ResetViewAsync" FullWidth="false">Территории</MudButton>
                    <ClayButton Icon="@Icons.Material.Filled.Refresh" Text="Обновить дерево" OnClick="ReloadTreeAsync" />
                </div>
                @if (_total is int count)
                {
                    <MudText Typo="Typo.body2">@(count == 0 ? "Не найдено" : $"Найдено: {count}. Показано до 100 совпадений.")</MudText>
                }
                <ClayTreeView CustomStateStore="this" @ref="_tree" Options="_treeOptions" DataSource="_source" OnNodeClick="SelectNodeAsync" />
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="8">
            @if (_active is { } node)
            {
                @if (IsCity(node))
                {
                    <MudText Typo="Typo.subtitle2">Телефонные коды в @node.Text</MudText>
                }
                else
                {
                    <MudMenu Label="@(_phoneCodes ? $"Телефонные коды в {node.Text}" : $"Территории в {node.Text}")">
                        <MudMenuItem OnClick="@(() => ShowPhoneCodes(false))">Территории в @node.Text</MudMenuItem>
                        <MudMenuItem OnClick="@(() => ShowPhoneCodes(true))">Телефонные коды в @node.Text</MudMenuItem>
                    </MudMenu>
                }
                @if (_paneRefreshError is not null)
                {
                    <MudAlert Severity="Severity.Warning" Class="mb-2">@_paneRefreshError</MudAlert>
                }
                <iframe @key="_gridUrl" @ref="_gridFrame" title="@(_phoneCodes ? $"Телефонные коды в {node.Text}" : $"Территории в {node.Text}")" class="border-0"
                        style="width:100%;min-height:460px" src="@_gridUrl"></iframe>
            }
        </MudItem>
    </MudGrid>
}
@if (ReturnMode == "2" && _treeOptions is not null)
{
    <MudButton Disabled="@_returning" OnClick="ReturnMultipleAsync">Сохранить</MudButton>
}
@if (ReturnMode is "1" or "2")
{
    <MudButton OnClick="CloseAsync">Отмена</MudButton>
}
</div>
