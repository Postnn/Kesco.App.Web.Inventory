@inherits LayoutComponentBase
@using Clayzor.Lib.Web.Controls.Themes

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_isDarkMode" ObserveSystemDarkModeChange="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<CascadingValue Value="this">
    <MudLayout>
        <MudMainContent Class="pa-6 inventory-layout-content">
            <ClayErrorBar />
            <ClayDbReconnectOverlay />
            @Body
        </MudMainContent>
    </MudLayout>
</CascadingValue>

@code {
    private readonly MudTheme _theme = ClayTheme.Create();
    private bool _isDarkMode;

    internal bool IsDarkMode => _isDarkMode;

    internal void ToggleDarkMode() => _isDarkMode = !_isDarkMode;
}
