@inherits LayoutComponentBase
@using Clayzor.Lib.Web.Controls.Themes
@inject NavigationManager Navigation

<ClayThemeHost />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudMainContent Class="pa-6 inventory-layout-content">
        <div class="inventory-layout-actions">
            <ClayFormActions Form="@InventoryFormHelp.Find(Navigation.ToBaseRelativePath(Navigation.Uri))" />
        </div>
        <ClayErrorBar />
        <ClayDbReconnectOverlay />
        @Body
    </MudMainContent>
</MudLayout>
