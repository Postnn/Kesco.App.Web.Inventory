@inherits LayoutComponentBase
@using Clayzor.Lib.Web.Controls.Themes
@inject ClayThemeState ThemeState

<ClayThemeHost />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<CascadingValue Value="ThemeState" IsFixed="true">
    <MudLayout>
        <MudMainContent Class="pa-6 inventory-layout-content">
            <ClayErrorBar />
            <ClayDbReconnectOverlay />
            @Body
        </MudMainContent>
    </MudLayout>
</CascadingValue>
