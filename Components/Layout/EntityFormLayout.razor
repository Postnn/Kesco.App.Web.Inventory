@inherits LayoutComponentBase
@using Clayzor.Lib.Web.Controls.Themes
@inject NavigationManager Navigation
<ClayThemeHost />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudMainContent Class="pa-2 entity-form-main">
        <div class="entity-form-theme inventory-theme-toggle">
            @if (InventoryFormHelp.Find(Navigation.ToBaseRelativePath(Navigation.Uri)) is { } help)
            {
                <ClayFormHelpButton Form="help" />
            }
            <ClayThemeSelector />
        </div>
        <ClayErrorBar />
        <ClayDbReconnectOverlay />
        @Body
    </MudMainContent>
</MudLayout>
