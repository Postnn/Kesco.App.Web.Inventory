@inherits LayoutComponentBase
@using Clayzor.Lib.Web.Controls.Themes
@inject NavigationManager Navigation
<ClayThemeHost />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudMainContent Class="pa-2 entity-form-main">
        <ClayErrorBar />
        <ClayDbReconnectOverlay />
        <CascadingValue Name="EntityFormActions" Value="@EntityFormActions">
            @Body
        </CascadingValue>
    </MudMainContent>
</MudLayout>

@code {
    private RenderFragment EntityFormActions => builder =>
    {
        builder.OpenComponent<ClayFormActions>(0);
        builder.AddAttribute(1, nameof(ClayFormActions.Form), InventoryFormHelp.Find(Navigation.ToBaseRelativePath(Navigation.Uri)));
        builder.CloseComponent();
    };
}
