<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\Kesco.App.Web.Inventory.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="InProcess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <authentication>
          <windowsAuthentication enabled="true" />
          <anonymousAuthentication enabled="false" />
        </authentication>
      </security>
    </system.webServer>
  </location>
  <appSettings>
    <add key="AppName" value="Инвентаризация" />
    <add key="ClayGrid:DefaultPageSize" value="50" />
    <add key="Sql:CommandTimeout" value="30" />
    <add key="URI_help_clayGrid" value="https://postnn.github.io/clayzor-docs/components/claygrid/" />
    <add key="URI_user_form" value="http://localhost:5030/user" />
    <add key="URI_model_form" value="http://localhost:5020/Equipment/ModelEquipmentForm" />
    <add key="URI_tel_form" value="http://localhost:5020/Telefon/Tel" />
    <add key="URI_equipment_form_ins" value="http://localhost:5020/Equipment/EquipmentIns" />
    <add key="URI_equipment_form" value="http://localhost:5020/Equipment/EquipmentForm" />
    <add key="URI_styles" value="http://dione.testcom.com/styles" />
    <add key="URI_user_search" value="http://localhost:5030/search" />
    <add key="technicalTariffs" value="SP_MOBINT,M2M" />
    <add key="pickupGroups" value="Msk_Kutuzov,Ufa-UGNTU,Ekaterinburg,Elevator,Fantana,Kazan,Krasnodar,Msk_Lukov,Msk_Creek,Novorossiysk,Perm,Spb_Ibis,Spb_Kasimoskaya,Spb_Klinsky,Tallinn,Ufa-Akbuzat,Vienna,Msk_Kutuzov_IT,Msk_Kutuzov_Exp,Slantsy" />
  </appSettings>
  <connectionStrings>
    <add name="DS_user"
         connectionString="Server=localhost;Database=Инвентаризация;Integrated Security=true;TrustServerCertificate=true;"
         providerName="Microsoft.Data.SqlClient" />
    <add name="DS_resource"
         connectionString="Server=localhost;Database=Справочники;Integrated Security=true;TrustServerCertificate=true;"
         providerName="Microsoft.Data.SqlClient" />
    <add name="DS_person"
         connectionString="Server=localhost;Database=Справочники;Integrated Security=true;TrustServerCertificate=true;"
         providerName="Microsoft.Data.SqlClient" />
    <add name="DS_doc"
         connectionString="Server=localhost;Database=Документы;Integrated Security=true;TrustServerCertificate=true;"
         providerName="Microsoft.Data.SqlClient" />
    
  </connectionStrings>
</configuration>
